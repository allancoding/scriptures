            "end": 268,
            "text": "1 Sam. 7:3; Hel. 13:11; 3 Ne. 10:6 (5–7); 24:7."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [
