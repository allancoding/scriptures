                        "end": 9
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Moroni 9:17",
        "book": "Moroni",
        "chapter": 9,
        "verse": 17
      },
      {
        "text": "O the depravity of my people! They are without order and without mercy. Behold, I am but a man, and I have but the strength of a man, and I cannot any longer enforce my commands.",
        "footNotes": [
          {
            "start": 47,
            "end": 52,
            "text": "TG Order."
          },
          {
            "start": 115,
            "end": 123,
            "text": "TG Strength."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "TG Order.",
            "prettyString": "TG Order",
            "references": [
