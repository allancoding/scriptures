        "reference": "Mosiah 8:13",
        "book": "Mosiah",
        "chapter": 8,
        "verse": 13
      },
      {
        "text": "And behold, the king of the people who are in the land of Zarahemla is the man that is commanded to do these things, and who has this high gift from God.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 8:14",
        "book": "Mosiah",
        "chapter": 8,
        "verse": 14
      },
      {
