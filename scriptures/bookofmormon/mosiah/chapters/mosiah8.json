        "verse": 6
      },
      {
        "text": "And the king said unto him: Being grieved for the afflictions of my people, I caused that forty and three of my people should take a journey into the wilderness, that thereby they might find the land of Zarahemla, that we might appeal unto our brethren to deliver us out of bondage.",
        "footNotes": [
          {
            "start": 90,
            "end": 95,
            "text": "Mosiah 21:25."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Mosiah 21:25.",
            "prettyString": "Mosiah 21:25",
            "references": [
              {
                "type": "scripture",
                "book": "mosiah",
                "chapters": [
                  {
                    "start": 21,
                    "end": 21,
                    "verses": [
