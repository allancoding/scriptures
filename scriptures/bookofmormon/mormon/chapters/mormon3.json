      {
        "text": "And it came to pass that I, Mormon, did utterly refuse from this time forth to be a commander and a leader of this people, because of their wickedness and abomination.",
        "footNotes": [
          {
            "start": 48,
            "end": 54,
            "text": "Morm. 5:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
