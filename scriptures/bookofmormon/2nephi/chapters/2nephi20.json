        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Nephi 20:10",
        "book": "2 Nephi",
        "chapter": 20,
        "verse": 10
      },
      {
        "text": "Shall I not, as I have done unto Samaria and her idols, so do to Jerusalem and to her idols?",
        "footNotes": [
          {
            "start": 49,
            "end": 54,
            "text": "Ezek. 36:18 (16–20)."
