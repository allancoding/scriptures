        "footNotes": [
          {
            "start": 11,
            "end": 15,
            "text": "Judg. 6:39 (36–40). TG Signs."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Nephi 17:11",
        "book": "2 Nephi",
        "chapter": 17,
        "verse": 11
      },
      {
        "text": "But Ahaz said: I will not ask, neither will I tempt the Lord.",
        "footNotes": [
          {
            "start": 46,
            "end": 51,
            "text": "IE test, try, or prove."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Nephi 17:12",
        "book": "2 Nephi",
        "chapter": 17,
        "verse": 12
      },
      {
        "text": "And he said: Hear ye now, O house of David; is it a small thing for you to weary men, but will ye weary my God also?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Nephi 17:13",
        "book": "2 Nephi",
        "chapter": 17,
        "verse": 13
      },
