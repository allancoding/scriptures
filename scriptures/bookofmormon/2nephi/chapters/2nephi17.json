        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Nephi 17:10",
        "book": "2 Nephi",
        "chapter": 17,
        "verse": 10
      },
      {
