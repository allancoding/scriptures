            ]
          }
        ],
        "jstReferences": [],
        "reference": "Helaman 7:16",
        "book": "Helaman",
        "chapter": 7,
        "verse": 16
      },
      {
        "text": "O repent ye, repent ye! Why will ye die? Turn ye, turn ye unto the Lord your God. Why has he forsaken you?",
        "footNotes": [
          {
            "start": 24,
            "end": 27,
            "text": "Isa. 1:5 (5–6); Ezek. 18:23 (23, 32)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Helaman 7:17",
        "book": "Helaman",
        "chapter": 7,
        "verse": 17
      },
      {
        "text": "It is because you have hardened your hearts; yea, ye will not hearken unto the voice of the good shepherd; yea, ye have provoked him to anger against you.",
        "footNotes": [
          {
            "start": 62,
            "end": 69,
            "text": "TG Disobedience."
          },
          {
            "start": 92,
            "end": 105,
            "text": "Ezek. 34:12; John 10:14; Alma 5:60 (38–60). TG Jesus Christ, Good Shepherd."
          },
          {
            "start": 120,
            "end": 128,
            "text": "Num. 14:11 (11–12); 1 Ne. 17:30 (23–31); Jacob 1:8; Alma 12:37 (36–37)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "TG Disobedience.",
            "prettyString": "TG Disobedience",
            "references": [
