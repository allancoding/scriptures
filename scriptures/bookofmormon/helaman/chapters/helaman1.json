                        "end": 25
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "The Book of Helaman 1:4",
        "book": "The Book of Helaman",
        "chapter": 1,
        "verse": 4
      },
      {
        "text": "Nevertheless, it came to pass that Pahoran was appointed by the voice of the people to be chief judge and a governor over the people of Nephi.",
        "footNotes": [
