                        "end": 6
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ether 15:11",
        "book": "Ether",
        "chapter": 15,
        "verse": 11
      },
      {
        "text": "And it came to pass that they did gather together all the people upon all the face of the land, who had not been slain, save it was Ether.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 15:12",
        "book": "Ether",
        "chapter": 15,
        "verse": 12
      },
      {
        "text": "And it came to pass that Ether did behold all the doings of the people; and he beheld that the people who were for Coriantumr were gathered together to the army of Coriantumr; and the people who were for Shiz were gathered together to the army of Shiz.",
        "footNotes": [
          {
            "start": 35,
            "end": 41,
            "text": "Ether 13:14."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "Ether 13:14.",
            "prettyString": "Ether 13:14",
            "references": [
              {
                "type": "scripture",
                "book": "ether",
                "chapters": [
                  {
                    "start": 13,
                    "end": 13,
                    "verses": [
