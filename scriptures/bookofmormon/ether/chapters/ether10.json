                "entryId": "tg-tyranny",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ether 10:6",
        "book": "Ether",
        "chapter": 10,
        "verse": 6
      },
      {
        "text": "Wherefore he did obtain all his fine work, yea, even his fine gold he did cause to be refined in prison; and all manner of fine workmanship he did cause to be wrought in prison. And it came to pass that he did afflict the people with his whoredoms and abominations.",
        "footNotes": [
          {
            "start": 62,
            "end": 66,
            "text": "Esth. 1:4."
          },
          {
            "start": 128,
            "end": 139,
