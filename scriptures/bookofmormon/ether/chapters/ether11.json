        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 11:3",
        "book": "Ether",
        "chapter": 11,
        "verse": 3
      },
      {
        "text": "And he lived to a good old age, and begat Shiblom; and Shiblom reigned in his stead. And the brother of Shiblom rebelled against him, and there began to be an exceedingly great war in all the land.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 11:4",
        "book": "Ether",
        "chapter": 11,
        "verse": 4
      },
      {
