        "reference": "Jacob 2:15",
        "book": "Jacob",
        "chapter": 2,
        "verse": 15
      },
      {
        "text": "O that he would rid you from this iniquity and abomination. And, O that ye would listen unto the word of his commands, and let not this pride of your hearts destroy your souls!",
        "footNotes": [
          {
            "start": 136,
            "end": 141,
            "text": "TG Pride."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "TG Pride.",
            "prettyString": "TG Pride",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
