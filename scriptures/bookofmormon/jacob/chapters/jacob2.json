                "entryId": "tg-pride",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jacob 2:16",
        "book": "Jacob",
        "chapter": 2,
        "verse": 16
      },
      {
        "text": "Think of your brethren like unto yourselves, and be familiar with all and free with your substance, that they may be rich like unto you.",
        "footNotes": [
          {
            "start": 14,
            "end": 22,
