        "verse": 2
      },
      {
        "text": "And ye yourselves know that I have hitherto been diligent in the office of my calling; but I this day am weighed down with much more desire and anxiety for the welfare of your souls than I have hitherto been.",
        "footNotes": [
          {
            "start": 160,
            "end": 167,
            "text": "2 Ne. 6:3; Mosiah 25:11."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
