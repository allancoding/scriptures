        "book": "The Book of Omni",
        "chapter": 1,
        "verse": 4
      },
      {
        "text": "Behold, it came to pass that three hundred and twenty years had passed away, and the more wicked part of the Nephites were destroyed.",
        "footNotes": [
          {
            "start": 123,
            "end": 132,
            "text": "Jarom 1:10."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
