        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 11:17",
        "book": "Alma",
        "chapter": 11,
        "verse": 17
      },
      {
        "text": "Now this is their number, according to their reckoning.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 11:18",
        "book": "Alma",
        "chapter": 11,
        "verse": 18
