  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 24,
    "summary": "The Lamanites come against the people of God—The Anti-Nephi-Lehies rejoice in Christ and are visited by angels—They choose to suffer death rather than to defend themselves—More Lamanites are converted. About 90–77 B.C.",
    "chapterAugmentations": [],
