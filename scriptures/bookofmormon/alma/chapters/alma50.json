                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Morm. 2:3.",
            "prettyString": "Mormon 2:3",
            "references": [
              {
                "type": "scripture",
                "book": "mormon",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
