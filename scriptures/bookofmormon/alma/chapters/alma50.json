                        "end": 3
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 50:11",
        "book": "Alma",
        "chapter": 50,
        "verse": 11
      },
      {
        "text": "Thus Moroni, with his armies, which did increase daily because of the assurance of protection which his works did bring forth unto them, did seek to cut off the strength and the power of the Lamanites from off the lands of their possessions, that they should have no power upon the lands of their possession.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:12",
        "book": "Alma",
        "chapter": 50,
        "verse": 12
      },
      {
        "text": "And it came to pass that the Nephites began the foundation of a city, and they called the name of the city Moroni; and it was by the east sea; and it was on the south by the line of the possessions of the Lamanites.",
        "footNotes": [
          {
            "start": 107,
            "end": 113,
            "text": "Alma 51:22 (22–24); 62:32 (32, 34); 3 Ne. 8:9."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:13",
        "book": "Alma",
        "chapter": 50,
        "verse": 13
      },
      {
        "text": "And they also began a foundation for a city between the city of Moroni and the city of Aaron, joining the borders of Aaron and Moroni; and they called the name of the city, or the land, Nephihah.",
        "footNotes": [
          {
            "start": 186,
            "end": 194,
            "text": "Alma 51:24 (24–26); 59:5; 62:18 (14, 18, 26)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:14",
        "book": "Alma",
        "chapter": 50,
        "verse": 14
      },
      {
        "text": "And they also began in that same year to build many cities on the north, one in a particular manner which they called Lehi, which was in the north by the borders of the seashore.",
        "footNotes": [
          {
            "start": 118,
            "end": 122,
            "text": "Alma 51:26 (24–26); 62:30."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:15",
        "book": "Alma",
        "chapter": 50,
        "verse": 15
      },
      {
        "text": "And thus ended the twentieth year.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:16",
        "book": "Alma",
        "chapter": 50,
        "verse": 16
      },
      {
        "text": "And in these prosperous circumstances were the people of Nephi in the commencement of the twenty and first year of the reign of the judges over the people of Nephi.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:17",
        "book": "Alma",
        "chapter": 50,
        "verse": 17
      },
      {
        "text": "And they did prosper exceedingly, and they became exceedingly rich; yea, and they did multiply and wax strong in the land.",
        "footNotes": [
          {
            "start": 21,
            "end": 32,
            "text": "Alma 1:29."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "Alma 1:29.",
            "prettyString": "Alma 1:29",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 1,
                    "end": 1,
                    "verses": [
                      {
                        "start": 29,
                        "end": 29
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 50:18",
        "book": "Alma",
        "chapter": 50,
        "verse": 18
      },
      {
        "text": "And thus we see how merciful and just are all the dealings of the Lord, to the fulfilling of all his words unto the children of men; yea, we can behold that his words are verified, even at this time, which he spake unto Lehi, saying:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:19",
        "book": "Alma",
        "chapter": 50,
        "verse": 19
      },
      {
        "text": "Blessed art thou and thy children; and they shall be blessed, inasmuch as they shall keep my commandments they shall prosper in the land. But remember, inasmuch as they will not keep my commandments they shall be cut off from the presence of the Lord.",
        "footNotes": [
          {
            "start": 93,
            "end": 105,
            "text": "Lev. 25:18 (18–19); Ps. 1:3 (2–3); Alma 37:13; 62:48."
          },
          {
            "start": 213,
            "end": 220,
            "text": "Ps. 37:2; D&C 1:14."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [
          {
            "raw": "Ps. 37:2; D&C 1:14.",
            "prettyString": "Psalms 37:2; D&C 1:14",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 37,
                    "end": 37,
                    "verses": [
                      {
                        "start": 2,
                        "end": 2
                      }
                    ]
                  }
                ]
              },
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 1,
                    "end": 1,
                    "verses": [
                      {
                        "start": 14,
                        "end": 14
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 50:20",
        "book": "Alma",
        "chapter": 50,
        "verse": 20
      },
      {
        "text": "And we see that these promises have been verified to the people of Nephi; for it has been their quarrelings and their contentions, yea, their murderings, and their plunderings, their idolatry, their whoredoms, and their abominations, which were among themselves, which brought upon them their wars and their destructions.",
        "footNotes": [
          {
            "start": 269,
            "end": 281,
            "text": "Alma 41:10."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [
          {
            "raw": "Alma 41:10.",
            "prettyString": "Alma 41:10",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 41,
                    "end": 41,
                    "verses": [
                      {
                        "start": 10,
                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 50:21",
        "book": "Alma",
        "chapter": 50,
        "verse": 21
      },
      {
        "text": "And those who were faithful in keeping the commandments of the Lord were delivered at all times, whilst thousands of their wicked brethren have been consigned to bondage, or to perish by the sword, or to dwindle in unbelief, and mingle with the Lamanites.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:22",
        "book": "Alma",
        "chapter": 50,
        "verse": 22
      },
      {
        "text": "But behold there never was a happier time among the people of Nephi, since the days of Nephi, than in the days of Moroni, yea, even at this time, in the twenty and first year of the reign of the judges.",
        "footNotes": [
          {
            "start": 29,
            "end": 36,
            "text": "2 Ne. 5:27; Mosiah 2:41; 4 Ne. 1:16 (15–18)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:23",
        "book": "Alma",
        "chapter": 50,
        "verse": 23
      },
      {
        "text": "And it came to pass that the twenty and second year of the reign of the judges also ended in peace; yea, and also the twenty and third year.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 50:24",
        "book": "Alma",
        "chapter": 50,
        "verse": 24
      },
      {
        "text": "And it came to pass that in the commencement of the twenty and fourth year of the reign of the judges, there would also have been peace among the people of Nephi had it not been for a contention which took place among them concerning the land of Lehi, and the land of Morianton, which joined upon the borders of Lehi; both of which were on the borders by the seashore.",
        "footNotes": [
          {
            "start": 184,
            "end": 194,
            "text": "TG Contention."
          },
          {
            "start": 246,
            "end": 250,
            "text": "Hel. 6:10."
          },
          {
            "start": 268,
            "end": 277,
            "text": "Alma 51:26."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [
          {
