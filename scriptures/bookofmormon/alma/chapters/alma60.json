                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:13",
        "book": "Alma",
        "chapter": 60,
        "verse": 13
      },
      {
        "text": "And now behold, I say unto you, I fear exceedingly that the judgments of God will come upon this people, because of their exceeding slothfulness, yea, even the slothfulness of our government, and their exceedingly great neglect towards their brethren, yea, towards those who have been slain.",
        "footNotes": [
          {
            "start": 132,
            "end": 144,
            "text": "TG Laziness."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "TG Laziness.",
            "prettyString": "TG Laziness",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Laziness",
                "entryId": "tg-laziness",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:14",
        "book": "Alma",
        "chapter": 60,
        "verse": 14
      },
      {
        "text": "For were it not for the wickedness which first commenced at our head, we could have withstood our enemies that they could have gained no power over us.",
        "footNotes": [
          {
            "start": 73,
            "end": 78,
            "text": "Alma 59:9."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "Alma 59:9.",
            "prettyString": "Alma 59:9",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 59,
                    "end": 59,
                    "verses": [
                      {
                        "start": 9,
                        "end": 9
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:15",
        "book": "Alma",
        "chapter": 60,
        "verse": 15
      },
      {
        "text": "Yea, had it not been for the war which broke out among ourselves; yea, were it not for these king-men, who caused so much bloodshed among ourselves; yea, at the time we were contending among ourselves, if we had united our strength as we hitherto have done; yea, had it not been for the desire of power and authority which those king-men had over us; had they been true to the cause of our freedom, and united with us, and gone forth against our enemies, instead of taking up their swords against us, which was the cause of so much bloodshed among ourselves; yea, if we had gone forth against them in the strength of the Lord, we should have dispersed our enemies, for it would have been done, according to the fulfilling of his word.",
        "footNotes": [
          {
            "start": 49,
            "end": 54,
            "text": "Alma 51:19 (5–7, 13–27)."
          },
          {
            "start": 93,
            "end": 101,
            "text": "Alma 62:9."
          },
          {
            "start": 711,
            "end": 721,
            "text": "Alma 38:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "Alma 62:9.",
            "prettyString": "Alma 62:9",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 62,
                    "end": 62,
                    "verses": [
                      {
                        "start": 9,
