                        "end": 1
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:16",
        "book": "Alma",
        "chapter": 60,
        "verse": 16
      },
      {
        "text": "But behold, now the Lamanites are coming upon us, taking possession of our lands, and they are murdering our people with the sword, yea, our women and our children, and also carrying them away captive, causing them that they should suffer all manner of afflictions, and this because of the great wickedness of those who are seeking for power and authority, yea, even those king-men.",
        "footNotes": [
          {
            "start": 57,
            "end": 67,
            "text": "Alma 59:8 (5–8)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:17",
        "book": "Alma",
        "chapter": 60,
        "verse": 17
      },
      {
        "text": "But why should I say much concerning this matter? For we know not but what ye yourselves are seeking for authority. We know not but what ye are also traitors to your country.",
        "footNotes": [
          {
            "start": 149,
            "end": 157,
            "text": "Alma 62:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "Alma 62:1.",
            "prettyString": "Alma 62:1",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 62,
                    "end": 62,
                    "verses": [
                      {
                        "start": 1,
                        "end": 1
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:18",
        "book": "Alma",
        "chapter": 60,
        "verse": 18
      },
      {
        "text": "Or is it that ye have neglected us because ye are in the heart of our country and ye are surrounded by security, that ye do not cause food to be sent unto us, and also men to strengthen our armies?",
        "footNotes": [
          {
            "start": 89,
            "end": 99,
            "text": "TG Apathy."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
          {
            "raw": "TG Apathy.",
            "prettyString": "TG Apathy",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Apathy",
                "entryId": "tg-apathy",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:19",
        "book": "Alma",
        "chapter": 60,
        "verse": 19
      },
      {
        "text": "Have ye forgotten the commandments of the Lord your God? Yea, have ye forgotten the captivity of our fathers? Have ye forgotten the many times we have been delivered out of the hands of our enemies?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:20",
        "book": "Alma",
        "chapter": 60,
        "verse": 20
      },
      {
        "text": "Or do ye suppose that the Lord will still deliver us, while we sit upon our thrones and do not make use of the means which the Lord has provided for us?",
        "footNotes": [
          {
            "start": 31,
            "end": 35,
            "text": "1 Ne. 17:23 (23–35)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:21",
        "book": "Alma",
        "chapter": 60,
        "verse": 21
      },
      {
        "text": "Yea, will ye sit in idleness while ye are surrounded with thousands of those, yea, and tens of thousands, who do also sit in idleness, while there are thousands round about in the borders of the land who are falling by the sword, yea, wounded and bleeding?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:22",
        "book": "Alma",
        "chapter": 60,
        "verse": 22
      },
      {
        "text": "Do ye suppose that God will look upon you as guiltless while ye sit still and behold these things? Behold I say unto you, Nay. Now I would that ye should remember that God has said that the inward vessel shall be cleansed first, and then shall the outer vessel be cleansed also.",
        "footNotes": [
          {
            "start": 190,
            "end": 196,
            "text": "Matt. 23:26 (25–26)."
          },
          {
            "start": 213,
            "end": 221,
            "text": "TG Purification."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [
          {
            "raw": "TG Purification.",
            "prettyString": "TG Purification",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Purification",
                "entryId": "tg-purification",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:23",
        "book": "Alma",
        "chapter": 60,
        "verse": 23
      },
      {
        "text": "And now, except ye do repent of that which ye have done, and begin to be up and doing, and send forth food and men unto us, and also unto Helaman, that he may support those parts of our country which he has regained, and that we may also recover the remainder of our possessions in these parts, behold it will be expedient that we contend no more with the Lamanites until we have first cleansed our inward vessel, yea, even the great head of our government.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:24",
        "book": "Alma",
        "chapter": 60,
        "verse": 24
      },
      {
        "text": "And except ye grant mine epistle, and come out and show unto me a true spirit of freedom, and strive to strengthen and fortify our armies, and grant unto them food for their support, behold I will leave a part of my freemen to maintain this part of our land, and I will leave the strength and the blessings of God upon them, that none other power can operate against them—",
        "footNotes": [
          {
            "start": 71,
            "end": 77,
            "text": "Alma 51:6 (6–7); 61:15."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:25",
        "book": "Alma",
        "chapter": 60,
        "verse": 25
      },
      {
        "text": "And this because of their exceeding faith, and their patience in their tribulations—",
        "footNotes": [
          {
            "start": 71,
            "end": 83,
            "text": "TG Tribulation."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [
          {
            "raw": "TG Tribulation.",
            "prettyString": "TG Tribulation",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Tribulation",
                "entryId": "tg-tribulation",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:26",
        "book": "Alma",
        "chapter": 60,
        "verse": 26
      },
      {
        "text": "And I will come unto you, and if there be any among you that has a desire for freedom, yea, if there be even a spark of freedom remaining, behold I will stir up insurrections among you, even until those who have desires to usurp power and authority shall become extinct.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 27,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:27",
        "book": "Alma",
        "chapter": 60,
        "verse": 27
      },
      {
        "text": "Yea, behold I do not fear your power nor your authority, but it is my God whom I fear; and it is according to his commandments that I do take my sword to defend the cause of my country, and it is because of your iniquity that we have suffered so much loss.",
        "footNotes": [
          {
            "start": 70,
            "end": 73,
            "text": "Acts 5:29 (26–29)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 28,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:28",
        "book": "Alma",
        "chapter": 60,
        "verse": 28
      },
      {
        "text": "Behold it is time, yea, the time is now at hand, that except ye do bestir yourselves in the defence of your country and your little ones, the sword of justice doth hang over you; yea, and it shall fall upon you and visit you even to your utter destruction.",
        "footNotes": [
          {
            "start": 142,
            "end": 147,
            "text": "Isa. 1:20 (19–20); Hel. 13:5; 3 Ne. 2:19."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 29,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:29",
        "book": "Alma",
        "chapter": 60,
        "verse": 29
      },
      {
        "text": "Behold, I wait for assistance from you; and, except ye do administer unto our relief, behold, I come unto you, even in the land of Zarahemla, and smite you with the sword, insomuch that ye can have no more power to impede the progress of this people in the cause of our freedom.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 30,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:30",
        "book": "Alma",
        "chapter": 60,
        "verse": 30
      },
      {
        "text": "For behold, the Lord will not suffer that ye shall live and wax strong in your iniquities to destroy his righteous people.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 31,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 60:31",
        "book": "Alma",
        "chapter": 60,
        "verse": 31
      },
      {
        "text": "Behold, can you suppose that the Lord will spare you and come out in judgment against the Lamanites, when it is the tradition of their fathers that has caused their hatred, yea, and it has been redoubled by those who have dissented from us, while your iniquity is for the cause of your love of glory and the vain things of the world?",
        "footNotes": [
          {
            "start": 116,
            "end": 125,
            "text": "Alma 17:15."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 32,
        "crossReferences": [
          {
            "raw": "Alma 17:15.",
            "prettyString": "Alma 17:15",
            "references": [
              {
                "type": "scripture",
