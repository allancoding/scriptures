  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 60,
    "summary": "Moroni complains to Pahoran of the government’s neglect of the armies—The Lord suffers the righteous to be slain—The Nephites must use all of their power and means to deliver themselves from their enemies—Moroni threatens to fight against the government unless help is supplied to his armies. About 62 B.C.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass that he wrote again to the governor of the land, who was Pahoran, and these are the words which he wrote, saying: Behold, I direct mine epistle to Pahoran, in the city of Zarahemla, who is the chief judge and the governor over the land, and also to all those who have been chosen by this people to govern and manage the affairs of this war.",
        "footNotes": [
          {
            "start": 34,
            "end": 39,
            "text": "Alma 59:3."
          },
          {
            "start": 233,
            "end": 241,
            "text": "Alma 50:39."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
