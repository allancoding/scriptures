          }
        ],
        "jstReferences": [],
        "reference": "Alma 60:1",
        "book": "Alma",
        "chapter": 60,
        "verse": 1
      },
      {
        "text": "For behold, I have somewhat to say unto them by the way of condemnation; for behold, ye yourselves know that ye have been appointed to gather together men, and arm them with swords, and with cimeters, and all manner of weapons of war of every kind, and send forth against the Lamanites, in whatsoever parts they should come into our land.",
        "footNotes": [
          {
            "start": 59,
            "end": 71,
            "text": "TG Reproof."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "TG Reproof.",
            "prettyString": "TG Reproof",
            "references": [
              {
