                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Alma 38:1.",
            "prettyString": "Alma 38:1",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 38,
                    "end": 38,
                    "verses": [
                      {
