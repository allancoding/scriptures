  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 7,
    "summary": "Christ will be born of Mary—He will loose the bands of death and bear the sins of His people—Those who repent, are baptized, and keep the commandments will have eternal life—Filthiness cannot inherit the kingdom of God—Humility, faith, hope, and charity are required. About 83 B.C.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Comprising chapter 7."
      }
    ],
    "verses": [
      {
        "text": "Behold my beloved brethren, seeing that I have been permitted to come unto you, therefore I attempt to address you in my language; yea, by my own mouth, seeing that it is the first time that I have spoken unto you by the words of my mouth, I having been wholly confined to the judgment-seat, having had much business that I could not come unto you.",
        "footNotes": [
