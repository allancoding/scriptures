        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 22:8",
        "book": "Alma",
        "chapter": 22,
        "verse": 8
      },
      {
        "text": "And the king said: Is God that Great Spirit that brought our fathers out of the land of Jerusalem?",
        "footNotes": [
          {
