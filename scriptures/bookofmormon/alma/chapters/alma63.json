        "book": "Alma",
        "chapter": 63,
        "verse": 7
      },
      {
        "text": "And it came to pass that they were never heard of more. And we suppose that they were drowned in the depths of the sea. And it came to pass that one other ship also did sail forth; and whither she did go we know not.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 63:8",
        "book": "Alma",
        "chapter": 63,
        "verse": 8
      },
