                        "end": 4
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 29:1",
        "book": "Alma",
        "chapter": 29,
        "verse": 1
      },
      {
        "text": "Yea, I would declare unto every soul, as with the voice of thunder, repentance and the plan of redemption, that they should repent and come unto our God, that there might not be more sorrow upon all the face of the earth.",
        "footNotes": [
          {
            "start": 135,
            "end": 139,
            "text": "Omni 1:26 (25–26); 3 Ne. 21:20."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 29:2",
        "book": "Alma",
        "chapter": 29,
        "verse": 2
      },
      {
        "text": "But behold, I am a man, and do sin in my wish; for I ought to be content with the things which the Lord hath allotted unto me.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 29:3",
        "book": "Alma",
        "chapter": 29,
        "verse": 3
      },
      {
        "text": "I ought not to harrow up in my desires the firm decree of a just God, for I know that he granteth unto men according to their desire, whether it be unto death or unto life; yea, I know that he allotteth unto men, yea, decreeth unto them decrees which are unalterable, according to their wills, whether they be unto salvation or unto destruction.",
        "footNotes": [
          {
            "start": 126,
            "end": 132,
            "text": "Ps. 21:2; 37:4."
          },
          {
            "start": 287,
            "end": 292,
            "text": "TG Agency."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "Ps. 21:2; 37:4.",
            "prettyString": "Psalms 21:2; 37:4",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 21,
                    "end": 21,
                    "verses": [
                      {
