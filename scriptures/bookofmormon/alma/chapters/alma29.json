  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 29,
    "summary": "Alma desires to cry repentance with angelic zeal—The Lord grants teachers for all nations—Alma glories in the Lord’s work and in the success of Ammon and his brethren. About 76 B.C.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "O that I were an angel, and could have the wish of mine heart, that I might go forth and speak with the trump of God, with a voice to shake the earth, and cry repentance unto every people!",
        "footNotes": [
          {
            "start": 104,
            "end": 109,
            "text": "Isa. 58:1; D&C 29:4."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
            "raw": "Isa. 58:1; D&C 29:4.",
            "prettyString": "Isaiah 58:1; D&C 29:4",
            "references": [
              {
                "type": "scripture",
                "book": "isaiah",
                "chapters": [
                  {
                    "start": 58,
                    "end": 58,
                    "verses": [
                      {
                        "start": 1,
                        "end": 1
                      }
                    ]
                  }
                ]
              },
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 29,
                    "end": 29,
                    "verses": [
                      {
