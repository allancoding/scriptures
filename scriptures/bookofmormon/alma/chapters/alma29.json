                "entryId": "tg-agency",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 29:4",
        "book": "Alma",
        "chapter": 29,
        "verse": 4
      },
      {
        "text": "Yea, and I know that good and evil have come before all men; he that knoweth not good from evil is blameless; but he that knoweth good and evil, to him it is given according to his desires, whether he desireth good or evil, life or death, joy or remorse of conscience.",
        "footNotes": [
          {
            "start": 99,
            "end": 108,
            "text": "TG Accountability."
          },
          {
            "start": 122,
            "end": 129,
            "text": "Gen. 3:5; 2 Ne. 2:18 (18, 26); Mosiah 16:3; Moro. 7:16 (15–19). TG Discernment, Spiritual."
          },
          {
            "start": 257,
            "end": 267,
            "text": "Job 27:6. TG Conscience."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
