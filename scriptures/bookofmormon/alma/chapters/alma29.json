        "book": "Alma",
        "chapter": 29,
        "verse": 8
      },
      {
        "text": "I know that which the Lord hath commanded me, and I glory in it. I do not glory of myself, but I glory in that which the Lord hath commanded me; yea, and this is my glory, that perhaps I may be an instrument in the hands of God to bring some soul to repentance; and this is my joy.",
        "footNotes": [
          {
            "start": 70,
            "end": 73,
            "text": "Alma 26:12."
          },
          {
            "start": 74,
            "end": 79,
            "text": "TG Glory."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "Alma 26:12.",
            "prettyString": "Alma 26:12",
            "references": [
