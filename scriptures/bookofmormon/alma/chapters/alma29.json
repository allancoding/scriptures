                        "end": 2
                      }
                    ]
                  },
                  {
                    "start": 37,
                    "end": 37,
                    "verses": [
                      {
                        "start": 4,
                        "end": 4
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "TG Agency.",
            "prettyString": "TG Agency",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
