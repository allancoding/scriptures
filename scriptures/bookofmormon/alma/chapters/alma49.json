                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:6",
        "book": "Alma",
        "chapter": 49,
        "verse": 6
      },
      {
        "text": "And being thus prepared they supposed that they should easily overpower and subject their brethren to the yoke of bondage, or slay and massacre them according to their pleasure.",
        "footNotes": [
          {
            "start": 76,
            "end": 83,
            "text": "Alma 43:29."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Alma 43:29.",
            "prettyString": "Alma 43:29",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 43,
                    "end": 43,
                    "verses": [
                      {
                        "start": 29,
                        "end": 29
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:7",
        "book": "Alma",
        "chapter": 49,
        "verse": 7
      },
      {
        "text": "But behold, to their uttermost astonishment, they were prepared for them, in a manner which never had been known among the children of Lehi. Now they were prepared for the Lamanites, to battle after the manner of the instructions of Moroni.",
        "footNotes": [
          {
            "start": 55,
            "end": 63,
            "text": "Alma 48:7 (7–10)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:8",
        "book": "Alma",
        "chapter": 49,
        "verse": 8
      },
      {
        "text": "And it came to pass that the Lamanites, or the Amalickiahites, were exceedingly astonished at their manner of preparation for war.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:9",
        "book": "Alma",
        "chapter": 49,
        "verse": 9
      },
      {
        "text": "Now, if king Amalickiah had come down out of the land of Nephi, at the head of his army, perhaps he would have caused the Lamanites to have attacked the Nephites at the city of Ammonihah; for behold, he did care not for the blood of his people.",
        "footNotes": [
          {
            "start": 49,
            "end": 62,
            "text": "2 Ne. 5:8; Omni 1:12; Alma 47:1 (1, 13–24)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:10",
        "book": "Alma",
        "chapter": 49,
        "verse": 10
      },
      {
        "text": "But behold, Amalickiah did not come down himself to battle. And behold, his chief captains durst not attack the Nephites at the city of Ammonihah, for Moroni had altered the management of affairs among the Nephites, insomuch that the Lamanites were disappointed in their places of retreat and they could not come upon them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:11",
        "book": "Alma",
        "chapter": 49,
        "verse": 11
      },
      {
        "text": "Therefore they retreated into the wilderness, and took their camp and marched towards the land of Noah, supposing that to be the next best place for them to come against the Nephites.",
        "footNotes": [
          {
            "start": 98,
            "end": 102,
            "text": "Alma 16:3."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "Alma 16:3.",
            "prettyString": "Alma 16:3",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 16,
                    "end": 16,
                    "verses": [
                      {
                        "start": 3,
                        "end": 3
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:12",
        "book": "Alma",
        "chapter": 49,
        "verse": 12
      },
      {
        "text": "For they knew not that Moroni had fortified, or had built forts of security, for every city in all the land round about; therefore, they marched forward to the land of Noah with a firm determination; yea, their chief captains came forward and took an oath that they would destroy the people of that city.",
        "footNotes": [
          {
            "start": 58,
            "end": 63,
            "text": "Alma 48:8; 50:10 (1–6, 10)."
          },
          {
            "start": 251,
            "end": 255,
            "text": "Alma 49:17."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "Alma 49:17.",
            "prettyString": "Alma 49:17",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 49,
                    "end": 49,
                    "verses": [
                      {
                        "start": 17,
                        "end": 17
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:13",
        "book": "Alma",
        "chapter": 49,
        "verse": 13
      },
      {
        "text": "But behold, to their astonishment, the city of Noah, which had hitherto been a weak place, had now, by the means of Moroni, become strong, yea, even to exceed the strength of the city Ammonihah.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:14",
        "book": "Alma",
        "chapter": 49,
        "verse": 14
      },
      {
        "text": "And now, behold, this was wisdom in Moroni; for he had supposed that they would be frightened at the city Ammonihah; and as the city of Noah had hitherto been the weakest part of the land, therefore they would march thither to battle; and thus it was according to his desires.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:15",
        "book": "Alma",
        "chapter": 49,
        "verse": 15
      },
      {
        "text": "And behold, Moroni had appointed Lehi to be chief captain over the men of that city; and it was that same Lehi who fought with the Lamanites in the valley on the east of the river Sidon.",
        "footNotes": [
          {
            "start": 101,
            "end": 105,
            "text": "Alma 43:35."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "Alma 43:35.",
            "prettyString": "Alma 43:35",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 43,
                    "end": 43,
                    "verses": [
                      {
                        "start": 35,
                        "end": 35
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:16",
        "book": "Alma",
        "chapter": 49,
        "verse": 16
      },
      {
        "text": "And now behold it came to pass, that when the Lamanites had found that Lehi commanded the city they were again disappointed, for they feared Lehi exceedingly; nevertheless their chief captains had sworn with an oath to attack the city; therefore, they brought up their armies.",
        "footNotes": [
          {
            "start": 197,
            "end": 202,
            "text": "Alma 49:13."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [
          {
            "raw": "Alma 49:13.",
            "prettyString": "Alma 49:13",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 49,
                    "end": 49,
                    "verses": [
                      {
                        "start": 13,
                        "end": 13
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:17",
        "book": "Alma",
        "chapter": 49,
        "verse": 17
      },
      {
        "text": "Now behold, the Lamanites could not get into their forts of security by any other way save by the entrance, because of the highness of the bank which had been thrown up, and the depth of the ditch which had been dug round about, save it were by the entrance.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:18",
        "book": "Alma",
        "chapter": 49,
        "verse": 18
      },
      {
        "text": "And thus were the Nephites prepared to destroy all such as should attempt to climb up to enter the fort by any other way, by casting over stones and arrows at them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:19",
        "book": "Alma",
        "chapter": 49,
        "verse": 19
      },
      {
        "text": "Thus they were prepared, yea, a body of their strongest men, with their swords and their slings, to smite down all who should attempt to come into their place of security by the place of entrance; and thus were they prepared to defend themselves against the Lamanites.",
        "footNotes": [
          {
            "start": 187,
            "end": 195,
            "text": "Alma 49:4 (4, 18, 21, 24)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:20",
        "book": "Alma",
        "chapter": 49,
        "verse": 20
      },
      {
        "text": "And it came to pass that the captains of the Lamanites brought up their armies before the place of entrance, and began to contend with the Nephites, to get into their place of security; but behold, they were driven back from time to time, insomuch that they were slain with an immense slaughter.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:21",
        "book": "Alma",
        "chapter": 49,
        "verse": 21
      },
      {
        "text": "Now when they found that they could not obtain power over the Nephites by the pass, they began to dig down their banks of earth that they might obtain a pass to their armies, that they might have an equal chance to fight; but behold, in these attempts they were swept off by the stones and arrows which were thrown at them; and instead of filling up their ditches by pulling down the banks of earth, they were filled up in a measure with their dead and wounded bodies.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 49:22",
        "book": "Alma",
        "chapter": 49,
        "verse": 22
      },
      {
        "text": "Thus the Nephites had all power over their enemies; and thus the Lamanites did attempt to destroy the Nephites until their chief captains were all slain; yea, and more than a thousand of the Lamanites were slain; while, on the other hand, there was not a single soul of the Nephites which was slain.",
        "footNotes": [
          {
            "start": 123,
            "end": 128,
            "text": "Alma 48:5."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [
          {
            "raw": "Alma 48:5.",
            "prettyString": "Alma 48:5",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 48,
                    "end": 48,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:23",
        "book": "Alma",
        "chapter": 49,
        "verse": 23
      },
      {
        "text": "There were about fifty who were wounded, who had been exposed to the arrows of the Lamanites through the pass, but they were shielded by their shields, and their breastplates, and their head-plates, insomuch that their wounds were upon their legs, many of which were very severe.",
        "footNotes": [
          {
            "start": 143,
            "end": 150,
            "text": "Alma 43:19."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [
          {
            "raw": "Alma 43:19.",
            "prettyString": "Alma 43:19",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 43,
                    "end": 43,
                    "verses": [
