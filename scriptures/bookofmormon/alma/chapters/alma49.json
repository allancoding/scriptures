              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 49:24",
        "book": "Alma",
        "chapter": 49,
        "verse": 24
      },
      {
        "text": "And it came to pass, that when the Lamanites saw that their chief captains were all slain they fled into the wilderness. And it came to pass that they returned to the land of Nephi, to inform their king, Amalickiah, who was a Nephite by birth, concerning their great loss.",
        "footNotes": [
          {
            "start": 226,
            "end": 233,
            "text": "Alma 46:3."
          },
          {
            "start": 267,
            "end": 271,
