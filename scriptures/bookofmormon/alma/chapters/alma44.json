          }
        ],
        "jstReferences": [],
        "reference": "Alma 44:5",
        "book": "Alma",
        "chapter": 44,
        "verse": 5
      },
      {
        "text": "Yea, and this is not all; I command you by all the desires which ye have for life, that ye deliver up your weapons of war unto us, and we will seek not your blood, but we will spare your lives, if ye will go your way and come not again to war against us.",
        "footNotes": [
          {
            "start": 91,
            "end": 98,
            "text": "Alma 52:25 (25, 32)."
          },
          {
            "start": 176,
            "end": 181,
            "text": "TG Benevolence."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
            "raw": "TG Benevolence.",
            "prettyString": "TG Benevolence",
            "references": [
              {
                "type": "studyHelp",
