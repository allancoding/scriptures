                "title": "Benevolence",
                "entryId": "tg-benevolence",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 44:6",
        "book": "Alma",
        "chapter": 44,
        "verse": 6
      },
      {
        "text": "And now, if ye do not this, behold, ye are in our hands, and I will command my men that they shall fall upon you, and inflict the wounds of death in your bodies, that ye may become extinct; and then we will see who shall have power over this people; yea, we will see who shall be brought into bondage.",
        "footNotes": [
          {
            "start": 118,
            "end": 125,
            "text": "Alma 62:11."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Alma 62:11.",
            "prettyString": "Alma 62:11",
            "references": [
