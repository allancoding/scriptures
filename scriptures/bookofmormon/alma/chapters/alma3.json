            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 3:1",
        "book": "Alma",
        "chapter": 3,
        "verse": 1
      },
      {
        "text": "Now many women and children had been slain with the sword, and also many of their flocks and their herds; and also many of their fields of grain were destroyed, for they were trodden down by the hosts of men.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 3:2",
        "book": "Alma",
        "chapter": 3,
        "verse": 2
      },
      {
        "text": "And now as many of the Lamanites and the Amlicites who had been slain upon the bank of the river Sidon were cast into the waters of Sidon; and behold their bones are in the depths of the sea, and they are many.",
        "footNotes": [
          {
            "start": 122,
            "end": 137,
            "text": "Alma 2:15; 4:4."
          },
          {
            "start": 187,
            "end": 190,
            "text": "Alma 44:22."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "Alma 2:15; 4:4.",
            "prettyString": "Alma 2:15; 4:4",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
                      {
                        "start": 15,
                        "end": 15
                      }
                    ]
                  },
                  {
                    "start": 4,
                    "end": 4,
                    "verses": [
                      {
                        "start": 4,
                        "end": 4
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Alma 44:22.",
            "prettyString": "Alma 44:22",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 44,
                    "end": 44,
                    "verses": [
                      {
