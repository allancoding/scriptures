  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 3,
    "summary": "The Amlicites had marked themselves according to the prophetic word—The Lamanites had been cursed for their rebellion—Men bring their own curses upon themselves—The Nephites defeat another Lamanite army. About 87–86 B.C.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass that the Nephites who were not slain by the weapons of war, after having buried those who had been slain—now the number of the slain were not numbered, because of the greatness of their number—after they had finished burying their dead they all returned to their lands, and to their houses, and their wives, and their children.",
        "footNotes": [
          {
            "start": 51,
            "end": 56,
            "text": "Alma 2:19; 4:2."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
