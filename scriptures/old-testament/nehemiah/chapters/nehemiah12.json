        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:13",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 13
      },
      {
