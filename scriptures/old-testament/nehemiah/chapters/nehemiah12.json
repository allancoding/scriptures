        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 32,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:32",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 32
