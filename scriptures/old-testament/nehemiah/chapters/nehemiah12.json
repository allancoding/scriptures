        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:14",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 14
      },
      {
