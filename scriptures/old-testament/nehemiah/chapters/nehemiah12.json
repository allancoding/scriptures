        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:16",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 16
      },
