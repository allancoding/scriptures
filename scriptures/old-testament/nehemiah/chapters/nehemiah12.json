        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:11",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 11
      },
      {
        "text": "And in the days of Joiakim were priests, the chief of the fathers: of Seraiah, Meraiah; of Jeremiah, Hananiah;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:12",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 12
      },
      {
