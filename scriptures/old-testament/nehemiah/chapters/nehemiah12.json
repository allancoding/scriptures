        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 12:15",
        "book": "Nehemiah",
        "chapter": 12,
        "verse": 15
      },
