                      {
                        "start": 30,
                        "end": 30
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 5:21",
        "book": "Job",
        "chapter": 5,
        "verse": 21
      },
      {
        "text": "At destruction and famine thou shalt laugh: neither shalt thou be afraid of the beasts of the earth.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 5:22",
        "book": "Job",
        "chapter": 5,
        "verse": 22
      },
      {
        "text": "For thou shalt be in league with the stones of the field: and the beasts of the field shall be at peace with thee.",
        "footNotes": [
          {
            "start": 66,
            "end": 72,
            "text": "Hosea 2:18."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [
          {
            "raw": "Hosea 2:18.",
            "prettyString": "Hosea 2:18",
            "references": [
              {
                "type": "scripture",
                "book": "hosea",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
                      {
                        "start": 18,
                        "end": 18
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 5:23",
        "book": "Job",
        "chapter": 5,
        "verse": 23
      },
      {
        "text": "And thou shalt know that thy tabernacle shall be in peace; and thou shalt visit thy habitation, and shalt not sin.",
        "footNotes": [],
        "italics": [
          {
            "start": 40,
            "end": 48
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 5:24",
        "book": "Job",
        "chapter": 5,
        "verse": 24
      },
      {
        "text": "Thou shalt know also that thy seed shall be great, and thine offspring as the grass of the earth.",
        "footNotes": [
          {
            "start": 78,
            "end": 83,
            "text": "Ps. 72:16."
          }
        ],
        "italics": [
          {
            "start": 35,
            "end": 43
          }
        ],
        "associatedContent": [],
