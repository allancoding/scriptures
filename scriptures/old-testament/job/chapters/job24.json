        "text": "He evil entreateth the barren that beareth not: and doeth not good to the widow.",
        "footNotes": [],
        "italics": [
          {
            "start": 30,
            "end": 34
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:21",
        "book": "Job",
        "chapter": 24,
        "verse": 21
      },
