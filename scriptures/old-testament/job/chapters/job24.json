        ],
        "italics": [
          {
            "start": 97,
            "end": 105
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:12",
        "book": "Job",
        "chapter": 24,
        "verse": 12
      },
      {
