  "chapter": {
    "bookTitle": "Job",
    "delineation": "Chapter",
    "number": 24,
    "summary": "Murderers, adulterers, those who oppress the poor, and wicked people in general often go unpunished for a little while.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Why, seeing times are not hidden from the Almighty, do they that know him not see his days?",
