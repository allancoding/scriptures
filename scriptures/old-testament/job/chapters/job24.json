        "jstReferences": [],
        "reference": "Job 24:11",
        "book": "Job",
        "chapter": 24,
        "verse": 11
      },
      {
        "text": "Men groan from out of the city, and the soul of the wounded crieth out: yet God layeth not folly to them.",
        "footNotes": [
          {
            "start": 80,
            "end": 86,
            "text": "OR does not give heed to their prayer."
