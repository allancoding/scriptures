        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:9",
        "book": "Job",
        "chapter": 24,
        "verse": 9
      },
      {
