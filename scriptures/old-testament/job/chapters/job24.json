          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:5",
        "book": "Job",
        "chapter": 24,
        "verse": 5
      },
      {
        "text": "They reap every one his corn in the field: and they gather the vintage of the wicked.",
        "footNotes": [
          {
            "start": 24,
            "end": 28,
            "text": "HEB fodder."
          }
        ],
        "italics": [
          {
            "start": 10,
