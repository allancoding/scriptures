        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:6",
        "book": "Job",
        "chapter": 24,
        "verse": 6
      },
      {
        "text": "They cause the naked to lodge without clothing, that they have no covering in the cold.",
        "footNotes": [],
        "italics": [
          {
            "start": 53,
            "end": 62
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:7",
        "book": "Job",
        "chapter": 24,
        "verse": 7
      },
      {
        "text": "They are wet with the showers of the mountains, and embrace the rock for want of a shelter.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 24:8",
        "book": "Job",
        "chapter": 24,
        "verse": 8
      },
      {
