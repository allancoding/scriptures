        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 4:5",
        "book": "Job",
        "chapter": 4,
        "verse": 5
      },
      {
