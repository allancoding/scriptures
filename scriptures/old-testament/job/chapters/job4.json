            "start": 0,
            "end": 2
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 4:2",
        "book": "Job",
        "chapter": 4,
        "verse": 2
      },
      {
        "text": "Behold, thou hast instructed many, and thou hast strengthened the weak hands.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 4:3",
        "book": "Job",
        "chapter": 4,
        "verse": 3
      },
      {
        "text": "Thy words have upholden him that was falling, and thou hast strengthened the feeble knees.",
        "footNotes": [],
