        ],
        "jstReferences": [],
        "reference": "Job 19:21",
        "book": "Job",
        "chapter": 19,
        "verse": 21
      },
      {
        "text": "Why do ye persecute me as God, and are not satisfied with my flesh?",
        "footNotes": [
          {
            "start": 58,
            "end": 66,
            "text": "IE the state of my body, or suffering."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 19:22",
        "book": "Job",
        "chapter": 19,
        "verse": 22
      },
      {
        "text": "Oh that my words were now written! oh that they were printed in a book!",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 19:23",
        "book": "Job",
        "chapter": 19,
        "verse": 23
      },
      {
        "text": "That they were graven with an iron pen and lead in the rock for ever!",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 19:24",
        "book": "Job",
        "chapter": 19,
        "verse": 24
      },
