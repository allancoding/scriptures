        "book": "Job",
        "chapter": 9,
        "verse": 8
      },
      {
        "text": "Which maketh Arcturus, Orion, and Pleiades, and the chambers of the south.",
        "footNotes": [
          {
            "start": 23,
            "end": 28,
            "text": "TG Astronomy."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
