            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 9:3",
        "book": "Job",
        "chapter": 9,
        "verse": 3
      },
      {
        "text": "He is wise in heart, and mighty in strength: who hath hardened himself against him, and hath prospered?",
        "footNotes": [
          {
            "start": 54,
            "end": 62,
            "text": "TG Hardheartedness."
          }
        ],
        "italics": [
          {
            "start": 0,
            "end": 5
          },
          {
            "start": 63,
            "end": 70
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG Hardheartedness.",
            "prettyString": "TG Hardheartedness",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Hardheartedness",
                "entryId": "tg-hardheartedness",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 9:4",
        "book": "Job",
        "chapter": 9,
        "verse": 4
      },
      {
        "text": "Which removeth the mountains, and they know not: which overturneth them in his anger.",
        "footNotes": [
          {
            "start": 0,
            "end": 5,
            "text": "OR Who."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 9:5",
        "book": "Job",
        "chapter": 9,
        "verse": 5
      },
      {
        "text": "Which shaketh the earth out of her place, and the pillars thereof tremble.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 9:6",
        "book": "Job",
        "chapter": 9,
        "verse": 6
      },
      {
        "text": "Which commandeth the sun, and it riseth not; and sealeth up the stars.",
        "footNotes": [
          {
            "start": 49,
            "end": 59,
            "text": "IE hideth from view."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 9:7",
        "book": "Job",
        "chapter": 9,
        "verse": 7
      },
      {
        "text": "Which alone spreadeth out the heavens, and treadeth upon the waves of the sea.",
        "footNotes": [
          {
            "start": 12,
            "end": 21,
            "text": "Ps. 104:2; Isa. 40:22; 2 Ne. 8:13."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [
          {
            "raw": "Ps. 104:2; Isa. 40:22; 2 Ne. 8:13.",
            "prettyString": "Psalms 104:2; Isaiah 40:22; 2 Nephi 8:13",
            "references": [
