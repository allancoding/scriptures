                "entryId": "tg-heaven",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 16:19",
        "book": "Job",
        "chapter": 16,
        "verse": 19
      },
      {
        "text": "My friends scorn me: but mine eye poureth out tears unto God.",
        "footNotes": [
          {
            "start": 11,
            "end": 16,
            "text": "Job 21:3 (1–3)."
          }
        ],
        "italics": [
          {
            "start": 21,
            "end": 24
          },
          {
            "start": 46,
            "end": 51
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 16:20",
        "book": "Job",
        "chapter": 16,
        "verse": 20
      },
      {
        "text": "O that one might plead for a man with God, as a man pleadeth for his neighbour!",
        "footNotes": [],
        "italics": [
          {
            "start": 52,
            "end": 60
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 16:21",
        "book": "Job",
        "chapter": 16,
        "verse": 21
      },
      {
        "text": "When a few years are come, then I shall go the way whence I shall not return.",
        "footNotes": [
          {
            "start": 47,
            "end": 50,
            "text": "TG Death."
          }
        ],
