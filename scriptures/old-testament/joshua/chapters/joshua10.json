                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 10:29",
        "book": "Joshua",
        "chapter": 10,
        "verse": 29
      },
      {
        "text": "And the Lord delivered it also, and the king thereof, into the hand of Israel; and he smote it with the edge of the sword, and all the souls that were therein; he let none remain in it; but did unto the king thereof as he did unto the king of Jericho.",
        "footNotes": [],
        "italics": [
          {
            "start": 146,
            "end": 150
          }
        ],
        "associatedContent": [],
        "verseNumber": 30,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 10:30",
        "book": "Joshua",
        "chapter": 10,
        "verse": 30
      },
      {
        "text": "And Joshua passed from Libnah, and all Israel with him, unto Lachish, and encamped against it, and fought against it:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 31,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 10:31",
        "book": "Joshua",
        "chapter": 10,
        "verse": 31
      },
      {
        "text": "And the Lord delivered Lachish into the hand of Israel, which took it on the second day, and smote it with the edge of the sword, and all the souls that were therein, according to all that he had done to Libnah.",
        "footNotes": [],
        "italics": [
          {
            "start": 153,
            "end": 157
          }
        ],
        "associatedContent": [],
        "verseNumber": 32,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 10:32",
        "book": "Joshua",
        "chapter": 10,
        "verse": 32
      },
      {
