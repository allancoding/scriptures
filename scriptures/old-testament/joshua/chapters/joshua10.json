        "jstReferences": [],
        "reference": "Joshua 10:28",
        "book": "Joshua",
        "chapter": 10,
        "verse": 28
      },
      {
        "text": "Then Joshua passed from Makkedah, and all Israel with him, unto Libnah, and fought against Libnah:",
        "footNotes": [
          {
            "start": 91,
            "end": 97,
            "text": "Josh. 12:15."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 29,
        "crossReferences": [
          {
