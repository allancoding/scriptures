        "reference": "Joshua 10:35",
        "book": "Joshua",
        "chapter": 10,
        "verse": 35
      },
      {
        "text": "And Joshua went up from Eglon, and all Israel with him, unto Hebron; and they fought against it:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 36,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 10:36",
        "book": "Joshua",
        "chapter": 10,
        "verse": 36
      },
      {
