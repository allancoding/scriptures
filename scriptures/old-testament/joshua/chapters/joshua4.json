                "entryId": "tg-symbolism",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:7",
        "book": "Joshua",
        "chapter": 4,
        "verse": 7
      },
      {
        "text": "And the children of Israel did so as Joshua commanded, and took up twelve stones out of the midst of Jordan, as the Lord spake unto Joshua, according to the number of the tribes of the children of Israel, and carried them over with them unto the place where they lodged, and laid them down there.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:8",
        "book": "Joshua",
        "chapter": 4,
        "verse": 8
      },
      {
        "text": "And Joshua set up twelve stones in the midst of Jordan, in the place where the feet of the priests which bare the ark of the covenant stood: and they are there unto this day.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:9",
        "book": "Joshua",
        "chapter": 4,
        "verse": 9
      },
      {
        "text": "For the priests which bare the ark stood in the midst of Jordan, until every thing was finished that the Lord commanded Joshua to speak unto the people, according to all that Moses commanded Joshua: and the people hasted and passed over.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:10",
        "book": "Joshua",
        "chapter": 4,
        "verse": 10
      },
      {
        "text": "And it came to pass, when all the people were clean passed over, that the ark of the Lord passed over, and the priests, in the presence of the people.",
        "footNotes": [
          {
            "start": 52,
            "end": 58,
            "text": "Deut. 3:28."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "Deut. 3:28.",
            "prettyString": "Deuteronomy 3:28",
            "references": [
              {
                "type": "scripture",
                "book": "deuteronomy",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 28,
                        "end": 28
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:11",
        "book": "Joshua",
        "chapter": 4,
        "verse": 11
      },
      {
        "text": "And the children of Reuben, and the children of Gad, and half the tribe of Manasseh, passed over armed before the children of Israel, as Moses spake unto them:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:12",
        "book": "Joshua",
        "chapter": 4,
        "verse": 12
      },
      {
        "text": "About forty thousand prepared for war passed over before the Lord unto battle, to the plains of Jericho.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:13",
        "book": "Joshua",
        "chapter": 4,
        "verse": 13
      },
      {
        "text": "On that day the Lord magnified Joshua in the sight of all Israel; and they feared him, as they feared Moses, all the days of his life.",
        "footNotes": [
          {
            "start": 21,
            "end": 30,
            "text": "Josh. 3:7."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "Josh. 3:7.",
            "prettyString": "Joshua 3:7",
            "references": [
              {
