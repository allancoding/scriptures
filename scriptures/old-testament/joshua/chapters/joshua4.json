                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:14",
        "book": "Joshua",
        "chapter": 4,
        "verse": 14
      },
      {
        "text": "And the Lord spake unto Joshua, saying,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:15",
        "book": "Joshua",
        "chapter": 4,
        "verse": 15
      },
      {
        "text": "Command the priests that bear the ark of the testimony, that they come up out of Jordan.",
        "footNotes": [
          {
            "start": 45,
            "end": 54,
            "text": "OR covenant."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:16",
        "book": "Joshua",
        "chapter": 4,
        "verse": 16
      },
      {
        "text": "Joshua therefore commanded the priests, saying, Come ye up out of Jordan.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:17",
        "book": "Joshua",
        "chapter": 4,
        "verse": 17
      },
      {
        "text": "And it came to pass, when the priests that bare the ark of the covenant of the Lord were come up out of the midst of Jordan, and the soles of the priests’ feet were lifted up unto the dry land, that the waters of Jordan returned unto their place, and flowed over all his banks, as they did before.",
        "footNotes": [],
        "italics": [
          {
            "start": 125,
            "end": 128
          },
          {
            "start": 281,
            "end": 289
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:18",
        "book": "Joshua",
        "chapter": 4,
        "verse": 18
      },
      {
        "text": "And the people came up out of Jordan on the tenth day of the first month, and encamped in Gilgal, in the east border of Jericho.",
        "footNotes": [
          {
            "start": 90,
            "end": 96,
            "text": "Josh. 5:9."
          }
        ],
        "italics": [
          {
            "start": 50,
            "end": 53
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
          {
            "raw": "Josh. 5:9.",
            "prettyString": "Joshua 5:9",
            "references": [
              {
                "type": "scripture",
                "book": "joshua",
                "chapters": [
