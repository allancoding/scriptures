                        "end": 2
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:3",
        "book": "Joshua",
        "chapter": 4,
        "verse": 3
      },
      {
        "text": "Then Joshua called the twelve men, whom he had prepared of the children of Israel, out of every tribe a man:",
        "footNotes": [
          {
            "start": 23,
            "end": 29,
            "text": "TG Church Organization."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG Church Organization.",
            "prettyString": "TG Church Organization",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Church Organization",
                "entryId": "tg-church-organization",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:4",
        "book": "Joshua",
        "chapter": 4,
        "verse": 4
      },
      {
        "text": "And Joshua said unto them, Pass over before the ark of the Lord your God into the midst of Jordan, and take ye up every man of you a stone upon his shoulder, according unto the number of the tribes of the children of Israel:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:5",
        "book": "Joshua",
        "chapter": 4,
        "verse": 5
      },
      {
        "text": "That this may be a sign among you, that when your children ask their fathers in time to come, saying, What mean ye by these stones?",
        "footNotes": [
          {
            "start": 50,
            "end": 58,
            "text": "TG Children."
          }
        ],
        "italics": [
          {
            "start": 35,
            "end": 39
          },
          {
            "start": 63,
            "end": 76
          },
          {
            "start": 107,
            "end": 111
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
            "raw": "TG Children.",
            "prettyString": "TG Children",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Children",
                "entryId": "tg-children",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:6",
        "book": "Joshua",
        "chapter": 4,
        "verse": 6
      },
      {
        "text": "Then ye shall answer them, That the waters of Jordan were cut off before the ark of the covenant of the Lord; when it passed over Jordan, the waters of Jordan were cut off: and these stones shall be for a memorial unto the children of Israel for ever.",
        "footNotes": [
          {
            "start": 77,
            "end": 80,
            "text": "TG Ark of the Covenant."
          },
          {
            "start": 205,
            "end": 213,
            "text": "TG Symbolism."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "TG Ark of the Covenant.",
            "prettyString": "TG Ark of the Covenant",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Ark of the Covenant",
                "entryId": "tg-ark-of-the-covenant",
                "book": "",
                "chapters": []
              }
            ]
          },
          {
            "raw": "TG Symbolism.",
            "prettyString": "TG Symbolism",
            "references": [
              {
                "type": "studyHelp",
