                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Deut. 27:2.",
            "prettyString": "Deuteronomy 27:2",
            "references": [
              {
                "type": "scripture",
                "book": "deuteronomy",
                "chapters": [
                  {
                    "start": 27,
                    "end": 27,
                    "verses": [
                      {
