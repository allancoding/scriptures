            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 4:19",
        "book": "Joshua",
        "chapter": 4,
        "verse": 19
      },
      {
        "text": "And those twelve stones, which they took out of Jordan, did Joshua pitch in Gilgal.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:20",
        "book": "Joshua",
        "chapter": 4,
        "verse": 20
      },
      {
        "text": "And he spake unto the children of Israel, saying, When your children shall ask their fathers in time to come, saying, What mean these stones?",
        "footNotes": [],
        "italics": [
          {
            "start": 123,
            "end": 127
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 4:21",
        "book": "Joshua",
        "chapter": 4,
        "verse": 21
      },
      {
        "text": "Then ye shall let your children know, saying, Israel came over this Jordan on dry land.",
        "footNotes": [
