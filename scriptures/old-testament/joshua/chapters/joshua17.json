          }
        ],
        "jstReferences": [],
        "reference": "Joshua 17:13",
        "book": "Joshua",
        "chapter": 17,
        "verse": 13
      },
      {
        "text": "And the children of Joseph spake unto Joshua, saying, Why hast thou given me but one lot and one portion to inherit, seeing I am a great people, forasmuch as the Lord hath blessed me hitherto?",
        "footNotes": [
          {
            "start": 131,
            "end": 143,
            "text": "Gen. 48:19."
          }
        ],
        "italics": [
          {
            "start": 77,
            "end": 80
          },
          {
            "start": 126,
            "end": 128
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "Gen. 48:19.",
            "prettyString": "Genesis 48:19",
            "references": [
              {
                "type": "scripture",
