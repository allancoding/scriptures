        "chapter": 7,
        "verse": 1
      },
      {
        "text": "And Joshua sent men from Jericho to Ai, which is beside Beth-aven, on the east side of Beth-el, and spake unto them, saying, Go up and view the country. And the men went up and viewed Ai.",
        "footNotes": [
          {
            "start": 56,
            "end": 65,
            "text": "Josh. 18:12."
          }
        ],
        "italics": [
          {
            "start": 46,
            "end": 48
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "Josh. 18:12.",
            "prettyString": "Joshua 18:12",
            "references": [
              {
                "type": "scripture",
                "book": "joshua",
                "chapters": [
                  {
