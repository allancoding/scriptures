        "reference": "Judges 12:7",
        "book": "Judges",
        "chapter": 12,
        "verse": 7
      },
      {
        "text": "And after him Ibzan of Beth-lehem judged Israel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 12:8",
        "book": "Judges",
        "chapter": 12,
        "verse": 8
      },
      {
