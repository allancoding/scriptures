        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezra 3:3",
        "book": "Ezra",
        "chapter": 3,
        "verse": 3
      },
      {
        "text": "They kept also the feast of tabernacles, as it is written, and offered the daily burnt offerings by number, according to the custom, as the duty of every day required;",
        "footNotes": [
          {
            "start": 19,
            "end": 39,
            "text": "Lev. 23:34; Zech. 14:16."
          }
        ],
        "italics": [
          {
