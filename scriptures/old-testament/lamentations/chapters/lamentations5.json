        "footNotes": [],
        "italics": [
          {
            "start": 40,
            "end": 43
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 5:20",
        "book": "Lamentations",
        "chapter": 5,
        "verse": 20
      },
