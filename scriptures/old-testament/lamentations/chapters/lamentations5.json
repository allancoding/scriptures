        "jstReferences": [],
        "reference": "Lamentations 5:5",
        "book": "Lamentations",
        "chapter": 5,
        "verse": 5
      },
      {
        "text": "We have given the hand to the Egyptians, and to the Assyrians, to be satisfied with bread.",
        "footNotes": [],
        "italics": [
          {
            "start": 23,
            "end": 25
          },
          {
            "start": 41,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 5:6",
        "book": "Lamentations",
        "chapter": 5,
        "verse": 6
      },
      {
