          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 5:3",
        "book": "Lamentations",
        "chapter": 5,
        "verse": 3
      },
      {
        "text": "We have drunken our water for money; our wood is sold unto us.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 5:4",
        "book": "Lamentations",
        "chapter": 5,
        "verse": 4
      },
      {
