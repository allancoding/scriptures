                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Kings 20:10",
        "book": "1 Kings",
        "chapter": 20,
        "verse": 10
      },
      {
        "text": "And the king of Israel answered and said, Tell him, Let not him that girdeth on his harness boast himself as he that putteth it off.",
        "footNotes": [
          {
            "start": 84,
            "end": 91,
            "text": "OR armor."
          },
          {
            "start": 92,
            "end": 97,
