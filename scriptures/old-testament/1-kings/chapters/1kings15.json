          }
        ],
        "jstReferences": [],
        "reference": "1 Kings 15:24",
        "book": "1 Kings",
        "chapter": 15,
        "verse": 24
      },
      {
        "text": "And Nadab the son of Jeroboam began to reign over Israel in the second year of Asa king of Judah, and reigned over Israel two years.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Kings 15:25",
        "book": "1 Kings",
        "chapter": 15,
        "verse": 25
      },
      {
        "text": "And he did evil in the sight of the Lord, and walked in the way of his father, and in his sin wherewith he made Israel to sin.",
        "footNotes": [
          {
            "start": 11,
            "end": 15,
            "text": "TG Unrighteous Dominion."
          },
          {
            "start": 90,
            "end": 93,
