        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 38:2",
        "book": "Ezekiel",
        "chapter": 38,
        "verse": 2
      },
      {
