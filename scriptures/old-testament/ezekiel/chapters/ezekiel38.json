        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 38:1",
        "book": "Ezekiel",
        "chapter": 38,
        "verse": 1
      },
      {
