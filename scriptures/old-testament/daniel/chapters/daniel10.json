        "reference": "Daniel 10:14",
        "book": "Daniel",
        "chapter": 10,
        "verse": 14
      },
      {
        "text": "And when he had spoken such words unto me, I set my face toward the ground, and I became dumb.",
        "footNotes": [
          {
            "start": 89,
            "end": 93,
            "text": "Luke 1:20 (20–22); Mosiah 27:19."
          }
        ],
        "italics": [],
