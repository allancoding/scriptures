      {
        "text": "But the angel of the Lord stood in a path of the vineyards, a wall being on this side, and a wall on that side.",
        "footNotes": [],
        "italics": [
          {
            "start": 67,
            "end": 72
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 22:24",
        "book": "Numbers",
        "chapter": 22,
        "verse": 24
      },
      {
        "text": "And when the ass saw the angel of the Lord, she thrust herself unto the wall, and crushed Balaam’s foot against the wall: and he smote her again.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 22:25",
        "book": "Numbers",
        "chapter": 22,
        "verse": 25
      },
