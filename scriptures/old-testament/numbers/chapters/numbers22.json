        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 37,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 22:37",
        "book": "Numbers",
        "chapter": 22,
        "verse": 37
      },
