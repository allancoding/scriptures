        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 34,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 22:34",
        "book": "Numbers",
        "chapter": 22,
        "verse": 34
      },
