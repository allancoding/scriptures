        "book": "Numbers",
        "chapter": 22,
        "verse": 27
      },
      {
        "text": "And the Lord opened the mouth of the ass, and she said unto Balaam, What have I done unto thee, that thou hast smitten me these three times?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 28,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 22:28",
        "book": "Numbers",
        "chapter": 22,
        "verse": 28
      },
