                      }
                    ]
                  }
                ]
              },
              {
                "type": "scripture",
                "book": "luke",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 23,
                        "end": 23
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Numbers 4:3",
        "book": "Numbers",
        "chapter": 4,
        "verse": 3
      },
      {
        "text": "This shall be the service of the sons of Kohath in the tabernacle of the congregation, about the most holy things:",
        "footNotes": [
          {
            "start": 18,
            "end": 25,
            "text": "TG Stewardship."
          },
          {
            "start": 41,
            "end": 47,
            "text": "Ex. 6:16 (16, 18); Num. 3:17."
          }
        ],
        "italics": [
          {
            "start": 5,
            "end": 13
          },
          {
            "start": 87,
            "end": 92
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG Stewardship.",
            "prettyString": "TG Stewardship",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Stewardship",
                "entryId": "tg-stewardship",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Numbers 4:4",
        "book": "Numbers",
        "chapter": 4,
        "verse": 4
      },
      {
        "text": "And when the camp setteth forward, Aaron shall come, and his sons, and they shall take down the covering veil, and cover the ark of testimony with it:",
        "footNotes": [
          {
            "start": 125,
            "end": 128,
            "text": "Ex. 25:10 (10–22)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:5",
        "book": "Numbers",
        "chapter": 4,
        "verse": 5
      },
      {
        "text": "And shall put thereon the covering of badgers’ skins, and shall spread over it a cloth wholly of blue, and shall put in the staves thereof.",
        "footNotes": [],
        "italics": [
          {
            "start": 76,
            "end": 78
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:6",
        "book": "Numbers",
        "chapter": 4,
        "verse": 6
      },
      {
        "text": "And upon the table of shewbread they shall spread a cloth of blue, and put thereon the dishes, and the spoons, and the bowls, and covers to cover withal: and the continual bread shall be thereon:",
        "footNotes": [
          {
            "start": 22,
            "end": 31,
            "text": "OR the bread of the presence. TG Bread, Shewbread."
          },
          {
            "start": 87,
            "end": 93,
            "text": "Ex. 25:29."
          },
          {
            "start": 130,
            "end": 152,
            "text": "HEB jars for pouring (drink offering)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Ex. 25:29.",
            "prettyString": "Exodus 25:29",
            "references": [
              {
                "type": "scripture",
                "book": "exodus",
                "chapters": [
                  {
                    "start": 25,
                    "end": 25,
                    "verses": [
                      {
                        "start": 29,
                        "end": 29
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Numbers 4:7",
        "book": "Numbers",
        "chapter": 4,
        "verse": 7
      },
      {
        "text": "And they shall spread upon them a cloth of scarlet, and cover the same with a covering of badgers’ skins, and shall put in the staves thereof.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:8",
        "book": "Numbers",
        "chapter": 4,
        "verse": 8
      },
      {
        "text": "And they shall take a cloth of blue, and cover the candlestick of the light, and his lamps, and his tongs, and his snuffdishes, and all the oil vessels thereof, wherewith they minister unto it:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:9",
        "book": "Numbers",
        "chapter": 4,
        "verse": 9
      },
      {
        "text": "And they shall put it and all the vessels thereof within a covering of badgers’ skins, and shall put it upon a bar.",
        "footNotes": [
          {
            "start": 111,
            "end": 114,
            "text": "OR yoke, or carrying frame (also v. 12)."
          }
        ],
        "italics": [
          {
            "start": 101,
            "end": 103
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:10",
        "book": "Numbers",
        "chapter": 4,
        "verse": 10
      },
      {
        "text": "And upon the golden altar they shall spread a cloth of blue, and cover it with a covering of badgers’ skins, and shall put to the staves thereof:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:11",
        "book": "Numbers",
        "chapter": 4,
        "verse": 11
      },
      {
        "text": "And they shall take all the instruments of ministry, wherewith they minister in the sanctuary, and put them in a cloth of blue, and cover them with a covering of badgers’ skins, and shall put them on a bar:",
        "footNotes": [],
        "italics": [
          {
            "start": 103,
            "end": 107
          },
          {
            "start": 192,
            "end": 196
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:12",
        "book": "Numbers",
        "chapter": 4,
        "verse": 12
      },
      {
        "text": "And they shall take away the ashes from the altar, and spread a purple cloth thereon:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:13",
        "book": "Numbers",
        "chapter": 4,
        "verse": 13
      },
      {
        "text": "And they shall put upon it all the vessels thereof, wherewith they minister about it, even the censers, the fleshhooks, and the shovels, and the basins, all the vessels of the altar; and they shall spread upon it a covering of badgers’ skins, and put to the staves of it.",
        "footNotes": [],
        "italics": [
          {
            "start": 86,
            "end": 90
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 4:14",
        "book": "Numbers",
        "chapter": 4,
        "verse": 14
      },
      {
        "text": "And when Aaron and his sons have made an end of covering the sanctuary, and all the vessels of the sanctuary, as the camp is to set forward; after that, the sons of Kohath shall come to bear it: but they shall not touch any holy thing, lest they die. These things are the burden of the sons of Kohath in the tabernacle of the congregation.",
        "footNotes": [
          {
            "start": 165,
            "end": 171,
            "text": "1 Kgs. 8:3."
          },
          {
            "start": 186,
            "end": 190,
            "text": "Deut. 10:8; 1 Chr. 15:2."
          },
          {
            "start": 214,
            "end": 219,
            "text": "1 Chr. 13:10."
          },
          {
            "start": 220,
            "end": 223,
            "text": "IE of the sanctuary (more particularly the ark)."
          },
          {
            "start": 224,
            "end": 228,
            "text": "Num. 18:3 (2–3)."
          }
        ],
        "italics": [
          {
            "start": 191,
            "end": 194
          },
          {
            "start": 220,
            "end": 223
          },
          {
            "start": 257,
