        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 5:2",
        "book": "2 Kings",
        "chapter": 5,
        "verse": 2
      },
      {
        "text": "And she said unto her mistress, Would God my lord were with the prophet that is in Samaria! for he would recover him of his leprosy.",
        "footNotes": [],
        "italics": [
          {
            "start": 50,
            "end": 54
          },
          {
            "start": 77,
            "end": 79
          }
        ],
