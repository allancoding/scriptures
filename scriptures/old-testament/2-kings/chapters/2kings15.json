  "chapter": {
    "bookTitle": "2 Kings",
    "delineation": "Chapter",
    "number": 15,
    "summary": "Many kings reign in Israel and in Judah—Their wickedness, wars, conspiracies, and evils are described—Much of Israel is carried captive to Assyria by Tiglath-pileser.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "In the twenty and seventh year of Jeroboam king of Israel began Azariah son of Amaziah king of Judah to reign.",
        "footNotes": [],
