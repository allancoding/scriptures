            "end": 119,
            "text": "1 Chr. 5:17 (10–17)."
          }
        ],
        "italics": [
          {
            "start": 135,
            "end": 138
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
