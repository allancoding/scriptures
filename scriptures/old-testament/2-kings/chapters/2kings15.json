        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 15:8",
        "book": "2 Kings",
        "chapter": 15,
        "verse": 8
      },
      {
