        "book": "Psalms",
        "chapter": 41,
        "verse": 9
      },
      {
        "text": "But thou, O Lord, be merciful unto me, and raise me up, that I may requite them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 41:10",
        "book": "Psalms",
        "chapter": 41,
        "verse": 10
      },
      {
        "text": "By this I know that thou favourest me, because mine enemy doth not triumph over me.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 41:11",
        "book": "Psalms",
        "chapter": 41,
        "verse": 11
      },
      {
