        "book": "Psalms",
        "chapter": 41,
        "verse": 3
      },
      {
        "text": "I said, Lord, be merciful unto me: heal my soul; for I have sinned against thee.",
        "footNotes": [
          {
            "start": 35,
            "end": 39,
            "text": "Mosiah 4:10 (10–11); D&C 61:2."
          }
