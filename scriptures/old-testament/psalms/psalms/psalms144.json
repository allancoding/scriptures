        ],
        "jstReferences": [],
        "reference": "Psalms 144:4",
        "book": "Psalms",
        "chapter": 144,
        "verse": 4
      },
      {
        "text": "Bow thy heavens, O Lord, and come down: touch the mountains, and they shall smoke.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:5",
        "book": "Psalms",
        "chapter": 144,
        "verse": 5
      },
      {
        "text": "Cast forth lightning, and scatter them: shoot out thine arrows, and destroy them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:6",
        "book": "Psalms",
        "chapter": 144,
        "verse": 6
      },
      {
        "text": "Send thine hand from above; rid me, and deliver me out of great waters, from the hand of strange children;",
        "footNotes": [
          {
            "start": 89,
            "end": 96,
            "text": "HEB alien."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:7",
        "book": "Psalms",
        "chapter": 144,
        "verse": 7
      },
      {
        "text": "Whose mouth speaketh vanity, and their right hand is a right hand of falsehood.",
        "footNotes": [
          {
            "start": 69,
            "end": 78,
            "text": "Isa. 44:20."
          }
        ],
        "italics": [
          {
            "start": 50,
            "end": 52
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [
          {
            "raw": "Isa. 44:20.",
            "prettyString": "Isaiah 44:20",
            "references": [
              {
                "type": "scripture",
