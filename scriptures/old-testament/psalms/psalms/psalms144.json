    "number": 144,
    "summary": "David blesses the Lord for deliverance and temporal prosperity—Happy is that people whose God is the Lord.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Blessed be the Lord my strength, which teacheth my hands to war, and my fingers to fight:",
        "footNotes": [
          {
            "start": 60,
            "end": 63,
            "text": "2 Sam. 22:35 (32–36)."
          }
        ],
        "italics": [
          {
