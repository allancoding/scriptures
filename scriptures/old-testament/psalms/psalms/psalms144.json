                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 144:8",
        "book": "Psalms",
        "chapter": 144,
        "verse": 8
      },
      {
        "text": "I will sing a new song unto thee, O God: upon a psaltery and an instrument of ten strings will I sing praises unto thee.",
        "footNotes": [
          {
            "start": 7,
            "end": 11,
            "text": "TG Singing."
          }
        ],
        "italics": [
          {
            "start": 57,
            "end": 60
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "TG Singing.",
            "prettyString": "TG Singing",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Singing",
                "entryId": "tg-singing",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 144:9",
        "book": "Psalms",
        "chapter": 144,
        "verse": 9
      },
      {
        "text": "It is he that giveth salvation unto kings: who delivereth David his servant from the hurtful sword.",
        "footNotes": [
          {
            "start": 21,
            "end": 30,
            "text": "OR victory."
          }
        ],
        "italics": [
          {
            "start": 0,
            "end": 8
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:10",
        "book": "Psalms",
        "chapter": 144,
        "verse": 10
      },
      {
        "text": "Rid me, and deliver me from the hand of strange children, whose mouth speaketh vanity, and their right hand is a right hand of falsehood:",
        "footNotes": [
          {
            "start": 79,
            "end": 85,
            "text": "TG Vanity."
          }
        ],
        "italics": [
          {
            "start": 108,
            "end": 110
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "TG Vanity.",
            "prettyString": "TG Vanity",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Vanity",
                "entryId": "tg-vanity",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 144:11",
        "book": "Psalms",
        "chapter": 144,
        "verse": 11
      },
      {
        "text": "That our sons may be as plants grown up in their youth; that our daughters may be as corner stones, polished after the similitude of a palace:",
        "footNotes": [],
        "italics": [
          {
            "start": 14,
            "end": 20
          },
          {
            "start": 56,
            "end": 60
          },
          {
            "start": 75,
            "end": 81
          },
          {
            "start": 109,
            "end": 114
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:12",
        "book": "Psalms",
        "chapter": 144,
        "verse": 12
      },
      {
        "text": "That our garners may be full, affording all manner of store: that our sheep may bring forth thousands and ten thousands in our streets:",
        "footNotes": [],
        "italics": [
          {
            "start": 0,
            "end": 4
          },
          {
            "start": 17,
            "end": 23
          },
          {
            "start": 61,
            "end": 65
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:13",
        "book": "Psalms",
        "chapter": 144,
        "verse": 13
      },
      {
        "text": "That our oxen may be strong to labour; that there be no breaking in, nor going out; that there be no complaining in our streets.",
        "footNotes": [],
        "italics": [
          {
            "start": 0,
            "end": 4
          },
          {
            "start": 14,
            "end": 20
          },
          {
            "start": 39,
            "end": 52
          },
          {
            "start": 89,
            "end": 97
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:14",
        "book": "Psalms",
        "chapter": 144,
        "verse": 14
      },
      {
        "text": "Happy is that people, that is in such a case: yea, happy is that people, whose God is the Lord.",
        "footNotes": [
          {
