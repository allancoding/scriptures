            "end": 10
          },
          {
            "start": 65,
            "end": 68
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:1",
        "book": "Psalms",
        "chapter": 144,
        "verse": 1
      },
      {
        "text": "My goodness, and my fortress; my high tower, and my deliverer; my shield, and he in whom I trust; who subdueth my people under me.",
        "footNotes": [],
        "italics": [
          {
            "start": 78,
            "end": 80
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:2",
        "book": "Psalms",
        "chapter": 144,
        "verse": 2
      },
      {
        "text": "Lord, what is man, that thou takest knowledge of him! or the son of man, that thou makest account of him!",
        "footNotes": [
          {
            "start": 14,
            "end": 17,
            "text": "Job 7:17 (17–18); Ps. 8:4 (1–9)."
          }
        ],
        "italics": [
          {
            "start": 11,
            "end": 13
          },
          {
            "start": 54,
            "end": 56
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 144:3",
        "book": "Psalms",
        "chapter": 144,
        "verse": 3
      },
      {
        "text": "Man is like to vanity: his days are as a shadow that passeth away.",
        "footNotes": [
          {
            "start": 15,
            "end": 21,
            "text": "TG Vanity."
          },
          {
            "start": 41,
            "end": 47,
            "text": "1 Chr. 29:15; Ps. 102:11; Jacob 7:26."
          }
        ],
        "italics": [
          {
            "start": 32,
            "end": 35
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
