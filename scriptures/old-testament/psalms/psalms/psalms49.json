        "italics": [
          {
            "start": 47,
            "end": 50
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 49:18",
        "book": "Psalms",
        "chapter": 49,
        "verse": 18
      },
      {
