            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 49:4",
        "book": "Psalms",
        "chapter": 49,
        "verse": 4
      },
      {
        "text": "Wherefore should I fear in the days of evil, when the iniquity of my heels shall compass me about?",
        "footNotes": [
          {
            "start": 69,
            "end": 74,
            "text": "IE persecutors."
          }
