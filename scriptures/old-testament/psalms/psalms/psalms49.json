        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 49:5",
        "book": "Psalms",
        "chapter": 49,
        "verse": 5
      },
      {
        "text": "They that trust in their wealth, and boast themselves in the multitude of their riches;",
        "footNotes": [
          {
            "start": 25,
            "end": 31,
            "text": "TG Treasure."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
