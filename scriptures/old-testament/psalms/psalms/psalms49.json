        "reference": "Psalms 49:2",
        "book": "Psalms",
        "chapter": 49,
        "verse": 2
      },
      {
        "text": "My mouth shall speak of wisdom; and the meditation of my heart shall be of understanding.",
        "footNotes": [],
        "italics": [
          {
            "start": 63,
            "end": 71
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 49:3",
        "book": "Psalms",
        "chapter": 49,
        "verse": 3
      },
      {
        "text": "I will incline mine ear to a parable: I will open my dark saying upon the harp.",
        "footNotes": [
          {
            "start": 45,
            "end": 49,
            "text": "TG Problem-Solving."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
