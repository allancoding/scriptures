            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Treasure",
                "entryId": "tg-treasure",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 135:4",
        "book": "Psalms",
        "chapter": 135,
        "verse": 4
      },
      {
        "text": "For I know that the Lord is great, and that our Lord is above all gods.",
        "footNotes": [],
        "italics": [
          {
            "start": 25,
            "end": 27
          },
          {
            "start": 39,
            "end": 43
          },
          {
            "start": 53,
            "end": 55
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:5",
        "book": "Psalms",
        "chapter": 135,
        "verse": 5
      },
      {
        "text": "Whatsoever the Lord pleased, that did he in heaven, and in earth, in the seas, and all deep places.",
        "footNotes": [],
        "italics": [
          {
            "start": 29,
            "end": 33
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:6",
        "book": "Psalms",
        "chapter": 135,
        "verse": 6
      },
      {
        "text": "He causeth the vapours to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries.",
        "footNotes": [
          {
            "start": 15,
            "end": 32,
            "text": "IE clouds to ascend."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:7",
        "book": "Psalms",
        "chapter": 135,
        "verse": 7
      },
      {
        "text": "Who smote the firstborn of Egypt, both of man and beast.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:8",
        "book": "Psalms",
        "chapter": 135,
        "verse": 8
      },
      {
