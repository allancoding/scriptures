        "footNotes": [],
        "italics": [
          {
            "start": 0,
            "end": 3
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:9",
        "book": "Psalms",
        "chapter": 135,
        "verse": 9
      },
      {
        "text": "Who smote great nations, and slew mighty kings;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:10",
        "book": "Psalms",
        "chapter": 135,
        "verse": 10
      },
      {
        "text": "Sihon king of the Amorites, and Og king of Bashan, and all the kingdoms of Canaan:",
        "footNotes": [
          {
            "start": 0,
            "end": 5,
            "text": "Num. 21:24 (21–26); Ps. 136:19."
          },
          {
            "start": 32,
            "end": 34,
            "text": "Num. 21:35 (33–35); Ps. 136:20."
          },
          {
            "start": 63,
            "end": 71,
            "text": "Josh. 12:7 (7–24)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:11",
        "book": "Psalms",
        "chapter": 135,
        "verse": 11
