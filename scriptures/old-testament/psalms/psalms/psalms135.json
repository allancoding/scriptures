      {
        "text": "They have mouths, but they speak not; eyes have they, but they see not;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:16",
        "book": "Psalms",
        "chapter": 135,
        "verse": 16
      },
      {
        "text": "They have ears, but they hear not; neither is there any breath in their mouths.",
        "footNotes": [],
        "italics": [
          {
            "start": 52,
            "end": 55
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:17",
        "book": "Psalms",
        "chapter": 135,
        "verse": 17
      },
