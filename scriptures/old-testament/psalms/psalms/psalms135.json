  "chapter": {
    "bookTitle": "Psalms",
    "delineation": "Psalm",
    "number": 135,
    "summary": "Praise and bless the Lord—Our Lord is above all gods; idols cannot see, hear, or speak.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Praise ye the Lord. Praise ye the name of the Lord; praise him, O ye servants of the Lord.",
        "footNotes": [],
        "italics": [
          {
            "start": 59,
            "end": 63
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:1",
        "book": "Psalms",
        "chapter": 135,
        "verse": 1
      },
      {
        "text": "Ye that stand in the house of the Lord, in the courts of the house of our God,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:2",
        "book": "Psalms",
        "chapter": 135,
        "verse": 2
      },
      {
        "text": "Praise the Lord; for the Lord is good: sing praises unto his name; for it is pleasant.",
        "footNotes": [],
        "italics": [
          {
            "start": 30,
            "end": 32
          },
          {
            "start": 71,
            "end": 76
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 135:3",
        "book": "Psalms",
        "chapter": 135,
        "verse": 3
      },
      {
        "text": "For the Lord hath chosen Jacob unto himself, and Israel for his peculiar treasure.",
        "footNotes": [
          {
            "start": 25,
            "end": 30,
            "text": "Gen. 32:28 (24–32); 3 Ne. 5:21 (21–26); D&C 49:24 (23–25); 52:2 (1–3)."
          },
          {
            "start": 64,
            "end": 72,
            "text": "TG Peculiar People."
          },
          {
            "start": 73,
            "end": 81,
            "text": "TG Treasure."
          }
        ],
        "italics": [
          {
            "start": 45,
            "end": 48
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
