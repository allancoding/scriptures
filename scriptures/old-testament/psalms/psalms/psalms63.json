      {
        "text": "Because thou hast been my help, therefore in the shadow of thy wings will I rejoice.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 63:7",
        "book": "Psalms",
        "chapter": 63,
        "verse": 7
      },
      {
