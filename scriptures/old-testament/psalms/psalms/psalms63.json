        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 63:8",
        "book": "Psalms",
        "chapter": 63,
        "verse": 8
      },
      {
