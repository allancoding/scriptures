          }
        ],
        "italics": [
          {
            "start": 25,
            "end": 28
          },
          {
            "start": 39,
            "end": 41
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "TG Family.",
            "prettyString": "TG Family",
            "references": [
              {
                "type": "studyHelp",
