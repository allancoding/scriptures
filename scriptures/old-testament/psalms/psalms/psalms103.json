        "reference": "Psalms 103:9",
        "book": "Psalms",
        "chapter": 103,
        "verse": 9
      },
      {
        "text": "He hath not dealt with us after our sins; nor rewarded us according to our iniquities.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 103:10",
        "book": "Psalms",
        "chapter": 103,
        "verse": 10
      },
      {
        "text": "For as the heaven is high above the earth, so great is his mercy toward them that fear him.",
        "footNotes": [],
        "italics": [
          {
            "start": 43,
            "end": 45
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 103:11",
        "book": "Psalms",
        "chapter": 103,
        "verse": 11
      },
      {
        "text": "As far as the east is from the west, so far hath he removed our transgressions from us.",
        "footNotes": [],
        "italics": [
          {
            "start": 37,
            "end": 39
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 103:12",
        "book": "Psalms",
        "chapter": 103,
        "verse": 12
      },
