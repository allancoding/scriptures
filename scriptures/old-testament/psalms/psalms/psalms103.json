        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 103:19",
        "book": "Psalms",
        "chapter": 103,
        "verse": 19
      },
