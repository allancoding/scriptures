        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 103:16",
        "book": "Psalms",
        "chapter": 103,
        "verse": 16
      },
