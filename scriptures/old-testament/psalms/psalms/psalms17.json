          {
            "start": 0,
            "end": 4,
            "text": "Ps. 119:133."
          }
        ],
        "italics": [
          {
            "start": 32,
            "end": 36
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
