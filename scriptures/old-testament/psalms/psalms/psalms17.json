        "book": "Psalms",
        "chapter": 17,
        "verse": 3
      },
      {
        "text": "Concerning the works of men, by the word of thy lips I have kept me from the paths of the destroyer.",
        "footNotes": [],
        "italics": [
          {
            "start": 65,
            "end": 72
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 17:4",
        "book": "Psalms",
        "chapter": 17,
        "verse": 4
      },
      {
