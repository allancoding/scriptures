        "book": "Psalms",
        "chapter": 140,
        "verse": 3
      },
      {
        "text": "Keep me, O Lord, from the hands of the wicked; preserve me from the violent man; who have purposed to overthrow my goings.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 140:4",
        "book": "Psalms",
        "chapter": 140,
        "verse": 4
      },
      {
