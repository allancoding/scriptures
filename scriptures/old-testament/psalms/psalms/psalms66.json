        "footNotes": [
          {
            "start": 22,
            "end": 28,
            "text": "TG Test."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "TG Test.",
            "prettyString": "TG Test",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Test",
                "entryId": "tg-test",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 66:10",
        "book": "Psalms",
        "chapter": 66,
        "verse": 10
      },
      {
        "text": "Thou broughtest us into the net; thou laidst affliction upon our loins.",
        "footNotes": [
          {
            "start": 45,
            "end": 55,
            "text": "Lev. 26:21 (14–33); Deut. 9:8 (7–29)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 66:11",
        "book": "Psalms",
        "chapter": 66,
        "verse": 11
      },
      {
        "text": "Thou hast caused men to ride over our heads; we went through fire and through water: but thou broughtest us out into a wealthy place.",
        "footNotes": [
          {
            "start": 78,
            "end": 83,
            "text": "Isa. 43:2."
          },
          {
            "start": 94,
            "end": 104,
            "text": "Lev. 26:6 (3–13)."
          },
          {
            "start": 119,
            "end": 126,
