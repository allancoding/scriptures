  "chapter": {
    "bookTitle": "Psalms",
    "delineation": "Psalm",
    "number": 83,
    "summary": "God is asked to confound the enemies of His people—Jehovah is the Most High over all the earth.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Keep not thou silence, O God: hold not thy peace, and be not still, O God.",
        "footNotes": [
          {
            "start": 14,
            "end": 21,
            "text": "Ps. 28:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
