                        "end": 15
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 83:9",
        "book": "Psalms",
        "chapter": 83,
        "verse": 9
      },
      {
        "text": "Which perished at En-dor: they became as dung for the earth.",
        "footNotes": [],
        "italics": [
          {
            "start": 0,
            "end": 5
          },
          {
            "start": 38,
            "end": 40
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:10",
        "book": "Psalms",
        "chapter": 83,
        "verse": 10
      },
      {
        "text": "Make their nobles like Oreb, and like Zeeb: yea, all their princes as Zebah, and as Zalmunna:",
        "footNotes": [
          {
            "start": 70,
            "end": 75,
            "text": "Judg. 8:5."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "Judg. 8:5.",
            "prettyString": "Judges 8:5",
            "references": [
              {
                "type": "scripture",
                "book": "judges",
                "chapters": [
                  {
                    "start": 8,
                    "end": 8,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 83:11",
        "book": "Psalms",
        "chapter": 83,
        "verse": 11
      },
      {
        "text": "Who said, Let us take to ourselves the houses of God in possession.",
        "footNotes": [
          {
            "start": 39,
            "end": 45,
            "text": "HEB pastures; i.e., the land of Israel."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:12",
        "book": "Psalms",
        "chapter": 83,
        "verse": 12
      },
      {
        "text": "O my God, make them like a wheel; as the stubble before the wind.",
        "footNotes": [
          {
            "start": 27,
            "end": 32,
            "text": "Isa. 17:13."
          },
          {
            "start": 41,
            "end": 48,
            "text": "Ps. 1:4."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "Isa. 17:13.",
            "prettyString": "Isaiah 17:13",
            "references": [
              {
