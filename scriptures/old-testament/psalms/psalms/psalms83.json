        ],
        "jstReferences": [],
        "reference": "Psalms 83:13",
        "book": "Psalms",
        "chapter": 83,
        "verse": 13
      },
      {
        "text": "As the fire burneth a wood, and as the flame setteth the mountains on fire;",
        "footNotes": [
          {
            "start": 22,
            "end": 26,
            "text": "HEB forest."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:14",
        "book": "Psalms",
        "chapter": 83,
        "verse": 14
      },
      {
        "text": "So persecute them with thy tempest, and make them afraid with thy storm.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:15",
        "book": "Psalms",
        "chapter": 83,
        "verse": 15
      },
      {
        "text": "Fill their faces with shame; that they may seek thy name, O Lord.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:16",
        "book": "Psalms",
        "chapter": 83,
        "verse": 16
      },
      {
        "text": "Let them be confounded and troubled for ever; yea, let them be put to shame, and perish:",
        "footNotes": [
          {
            "start": 81,
            "end": 87,
            "text": "2 Ne. 25:14; D&C 71:7; Moses 7:15 (14–16)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 83:17",
        "book": "Psalms",
        "chapter": 83,
        "verse": 17
      },
      {
