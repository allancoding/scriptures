                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 35:13",
        "book": "Psalms",
        "chapter": 35,
        "verse": 13
      },
      {
        "text": "I behaved myself as though he had been my friend or brother: I bowed down heavily, as one that mourneth for his mother.",
        "footNotes": [
          {
            "start": 52,
            "end": 59,
            "text": "TG Brotherhood and Sisterhood."
          }
        ],
        "italics": [
          {
            "start": 27,
            "end": 38
          },
          {
            "start": 49,
            "end": 51
          },
          {
            "start": 104,
            "end": 111
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "TG Brotherhood and Sisterhood.",
            "prettyString": "TG Brotherhood and Sisterhood",
            "references": [
              {
                "type": "studyHelp",
