          },
          {
            "raw": "TG Salvation.",
            "prettyString": "TG Salvation",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Salvation",
                "entryId": "tg-salvation",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 35:9",
        "book": "Psalms",
        "chapter": 35,
        "verse": 9
      },
      {
        "text": "All my bones shall say, Lord, who is like unto thee, which deliverest the poor from him that is too strong for him, yea, the poor and the needy from him that spoileth him?",
        "footNotes": [
          {
            "start": 59,
            "end": 69,
            "text": "Prov. 22:23."
          },
          {
            "start": 74,
            "end": 78,
            "text": "Isa. 25:4; D&C 56:18 (18–19)."
          }
        ],
        "italics": [
          {
            "start": 34,
            "end": 36
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "Prov. 22:23.",
            "prettyString": "Proverbs 22:23",
            "references": [
              {
                "type": "scripture",
