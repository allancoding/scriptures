        "footNotes": [
          {
            "start": 5,
            "end": 13,
            "text": "Ps. 38:20."
          }
        ],
        "italics": [
          {
            "start": 31,
            "end": 33
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "Ps. 38:20.",
            "prettyString": "Psalms 38:20",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 38,
                    "end": 38,
                    "verses": [
