                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 35:10",
        "book": "Psalms",
        "chapter": 35,
        "verse": 10
      },
      {
        "text": "False witnesses did rise up; they laid to my charge things that I knew not.",
        "footNotes": [
          {
            "start": 0,
            "end": 5,
            "text": "TG Slander."
          }
        ],
        "italics": [
          {
            "start": 52,
            "end": 58
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "TG Slander.",
            "prettyString": "TG Slander",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Slander",
                "entryId": "tg-slander",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 35:11",
        "book": "Psalms",
        "chapter": 35,
        "verse": 11
      },
      {
