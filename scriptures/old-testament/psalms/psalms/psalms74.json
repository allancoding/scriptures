        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 74:6",
        "book": "Psalms",
        "chapter": 74,
        "verse": 6
      },
