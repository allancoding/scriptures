            "end": 46
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 74:1",
        "book": "Psalms",
        "chapter": 74,
        "verse": 1
      },
      {
