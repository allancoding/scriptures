          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 42:4",
        "book": "Jeremiah",
        "chapter": 42,
        "verse": 4
      },
      {
        "text": "Then they said to Jeremiah, The Lord be a true and faithful witness between us, if we do not even according to all things for the which the Lord thy God shall send thee to us.",
        "footNotes": [
          {
            "start": 51,
            "end": 59,
            "text": "Rev. 1:5; 3:14."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "Rev. 1:5; 3:14.",
            "prettyString": "Revelation 1:5; 3:14",
            "references": [
              {
                "type": "scripture",
