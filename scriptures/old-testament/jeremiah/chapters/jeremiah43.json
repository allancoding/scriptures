          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 43:3",
        "book": "Jeremiah",
        "chapter": 43,
        "verse": 3
      },
      {
        "text": "So Johanan the son of Kareah, and all the captains of the forces, and all the people, obeyed not the voice of the Lord, to dwell in the land of Judah.",
        "footNotes": [
          {
            "start": 42,
            "end": 50,
            "text": "Jer. 40:13."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
