  "chapter": {
    "bookTitle": "Genesis",
    "delineation": "Chapter",
    "number": 38,
    "summary": "Judah has three sons by a Canaanite woman—Er and Onan are slain by the Lord—Tamar, disguised as a harlot, bears twins by Judah.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass at that time, that Judah went down from his brethren, and turned in to a certain Adullamite, whose name was Hirah.",
        "footNotes": [],
        "italics": [
          {
            "start": 124,
            "end": 127
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 38:1",
        "book": "Genesis",
        "chapter": 38,
        "verse": 1
      },
      {
        "text": "And Judah saw there a daughter of a certain Canaanite, whose name was Shuah; and he took her, and went in unto her.",
        "footNotes": [
          {
            "start": 22,
            "end": 30,
            "text": "TG Marriage, Interfaith."
          }
        ],
        "italics": [
          {
            "start": 66,
            "end": 69
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "TG Marriage, Interfaith.",
            "prettyString": "TG Marriage, Interfaith",
            "references": [
              {
                "type": "studyHelp",
