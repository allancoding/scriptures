              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Genesis 38:2",
        "book": "Genesis",
        "chapter": 38,
        "verse": 2
      },
      {
        "text": "And she conceived, and bare a son; and he called his name Er.",
        "footNotes": [
          {
            "start": 58,
            "end": 60,
            "text": "1 Chr. 2:3 (3–4)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 38:3",
        "book": "Genesis",
        "chapter": 38,
        "verse": 3
      },
      {
        "text": "And she conceived again, and bare a son; and she called his name Onan.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 38:4",
        "book": "Genesis",
        "chapter": 38,
        "verse": 4
      },
      {
        "text": "And she yet again conceived, and bare a son; and called his name Shelah: and he was at Chezib, when she bare him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 38:5",
        "book": "Genesis",
        "chapter": 38,
        "verse": 5
      },
      {
        "text": "And Judah took a wife for Er his firstborn, whose name was Tamar.",
        "footNotes": [],
        "italics": [
          {
            "start": 55,
            "end": 58
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 38:6",
        "book": "Genesis",
        "chapter": 38,
        "verse": 6
      },
      {
        "text": "And Er, Judah’s firstborn, was wicked in the sight of the Lord; and the Lord slew him.",
        "footNotes": [
          {
            "start": 4,
            "end": 6,
            "text": "Gen. 46:12."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Gen. 46:12.",
            "prettyString": "Genesis 46:12",
            "references": [
              {
                "type": "scripture",
                "book": "genesis",
                "chapters": [
                  {
