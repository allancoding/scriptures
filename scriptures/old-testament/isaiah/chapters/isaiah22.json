        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Isaiah 22:6",
        "book": "Isaiah",
        "chapter": 22,
        "verse": 6
      },
      {
