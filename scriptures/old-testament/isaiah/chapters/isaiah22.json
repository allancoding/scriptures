        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Isaiah 22:17",
        "book": "Isaiah",
        "chapter": 22,
        "verse": 17
      },
      {
