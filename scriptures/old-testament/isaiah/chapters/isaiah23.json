  "chapter": {
    "bookTitle": "Isaiah",
    "delineation": "Chapter",
    "number": 23,
    "summary": "Tyre will be overthrown.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "The burden of Tyre. Howl, ye ships of Tarshish; for it is laid waste, so that there is no house, no entering in: from the land of Chittim it is revealed to them.",
        "footNotes": [
          {
            "start": 4,
            "end": 10,
            "text": "IE a message of doom to the Phoenician city, Tyre."
          },
          {
            "start": 14,
            "end": 18,
            "text": "Ezek. 26:2 (2–3); Amos 1:9."
          },
          {
            "start": 130,
            "end": 137,
            "text": "IE Cyprus. Refugees tell of destruction."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Isaiah 23:1",
        "book": "Isaiah",
        "chapter": 23,
        "verse": 1
      },
      {
        "text": "Be still, ye inhabitants of the isle; thou whom the merchants of Zidon, that pass over the sea, have replenished.",
        "footNotes": [
          {
            "start": 3,
            "end": 8,
            "text": "HEB silent, stunned."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Isaiah 23:2",
        "book": "Isaiah",
        "chapter": 23,
        "verse": 2
      },
      {
        "text": "And by great waters the seed of Sihor, the harvest of the river, is her revenue; and she is a mart of nations.",
        "footNotes": [
          {
            "start": 24,
            "end": 28,
            "text": "IE grain from the Nile."
          },
          {
            "start": 32,
            "end": 37,
            "text": "1 Chr. 13:5."
          }
        ],
        "italics": [
          {
            "start": 65,
            "end": 67
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
