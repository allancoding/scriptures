        "jstReferences": [],
        "reference": "Leviticus 13:28",
        "book": "Leviticus",
        "chapter": 13,
        "verse": 28
      },
      {
        "text": "If a man or woman have a plague upon the head or the beard;",
        "footNotes": [],
