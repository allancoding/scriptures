        "book": "Leviticus",
        "chapter": 13,
        "verse": 15
      },
      {
        "text": "Or if the raw flesh turn again, and be changed unto white, he shall come unto the priest;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 13:16",
        "book": "Leviticus",
        "chapter": 13,
        "verse": 16
      },
      {
