        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 13:22",
        "book": "Leviticus",
        "chapter": 13,
        "verse": 22
      },
      {
        "text": "But if the bright spot stay in his place, and spread not, it is a burning boil; and the priest shall pronounce him clean.",
        "footNotes": [],
        "italics": [
          {
            "start": 42,
            "end": 45
