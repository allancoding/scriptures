    "summary": "Laws and tokens are revealed for discerning and controlling leprosy—Leprous garments are to be burnt.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And the Lord spake unto Moses and Aaron, saying,",
        "footNotes": [],
        "italics": [],
