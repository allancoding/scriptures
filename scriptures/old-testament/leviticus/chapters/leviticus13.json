        "jstReferences": [],
        "reference": "Leviticus 13:7",
        "book": "Leviticus",
        "chapter": 13,
        "verse": 7
      },
      {
        "text": "And if the priest see that, behold, the scab spreadeth in the skin, then the priest shall pronounce him unclean: it is a leprosy.",
        "footNotes": [],
        "italics": [
          {
            "start": 4,
            "end": 6
