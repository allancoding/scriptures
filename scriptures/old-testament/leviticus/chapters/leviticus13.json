        ],
        "associatedContent": [],
        "verseNumber": 50,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 13:50",
        "book": "Leviticus",
        "chapter": 13,
        "verse": 50
      },
      {
        "text": "And he shall look on the plague on the seventh day: if the plague be spread in the garment, either in the warp, or in the woof, or in a skin, or in any work that is made of skin; the plague is a fretting leprosy; it is unclean.",
        "footNotes": [
          {
            "start": 195,
            "end": 211,
