                    "verses": [
                      {
                        "start": 10,
                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ecclesiastes 10:7",
        "book": "Ecclesiastes",
        "chapter": 10,
        "verse": 7
      },
      {
        "text": "He that diggeth a pit shall fall into it; and whoso breaketh an hedge, a serpent shall bite him.",
        "footNotes": [
          {
            "start": 28,
            "end": 32,
            "text": "Alma 30:60."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [
          {
            "raw": "Alma 30:60.",
            "prettyString": "Alma 30:60",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
