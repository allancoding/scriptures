          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ecclesiastes 10:16",
        "book": "Ecclesiastes",
        "chapter": 10,
        "verse": 16
      },
      {
        "text": "Blessed art thou, O land, when thy king is the son of nobles, and thy princes eat in due season, for strength, and not for drunkenness!",
        "footNotes": [
          {
            "start": 123,
            "end": 134,
