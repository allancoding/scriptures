            ]
          }
        ],
        "jstReferences": [],
        "reference": "Amos 7:12",
        "book": "Amos",
        "chapter": 7,
        "verse": 12
      },
      {
        "text": "But prophesy not again any more at Beth-el: for it is the king’s chapel, and it is the king’s court.",
        "footNotes": [
          {
            "start": 65,
            "end": 71,
            "text": "OR sanctuary."
          }
        ],
        "italics": [
          {
            "start": 51,
