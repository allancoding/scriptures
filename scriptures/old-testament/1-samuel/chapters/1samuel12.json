        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 12:18",
        "book": "1 Samuel",
        "chapter": 12,
        "verse": 18
      },
      {
        "text": "And all the people said unto Samuel, Pray for thy servants unto the Lord thy God, that we die not: for we have added unto all our sins this evil, to ask us a king.",
        "footNotes": [],
        "italics": [
          {
            "start": 135,
            "end": 139
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
