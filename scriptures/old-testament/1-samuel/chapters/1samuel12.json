        "footNotes": [
          {
            "start": 49,
            "end": 54,
            "text": "Ex. 2:23."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [
          {
            "raw": "Ex. 2:23.",
            "prettyString": "Exodus 2:23",
            "references": [
              {
                "type": "scripture",
                "book": "exodus",
