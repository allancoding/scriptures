        "book": "1 Samuel",
        "chapter": 12,
        "verse": 15
      },
      {
        "text": "Now therefore stand and see this great thing, which the Lord will do before your eyes.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 12:16",
        "book": "1 Samuel",
        "chapter": 12,
        "verse": 16
      },
