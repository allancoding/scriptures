            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 29:4",
        "book": "1 Samuel",
        "chapter": 29,
        "verse": 4
      },
      {
        "text": "Is not this David, of whom they sang one to another in dances, saying, Saul slew his thousands, and David his ten thousands?",
        "footNotes": [
          {
            "start": 71,
            "end": 75,
            "text": "1 Sam. 18:6."
          }
        ],
        "italics": [
          {
            "start": 0,
            "end": 2
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "1 Sam. 18:6.",
            "prettyString": "1 Samuel 18:6",
            "references": [
              {
                "type": "scripture",
                "book": "1samuel",
                "chapters": [
                  {
                    "start": 18,
                    "end": 18,
                    "verses": [
