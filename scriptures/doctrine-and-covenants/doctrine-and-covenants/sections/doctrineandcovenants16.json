        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 16:2",
        "book": "Doctrine and Covenants",
        "chapter": 16,
        "verse": 2
      },
      {
        "text": "And I will tell you that which no man knoweth save me and thee alone—",
        "footNotes": [],
