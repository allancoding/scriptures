        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 16:3",
        "book": "Doctrine and Covenants",
        "chapter": 16,
        "verse": 3
      },
      {
        "text": "For many times you have desired of me to know that which would be of the most worth unto you.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 16:4",
        "book": "Doctrine and Covenants",
        "chapter": 16,
        "verse": 4
      },
      {
        "text": "Behold, blessed are you for this thing, and for speaking my words which I have given unto you according to my commandments.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
