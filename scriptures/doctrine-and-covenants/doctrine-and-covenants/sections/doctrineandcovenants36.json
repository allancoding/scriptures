          {
            "start": 29,
            "end": 39,
            "text": "TG Jesus Christ, Jehovah."
          },
          {
            "start": 86,
            "end": 92,
            "text": "D&C 41:9 (9–11). See also Partridge, Edward, in Index."
          }
        ],
