            "end": 35,
            "text": "IE from Kirtland."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 117:2",
        "book": "Doctrine and Covenants",
        "chapter": 117,
        "verse": 2
      },
      {
