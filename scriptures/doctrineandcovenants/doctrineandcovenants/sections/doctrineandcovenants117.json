  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 117,
    "summary": "1–9, The Lord’s servants should not covet temporal things, for “what is property unto the Lord?”; 10–16, They are to forsake littleness of soul, and their sacrifices will be sacred unto the Lord.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given through Joseph Smith the Prophet, at Far West, Missouri, July 8, 1838, concerning the immediate duties of William Marks, Newel K. Whitney, and Oliver Granger."
      }
    ],
    "verses": [
      {
        "text": "Verily thus saith the Lord unto my servant William Marks, and also unto my servant Newel K. Whitney, let them settle up their business speedily and journey from the land of Kirtland, before I, the Lord, send again the snows upon the earth.",
        "footNotes": [
          {
            "start": 43,
            "end": 56,
            "text": "D&C 124:79 (79–80)."
          },
          {
            "start": 203,
            "end": 207,
            "text": "Job 37:6 (5–6); Ps. 148:8; Hel. 11:17 (13–17); Ether 2:24."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 117:1",
        "book": "Doctrine and Covenants",
        "chapter": 117,
        "verse": 1
      },
      {
        "text": "Let them awake, and arise, and come forth, and not tarry, for I, the Lord, command it.",
        "footNotes": [
          {
