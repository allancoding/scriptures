                "title": "Procrastination",
                "entryId": "tg-procrastination",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 117:3",
        "book": "Doctrine and Covenants",
        "chapter": 117,
        "verse": 3
      },
      {
        "text": "Let them repent of all their sins, and of all their covetous desires, before me, saith the Lord; for what is property unto me? saith the Lord.",
        "footNotes": [
          {
            "start": 109,
            "end": 117,
            "text": "Mark 14:4 (3–4); D&C 104:14."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 117:4",
        "book": "Doctrine and Covenants",
        "chapter": 117,
        "verse": 4
      },
      {
        "text": "Let the properties of Kirtland be turned out for debts, saith the Lord. Let them go, saith the Lord, and whatsoever remaineth, let it remain in your hands, saith the Lord.",
        "footNotes": [
          {
            "start": 49,
            "end": 54,
            "text": "D&C 90:23 (22–23)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 117:5",
        "book": "Doctrine and Covenants",
        "chapter": 117,
        "verse": 5
      },
      {
        "text": "For have I not the fowls of heaven, and also the fish of the sea, and the beasts of the mountains? Have I not made the earth? Do I not hold the destinies of all the armies of the nations of the earth?",
        "footNotes": [
          {
            "start": 110,
            "end": 114,
            "text": "TG Creation; God, Works of; Jesus Christ, Creator."
          },
          {
            "start": 144,
            "end": 153,
            "text": "Isa. 45:1 (1–3); 1 Ne. 17:37."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
