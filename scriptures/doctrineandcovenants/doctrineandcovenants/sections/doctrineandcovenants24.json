  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 24,
    "summary": "1–9, Joseph Smith is called to translate, preach, and expound scriptures; 10–12, Oliver Cowdery is called to preach the gospel; 13–19, The law is revealed relative to miracles, cursings, casting off the dust of one’s feet, and going without purse or scrip.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given to Joseph Smith the Prophet and Oliver Cowdery, at Harmony, Pennsylvania, July 1830. Though less than four months had elapsed since the Church was organized, persecution had become intense, and the leaders had to seek safety in partial seclusion. The following three revelations were given at this time to strengthen, encourage, and instruct them."
      }
    ],
    "verses": [
      {
        "text": "Behold, thou wast called and chosen to write the Book of Mormon, and to my ministry; and I have lifted thee up out of thine afflictions, and have counseled thee, that thou hast been delivered from all thine enemies, and thou hast been delivered from the powers of Satan and from darkness!",
