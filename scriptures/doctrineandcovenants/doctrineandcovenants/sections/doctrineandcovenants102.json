                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:1",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 1
      },
      {
        "text": "The high council was appointed by revelation for the purpose of settling important difficulties which might arise in the church, which could not be settled by the church or the bishop’s council to the satisfaction of the parties.",
        "footNotes": [
          {
            "start": 4,
            "end": 16,
            "text": "D&C 20:67."
          },
          {
            "start": 64,
            "end": 72,
            "text": "TG Judgment."
          },
          {
            "start": 177,
            "end": 185,
            "text": "D&C 107:73 (72–75)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "D&C 20:67.",
            "prettyString": "D&C 20:67",
            "references": [
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 20,
                    "end": 20,
                    "verses": [
                      {
                        "start": 67,
                        "end": 67
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "TG Judgment.",
            "prettyString": "TG Judgment",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Judgment",
                "entryId": "tg-judgment",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:2",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 2
      },
      {
        "text": "Joseph Smith, Jun., Sidney Rigdon and Frederick G. Williams were acknowledged presidents by the voice of the council; and Joseph Smith, Sen., John Smith, Joseph Coe, John Johnson, Martin Harris, John S. Carter, Jared Carter, Oliver Cowdery, Samuel H. Smith, Orson Hyde, Sylvester Smith, and Luke Johnson, high priests, were chosen to be a standing council for the church, by the unanimous voice of the council.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:3",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 3
      },
      {
        "text": "The above-named councilors were then asked whether they accepted their appointments, and whether they would act in that office according to the law of heaven, to which they all answered that they accepted their appointments, and would fill their offices according to the grace of God bestowed upon them.",
        "footNotes": [
          {
            "start": 144,
            "end": 147,
            "text": "TG God, Law of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG God, Law of.",
            "prettyString": "TG God, Law of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "God, Law of",
                "entryId": "tg-god-law-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:4",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 4
      },
      {
        "text": "The number composing the council, who voted in the name and for the church in appointing the above-named councilors were forty-three, as follows: nine high priests, seventeen elders, four priests, and thirteen members.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:5",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 5
      },
      {
        "text": "Voted: that the high council cannot have power to act without seven of the above-named councilors, or their regularly appointed successors are present.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:6",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 6
      },
      {
        "text": "These seven shall have power to appoint other high priests, whom they may consider worthy and capable to act in the place of absent councilors.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:7",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 7
      },
      {
        "text": "Voted: that whenever any vacancy shall occur by the death, removal from office for transgression, or removal from the bounds of this church government, of any one of the above-named councilors, it shall be filled by the nomination of the president or presidents, and sanctioned by the voice of a general council of high priests, convened for that purpose, to act in the name of the church.",
        "footNotes": [
          {
            "start": 238,
            "end": 247,
            "text": "D&C 68:15 (15, 19, 22)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 102:8",
        "book": "Doctrine and Covenants",
        "chapter": 102,
        "verse": 8
      },
      {
        "text": "The president of the church, who is also the president of the council, is appointed by revelation, and acknowledged in his administration by the voice of the church.",
        "footNotes": [
          {
            "start": 87,
            "end": 97,
            "text": "TG Called of God. See also the headings to sections 81 and 90."
          },
          {
            "start": 103,
            "end": 115,
            "text": "TG Sustaining Church Leaders."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "TG Called of God. See also the headings to sections 81 and 90.",
            "prettyString": "TG Called of God. See also the headings to sections 81 and 90",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Called of God. See also the headings to sections 81 and 90",
                "entryId": "tg-called-of-god-see-also-the-headings-to-sections-81-and-90",
                "book": "",
                "chapters": []
              }
            ]
          },
          {
            "raw": "TG Sustaining Church Leaders.",
            "prettyString": "TG Sustaining Church Leaders",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Sustaining Church Leaders",
                "entryId": "tg-sustaining-church-leaders",
