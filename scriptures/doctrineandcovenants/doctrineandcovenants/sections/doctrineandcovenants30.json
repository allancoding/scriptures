  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 30,
    "summary": "1–4, David Whitmer is chastened for failure to serve diligently; 5–8, Peter Whitmer Jr. is to accompany Oliver Cowdery on a mission to the Lamanites; 9–11, John Whitmer is called to preach the gospel.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given through Joseph Smith the Prophet to David Whitmer, Peter Whitmer Jr., and John Whitmer, at Fayette, New York, September 1830, following the three-day conference at Fayette, but before theelders of the Church had separated. Originally this material was published as three revelations; it was combined into one section by the Prophet for the 1835 edition of the Doctrine and Covenants."
      }
    ],
