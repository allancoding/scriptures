  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 9,
    "summary": "1–6, Other ancient records are yet to be translated; 7–14, The Book of Mormon is translated by study and by spiritual confirmation.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given through Joseph Smith the Prophet to Oliver Cowdery, at Harmony, Pennsylvania, April 1829. Oliver is admonished to be patient and is urged to be content to write, for the time being, at the dictation of the translator, rather than to attempt to translate."
      }
    ],
    "verses": [
      {
        "text": "Behold, I say unto you, my son, that because you did not translate according to that which you desired of me, and did commence again to write for my servant, Joseph Smith, Jun., even so I would that ye should continue until you have finished this record, which I have entrusted unto him.",
        "footNotes": [
          {
            "start": 57,
            "end": 66,
            "text": "D&C 8:11 (1, 11)."
          },
          {
            "start": 136,
            "end": 141,
            "text": "JS—H 1:67."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
            "raw": "JS—H 1:67.",
            "prettyString": "JS—H 1:67",
            "references": [
              {
                "type": "scripture",
                "book": "josephsmithhistory",
                "chapters": [
                  {
                    "start": 1,
                    "end": 1,
                    "verses": [
                      {
                        "start": 67,
