        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 9:5",
        "book": "Doctrine and Covenants",
        "chapter": 9,
        "verse": 5
      },
      {
