                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 9:1",
        "book": "Doctrine and Covenants",
        "chapter": 9,
        "verse": 1
      },
      {
        "text": "And then, behold, other records have I, that I will give unto you power that you may assist to translate.",
        "footNotes": [
          {
            "start": 18,
            "end": 23,
            "text": "An allusion to additional translation activity, i.e., the Joseph Smith Translation of the Bible and the Book of Abraham, in which Oliver Cowdery assisted as a scribe. See also BD Joseph Smith Translation."
          },
          {
            "start": 24,
            "end": 31,
            "text": "D&C 6:26; 8:1. TG Scriptures to Come Forth."
          },
          {
            "start": 95,
            "end": 104,
            "text": "D&C 6:25 (25, 28); 10:3 (3, 18, 41, 45)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 9:2",
        "book": "Doctrine and Covenants",
        "chapter": 9,
        "verse": 2
      },
      {
