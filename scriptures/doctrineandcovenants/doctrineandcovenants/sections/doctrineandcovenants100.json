      },
      {
        "text": "Therefore, continue your journey and let your hearts rejoice; for behold, and lo, I am with you even unto the end.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:12",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 12
      },
