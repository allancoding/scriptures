                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:5",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 5
      },
      {
        "text": "For it shall be given you in the very hour, yea, in the very moment, what ye shall say.",
        "footNotes": [
          {
            "start": 16,
            "end": 21,
            "text": "Matt. 10:19 (19–20); D&C 84:85."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:6",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 6
      },
      {
        "text": "But a commandment I give unto you, that ye shall declare whatsoever thing ye declare in my name, in solemnity of heart, in the spirit of meekness, in all things.",
        "footNotes": [
          {
            "start": 77,
            "end": 84,
            "text": "D&C 18:21; 43:34; 84:61; 88:121. TG Meek; Sincere."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:7",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 7
      },
      {
        "text": "And I give unto you this promise, that inasmuch as ye do this the Holy Ghost shall be shed forth in bearing record unto all things whatsoever ye shall say.",
        "footNotes": [
          {
            "start": 66,
            "end": 76,
            "text": "Rom. 10:17 (13–17); 2 Ne. 33:1 (1–4)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:8",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 8
      },
      {
        "text": "And it is expedient in me that you, my servant Sidney, should be a spokesman unto this people; yea, verily, I will ordain you unto this calling, even to be a spokesman unto my servant Joseph.",
        "footNotes": [
          {
            "start": 67,
            "end": 76,
            "text": "Ex. 4:16 (14–16); 2 Ne. 3:17 (17–18); D&C 124:104."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 100:9",
        "book": "Doctrine and Covenants",
        "chapter": 100,
        "verse": 9
      },
      {
