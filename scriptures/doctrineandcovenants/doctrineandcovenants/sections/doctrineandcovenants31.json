  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 31,
    "summary": "1–6, Thomas B. Marsh is called to preach the gospel and is assured of his family’s well-being; 7–13, He is counseled to be patient, pray always, and follow the Comforter.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given through Joseph Smith the Prophet to Thomas B. Marsh, September 1830. The occasion was immediately following a conference of the Church (see theheading to section 30). Thomas B. Marsh had been baptized earlier in the month and had been ordained an elder in the Church before this revelation was given."
      }
    ],
    "verses": [
      {
        "text": "Thomas, my son, blessed are you because of your faith in my work.",
        "footNotes": [
          {
            "start": 0,
            "end": 6,
            "text": "D&C 52:22; 56:5 (5–6); 75:31."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Doctrine and Covenants 31:1",
        "book": "Doctrine and Covenants",
        "chapter": 31,
        "verse": 1
      },
      {
        "text": "Behold, you have had many afflictions because of your family; nevertheless, I will bless you and your family, yea, your little ones; and the day cometh that they will believe and know the truth and be one with you in my church.",
        "footNotes": [
          {
            "start": 102,
            "end": 108,
            "text": "TG Family; Unity."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
