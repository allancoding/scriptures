            "end": 47,
            "text": "D&C 45:26."
          },
          {
            "start": 58,
            "end": 65,
            "text": "JS—H 1:41 (40–41)."
          },
          {
            "start": 110,
            "end": 124,
            "text": "D&C 130:12 (12–13)."
          }
        ],
        "italics": [],
        "associatedContent": [],
