  "chapter": {
    "bookTitle": "Ether",
    "delineation": "Chapter",
    "number": 8,
    "summary": "There is strife and contention over the kingdom—Akish forms an oath-bound secret combination to slay the king—Secret combinations are of the devil and result in the destruction of nations—Modern Gentiles are warned against the secret combination that will seek to overthrow the freedom of all lands, nations, and countries.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass that he begat Omer, and Omer reigned in his stead. And Omer begat Jared; and Jared begat sons and daughters.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 8:1",
        "book": "Ether",
        "chapter": 8,
        "verse": 1
      },
      {
        "text": "And Jared rebelled against his father, and came and dwelt in the land of Heth. And it came to pass that he did flatter many people, because of his cunning words, until he had gained the half of the kingdom.",
        "footNotes": [
          {
            "start": 111,
            "end": 118,
            "text": "Hel. 1:7; 2:5."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "Hel. 1:7; 2:5.",
            "prettyString": "Helaman 1:7; 2:5",
            "references": [
              {
                "type": "scripture",
                "book": "helaman",
                "chapters": [
                  {
                    "start": 1,
