                        "end": 7
                      }
                    ]
                  },
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ether 8:2",
        "book": "Ether",
        "chapter": 8,
        "verse": 2
      },
      {
        "text": "And when he had gained the half of the kingdom he gave battle unto his father, and he did carry away his father into captivity, and did make him serve in captivity;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 8:3",
        "book": "Ether",
        "chapter": 8,
        "verse": 3
      },
      {
        "text": "And now, in the days of the reign of Omer he was in captivity the half of his days. And it came to pass that he begat sons and daughters, among whom were Esrom and Coriantumr;",
        "footNotes": [
          {
            "start": 52,
            "end": 61,
            "text": "Ether 7:7 (5–7); 10:14."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 8:4",
        "book": "Ether",
        "chapter": 8,
        "verse": 4
      },
      {
        "text": "And they were exceedingly angry because of the doings of Jared their brother, insomuch that they did raise an army and gave battle unto Jared. And it came to pass that they did give battle unto him by night.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 8:5",
        "book": "Ether",
        "chapter": 8,
        "verse": 5
      },
      {
        "text": "And it came to pass that when they had slain the army of Jared they were about to slay him also; and he pled with them that they would not slay him, and he would give up the kingdom unto his father. And it came to pass that they did grant unto him his life.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ether 8:6",
        "book": "Ether",
        "chapter": 8,
        "verse": 6
      },
      {
        "text": "And now Jared became exceedingly sorrowful because of the loss of the kingdom, for he had set his heart upon the kingdom and upon the glory of the world.",
        "footNotes": [
          {
            "start": 33,
            "end": 42,
            "text": "Morm. 2:13."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Morm. 2:13.",
            "prettyString": "Mormon 2:13",
            "references": [
              {
                "type": "scripture",
