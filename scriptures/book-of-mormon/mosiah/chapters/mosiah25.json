  "chapter": {
    "bookTitle": "Mosiah",
    "delineation": "Chapter",
    "number": 25,
    "summary": "The descendants of Mulek at Zarahemla become Nephites—They learn of the people of Alma and of Zeniff—Alma baptizes Limhi and all his people—Mosiah authorizes Alma to organize the Church of God. About 120 B.C.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And now king Mosiah caused that all the people should be gathered together.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 25:1",
        "book": "Mosiah",
        "chapter": 25,
        "verse": 1
      },
      {
        "text": "Now there were not so many of the children of Nephi, or so many of those who were descendants of Nephi, as there were of the people of Zarahemla, who was a descendant of Mulek, and those who came with him into the wilderness.",
        "footNotes": [
          {
            "start": 125,
            "end": 131,
            "text": "Hel. 6:10."
          },
          {
            "start": 170,
            "end": 175,
            "text": "Ezek. 17:22 (22–23); Omni 1:15 (14–19)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "Hel. 6:10.",
            "prettyString": "Helaman 6:10",
