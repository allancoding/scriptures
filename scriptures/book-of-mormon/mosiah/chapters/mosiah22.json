        "jstReferences": [],
        "reference": "Mosiah 22:11",
        "book": "Mosiah",
        "chapter": 22,
        "verse": 11
      },
      {
        "text": "And they had taken all their gold, and silver, and their precious things, which they could carry, and also their provisions with them, into the wilderness; and they pursued their journey.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 22:12",
        "book": "Mosiah",
        "chapter": 22,
        "verse": 12
      },
      {
