                        "start": 28,
                        "end": 28
                      }
                    ]
                  },
                  {
                    "start": 21,
                    "end": 21,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Mosiah 22:6",
        "book": "Mosiah",
        "chapter": 22,
        "verse": 6
      },
      {
