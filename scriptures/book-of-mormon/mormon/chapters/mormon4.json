                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Mormon 4:2",
        "book": "Mormon",
        "chapter": 4,
        "verse": 2
      },
      {
        "text": "And the remainder did flee and join the inhabitants of the city Teancum. Now the city Teancum lay in the borders by the seashore; and it was also near the city Desolation.",
        "footNotes": [
          {
            "start": 160,
            "end": 170,
            "text": "Morm. 3:5."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "Morm. 3:5.",
            "prettyString": "Mormon 3:5",
            "references": [
              {
                "type": "scripture",
                "book": "mormon",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Mormon 4:3",
        "book": "Mormon",
        "chapter": 4,
        "verse": 3
      },
      {
        "text": "And it was because the armies of the Nephites went up unto the Lamanites that they began to be smitten; for were it not for that, the Lamanites could have had no power over them.",
        "footNotes": [
          {
            "start": 11,
            "end": 18,
            "text": "Morm. 3:10 (10–11)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mormon 4:4",
        "book": "Mormon",
        "chapter": 4,
        "verse": 4
      },
      {
        "text": "But, behold, the judgments of God will overtake the wicked; and it is by the wicked that the wicked are punished; for it is the wicked that stir up the hearts of the children of men unto bloodshed.",
        "footNotes": [
          {
            "start": 52,
            "end": 58,
            "text": "Nahum 1:3."
          },
          {
            "start": 104,
            "end": 112,
            "text": "2 Pet. 2:12; D&C 63:33."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
