        "reference": "Helaman 16:13",
        "book": "Helaman",
        "chapter": 16,
        "verse": 13
      },
      {
        "text": "And angels did appear unto men, wise men, and did declare unto them glad tidings of great joy; thus in this year the scriptures began to be fulfilled.",
        "footNotes": [
          {
            "start": 4,
            "end": 10,
            "text": "Alma 13:26."
          }
        ],
        "italics": [],
        "associatedContent": [],
