        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Nephi 10:5",
        "book": "1 Nephi",
        "chapter": 10,
        "verse": 5
      },
      {
