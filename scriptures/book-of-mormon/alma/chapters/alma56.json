          },
          {
            "start": 181,
            "end": 188,
            "text": "Alma 57:21. TG Marriage, Motherhood."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 47,
        "crossReferences": [
          {
            "raw": "TG Birthright; Liberty.",
            "prettyString": "TG Birthright; TG Liberty",
            "references": [
              {
                "type": "studyHelp",
