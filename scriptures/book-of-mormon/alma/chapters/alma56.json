        "jstReferences": [],
        "reference": "Alma 56:47",
        "book": "Alma",
        "chapter": 56,
        "verse": 47
      },
      {
        "text": "And they rehearsed unto me the words of their mothers, saying: We do not doubt our mothers knew it.",
        "footNotes": [
