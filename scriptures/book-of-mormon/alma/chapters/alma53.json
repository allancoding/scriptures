                "entryId": "tg-oath",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 53:14",
        "book": "Alma",
        "chapter": 53,
        "verse": 14
      },
      {
        "text": "And Helaman feared lest by so doing they should lose their souls; therefore all those who had entered into this covenant were compelled to behold their brethren wade through their afflictions, in their dangerous circumstances at this time.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 53:15",
        "book": "Alma",
        "chapter": 53,
        "verse": 15
      },
      {
        "text": "But behold, it came to pass they had many sons, who had not entered into a covenant that they would not take their weapons of war to defend themselves against their enemies; therefore they did assemble themselves together at this time, as many as were able to take up arms, and they called themselves Nephites.",
        "footNotes": [
          {
            "start": 42,
            "end": 46,
            "text": "Alma 57:6."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "Alma 57:6.",
            "prettyString": "Alma 57:6",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 57,
                    "end": 57,
                    "verses": [
                      {
                        "start": 6,
                        "end": 6
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Alma 53:16",
        "book": "Alma",
        "chapter": 53,
        "verse": 16
      },
      {
        "text": "And they entered into a covenant to fight for the liberty of the Nephites, yea, to protect the land unto the laying down of their lives; yea, even they covenanted that they never would give up their liberty, but they would fight in all cases to protect the Nephites and themselves from bondage.",
        "footNotes": [
          {
            "start": 109,
            "end": 115,
            "text": "TG Self-Sacrifice."
          },
          {
            "start": 199,
            "end": 206,
            "text": "Alma 56:47. TG Liberty."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [
          {
            "raw": "TG Self-Sacrifice.",
            "prettyString": "TG Self-Sacrifice",
            "references": [
              {
                "type": "studyHelp",
