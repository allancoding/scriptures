        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Alma 40:4",
        "book": "Alma",
        "chapter": 40,
        "verse": 4
      },
      {
        "text": "Now, whether there shall be one time, or a second time, or a third time, that men shall come forth from the dead, it mattereth not; for God knoweth all these things; and it sufficeth me to know that this is the case—that there is a time appointed that all shall rise from the dead.",
        "footNotes": [
          {
            "start": 43,
            "end": 49,
            "text": "1 Thes. 4:16; Mosiah 26:25 (24–25); D&C 43:18; 76:85."
