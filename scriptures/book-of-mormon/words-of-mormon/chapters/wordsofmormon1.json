                        "end": 19
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "The Words of Mormon 1:2",
        "book": "The Words of Mormon",
        "chapter": 1,
        "verse": 2
      },
      {
        "text": "And now, I speak somewhat concerning that which I have written; for after I had made an abridgment from the plates of Nephi, down to the reign of this king Benjamin, of whom Amaleki spake, I searched among the records which had been delivered into my hands, and I found these plates, which contained this small account of the prophets, from Jacob down to the reign of this king Benjamin, and also many of the words of Nephi.",
        "footNotes": [
          {
            "start": 88,
            "end": 98,
            "text": "1 Ne. 1:17 (16–17); D&C 10:44."
          },
          {
            "start": 108,
            "end": 123,
            "text": "Jarom 1:14; W of M 1:10; D&C 10:38 (38–40)."
          },
          {
            "start": 210,
            "end": 217,
            "text": "Mosiah 1:6 (2–6); Hel. 3:13 (13–15); Morm. 4:23."
          },
          {
            "start": 378,
            "end": 386,
            "text": "Omni 1:23 (23–25)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "The Words of Mormon 1:3",
        "book": "The Words of Mormon",
        "chapter": 1,
        "verse": 3
      },
      {
        "text": "And the things which are upon these plates pleasing me, because of the prophecies of the coming of Christ; and my fathers knowing that many of them have been fulfilled; yea, and I also know that as many things as have been prophesied concerning us down to this day have been fulfilled, and as many as go beyond this day must surely come to pass—",
        "footNotes": [
          {
            "start": 43,
            "end": 51,
            "text": "1 Ne. 6:5 (3–6)."
          },
          {
            "start": 223,
            "end": 233,
            "text": "TG Jesus Christ, Prophecies about."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
