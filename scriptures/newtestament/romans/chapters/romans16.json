                        "end": 11
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Romans 16:17",
        "book": "Romans",
        "chapter": 16,
        "verse": 17
      },
      {
        "text": "For they that are such serve not our Lord Jesus Christ, but their own belly; and by good words and fair speeches deceive the hearts of the simple.",
        "footNotes": [
          {
            "start": 99,
            "end": 103,
            "text": "2 Pet. 2:3."
          },
          {
            "start": 139,
            "end": 145,
            "text": "GR innocent, guileless."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "2 Pet. 2:3.",
            "prettyString": "2 Peter 2:3",
            "references": [
              {
