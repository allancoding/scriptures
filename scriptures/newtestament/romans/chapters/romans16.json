          },
          {
            "start": 143,
            "end": 149,
            "text": "GR blameless, innocent."
          }
        ],
        "italics": [
          {
            "start": 43,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
          {
            "raw": "Rom. 1:8.",
            "prettyString": "Romans 1:8",
            "references": [
              {
                "type": "scripture",
