      {
        "text": "What is it therefore? the multitude must needs come together: for they will hear that thou art come.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 21:22",
        "book": "Acts",
        "chapter": 21,
        "verse": 22
      },
      {
