        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "John 18:15",
        "book": "John",
        "chapter": 18,
        "verse": 15
      },
      {
        "text": "But Peter stood at the door without. Then went out that other disciple, which was known unto the high priest, and spake unto her that kept the door, and brought in Peter.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "John 18:16",
        "book": "John",
        "chapter": 18,
