                "entryId": "tg-strife",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Philippians 1:15",
        "book": "Philippians",
        "chapter": 1,
        "verse": 15
      },
      {
        "text": "The one preach Christ of contention, not sincerely, supposing to add affliction to my bonds:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Philippians 1:16",
        "book": "Philippians",
        "chapter": 1,
        "verse": 16
      },
      {
        "text": "But the other of love, knowing that I am set for the defence of the gospel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Philippians 1:17",
        "book": "Philippians",
        "chapter": 1,
        "verse": 17
      },
      {
        "text": "What then? notwithstanding, every way, whether in pretence, or in truth, Christ is preached; and I therein do rejoice, yea, and will rejoice.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Philippians 1:18",
        "book": "Philippians",
        "chapter": 1,
        "verse": 18
      },
      {
        "text": "For I know that this shall turn to my salvation through your prayer, and the supply of the Spirit of Jesus Christ,",
        "footNotes": [
          {
            "start": 61,
            "end": 67,
            "text": "2 Cor. 1:11; Philem. 1:22."
          },
          {
            "start": 91,
            "end": 97,
            "text": "TG God, Spirit of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
          {
