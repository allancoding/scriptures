        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 14:5",
        "book": "Mark",
        "chapter": 14,
        "verse": 5
      },
      {
        "text": "And Jesus said, Let her alone; why trouble ye her? she hath wrought a good work on me.",
