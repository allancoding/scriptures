        ],
        "italics": [
          {
            "start": 112,
            "end": 115
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Romans 7:8",
        "book": "Romans",
        "chapter": 7,
        "verse": 8
      },
      {
        "text": "For I was alive without the law once: but when the commandment came, sin revived, and I died.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Romans 7:9",
        "book": "Romans",
        "chapter": 7,
        "verse": 9
      },
      {
