        "footNotes": [
          {
            "start": 21,
            "end": 24,
            "text": "D&C 29:34."
          },
          {
            "start": 48,
            "end": 54,
            "text": "TG Carnal Mind."
          },
          {
            "start": 56,
            "end": 66,
            "text": "GR devoted to, a slave to."
