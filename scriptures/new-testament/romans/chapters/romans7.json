            "text": "GR May it not be!"
          },
          {
            "start": 89,
            "end": 92,
            "text": "D&C 82:3 (3–4). TG Law of Moses."
          },
          {
            "start": 114,
            "end": 118,
            "text": "TG Lust."
          },
          {
            "start": 160,
            "end": 165,
            "text": "GR lust for, set the heart upon. TG Covet."
          }
        ],
        "italics": [
          {
            "start": 24,
            "end": 26
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "TG Lust.",
