            "end": 73,
            "text": "2 Cor. 3:7."
          }
        ],
        "italics": [
          {
            "start": 27,
            "end": 39
          },
          {
            "start": 57,
            "end": 62
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
