        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Romans 7:15",
        "book": "Romans",
        "chapter": 7,
        "verse": 15
      },
      {
