        "italics": [
          {
            "start": 13,
            "end": 22
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Luke 19:2",
        "book": "Luke",
        "chapter": 19,
        "verse": 2
      },
      {
        "text": "And he sought to see Jesus who he was; and could not for the press, because he was little of stature.",
