        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Luke 19:1",
        "book": "Luke",
        "chapter": 19,
        "verse": 1
      },
      {
        "text": "And, behold, there was a man named Zacchæus, which was the chief among the publicans, and he was rich.",
