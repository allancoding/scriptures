          {
            "start": 61,
            "end": 66,
            "text": "GR crowd, multitude."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Luke 19:3",
        "book": "Luke",
        "chapter": 19,
        "verse": 3
      },
      {
