        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Luke 19:5",
        "book": "Luke",
        "chapter": 19,
        "verse": 5
      },
      {
