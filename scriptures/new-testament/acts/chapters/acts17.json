        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 17:14",
        "book": "Acts",
        "chapter": 17,
        "verse": 14
      },
      {
        "text": "And they that conducted Paul brought him unto Athens: and receiving a commandment unto Silas and Timotheus for to come to him with all speed, they departed.",
        "footNotes": [
          {
            "start": 46,
            "end": 52,
            "text": "1 Thes. 3:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
