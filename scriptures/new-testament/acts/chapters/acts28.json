            "end": 60
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 28:3",
        "book": "Acts",
        "chapter": 28,
        "verse": 3
      },
      {
        "text": "And when the barbarians saw the venomous beast hang on his hand, they said among themselves, No doubt this man is a murderer, whom, though he hath escaped the sea, yet vengeance suffereth not to live.",
        "footNotes": [],
        "italics": [
          {
            "start": 32,
            "end": 40
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 28:4",
        "book": "Acts",
        "chapter": 28,
        "verse": 4
      },
      {
        "text": "And he shook off the beast into the fire, and felt no harm.",
        "footNotes": [
          {
            "start": 54,
            "end": 58,
            "text": "Luke 10:19."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "Luke 10:19.",
            "prettyString": "Luke 10:19",
            "references": [
              {
                "type": "scripture",
                "book": "luke",
                "chapters": [
                  {
