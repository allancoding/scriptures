        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 28:1",
        "book": "Acts",
        "chapter": 28,
        "verse": 1
      },
      {
