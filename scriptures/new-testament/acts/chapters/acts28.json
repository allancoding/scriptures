        "jstReferences": [],
        "reference": "Acts 28:2",
        "book": "Acts",
        "chapter": 28,
        "verse": 2
      },
      {
        "text": "And when Paul had gathered a bundle of sticks, and laid them on the fire, there came a viper out of the heat, and fastened on his hand.",
        "footNotes": [
          {
            "start": 87,
            "end": 92,
            "text": "Mark 16:18; D&C 24:13; 84:72 (71–72); 124:99 (98–100)."
          }
        ],
        "italics": [
          {
