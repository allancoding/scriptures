        "footNotes": [
          {
            "start": 8,
            "end": 17,
            "text": "Rom. 1:14."
          },
          {
            "start": 45,
            "end": 53,
            "text": "TG Hospitality."
          }
        ],
        "italics": [],
        "associatedContent": [],
