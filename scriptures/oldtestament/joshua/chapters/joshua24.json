  "chapter": {
    "bookTitle": "Joshua",
    "delineation": "Chapter",
    "number": 24,
    "summary": "Joshua recites how the Lord has blessed and led Israel—Joshua and all the people covenant to choose the Lord and serve Him only—Joshua and Eleazar die—The bones of Joseph, taken from Egypt, are buried in Shechem.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And Joshua gathered all the tribes of Israel to Shechem, and called for the elders of Israel, and for their heads, and for their judges, and for their officers; and they presented themselves before God.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 24:1",
        "book": "Joshua",
        "chapter": 24,
        "verse": 1
      },
      {
        "text": "And Joshua said unto all the people, Thus saith the Lord God of Israel, Your fathers dwelt on the other side of the flood in old time, even Terah, the father of Abraham, and the father of Nachor: and they served other gods.",
        "footNotes": [
          {
            "start": 218,
            "end": 222,
            "text": "Abr. 2:5 (1–5). TG Idolatry."
          }
        ],
        "italics": [
          {
            "start": 135,
            "end": 139
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 24:2",
        "book": "Joshua",
        "chapter": 24,
        "verse": 2
      },
      {
        "text": "And I took your father Abraham from the other side of the flood, and led him throughout all the land of Canaan, and multiplied his seed, and gave him Isaac.",
        "footNotes": [
          {
            "start": 131,
            "end": 135,
            "text": "TG Seed of Abraham."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
