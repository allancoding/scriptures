            ]
          }
        ],
        "jstReferences": [],
        "reference": "Joshua 24:3",
        "book": "Joshua",
        "chapter": 24,
        "verse": 3
      },
      {
        "text": "And I gave unto Isaac Jacob and Esau: and I gave unto Esau mount Seir, to possess it; but Jacob and his children went down into Egypt.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 24:4",
        "book": "Joshua",
        "chapter": 24,
        "verse": 4
      },
      {
        "text": "I sent Moses also and Aaron, and I plagued Egypt, according to that which I did among them: and afterward I brought you out.",
        "footNotes": [
          {
            "start": 35,
            "end": 42,
            "text": "TG Plague."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "TG Plague.",
            "prettyString": "TG Plague",
