        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:49",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 49
      },
      {
        "text": "Till the Lord look down, and behold from heaven.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
