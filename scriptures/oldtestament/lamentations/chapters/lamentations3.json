        "associatedContent": [],
        "verseNumber": 57,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:57",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 57
      },
      {
        "text": "O Lord, thou hast pleaded the causes of my soul; thou hast redeemed my life.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 58,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:58",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 58
      },
      {
