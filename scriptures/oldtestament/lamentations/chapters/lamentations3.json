      {
        "text": "For the Lord will not cast off for ever:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 31,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:31",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 31
