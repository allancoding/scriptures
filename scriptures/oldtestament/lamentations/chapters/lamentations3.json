        "italics": [],
        "associatedContent": [],
        "verseNumber": 59,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:59",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 59
      },
      {
        "text": "Thou hast seen all their vengeance and all their imaginations against me.",
