        "italics": [
          {
            "start": 35,
            "end": 38
          }
        ],
        "associatedContent": [],
        "verseNumber": 60,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:60",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 60
      },
      {
