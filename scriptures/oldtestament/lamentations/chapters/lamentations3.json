        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:50",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 50
      },
      {
        "text": "Mine eye affecteth mine heart because of all the daughters of my city.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 51,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:51",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 51
      },
      {
        "text": "Mine enemies chased me sore, like a bird, without cause.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 52,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:52",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 52
      },
      {
        "text": "They have cut off my life in the dungeon, and cast a stone upon me.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 53,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Lamentations 3:53",
        "book": "Lamentations",
        "chapter": 3,
        "verse": 53
      },
      {
        "text": "Waters flowed over mine head; then I said, I am cut off.",
