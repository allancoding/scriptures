        "book": "Ruth",
        "chapter": 1,
        "verse": 16
      },
      {
        "text": "Where thou diest, will I die, and there will I be buried: the Lord do so to me, and more also, if ought but death part thee and me.",
        "footNotes": [],
        "italics": [
          {
            "start": 95,
            "end": 103
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ruth 1:17",
        "book": "Ruth",
        "chapter": 1,
        "verse": 17
      },
      {
