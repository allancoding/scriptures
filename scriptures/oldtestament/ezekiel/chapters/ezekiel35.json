                "entryId": "tg-blaspheme",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ezekiel 35:12",
        "book": "Ezekiel",
        "chapter": 35,
        "verse": 12
      },
      {
        "text": "Thus with your mouth ye have boasted against me, and have multiplied your words against me: I have heard them.",
        "footNotes": [
          {
            "start": 29,
            "end": 36,
            "text": "Hel. 4:13."
          }
        ],
        "italics": [
          {
            "start": 105,
