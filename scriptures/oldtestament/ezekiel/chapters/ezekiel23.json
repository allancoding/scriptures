        "footNotes": [
          {
            "start": 108,
            "end": 116,
            "text": "TG Filthiness."
          },
          {
            "start": 155,
            "end": 164,
            "text": "JST Ezek. 23:17 … from me by them."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [
          {
            "raw": "TG Filthiness.",
            "prettyString": "TG Filthiness",
            "references": [
              {
                "type": "studyHelp",
