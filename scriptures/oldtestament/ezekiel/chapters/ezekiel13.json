          {
            "start": 32,
            "end": 42,
            "text": "TG Superstitions."
          }
        ],
        "italics": [
          {
            "start": 120,
            "end": 126
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
