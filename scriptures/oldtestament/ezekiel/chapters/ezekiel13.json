        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 13:5",
        "book": "Ezekiel",
        "chapter": 13,
        "verse": 5
      },
      {
