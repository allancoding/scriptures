                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Isa. 2:13.",
            "prettyString": "Isaiah 2:13",
            "references": [
              {
                "type": "scripture",
                "book": "isaiah",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
                      {
