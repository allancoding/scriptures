        "book": "1 Chronicles",
        "chapter": 22,
        "verse": 5
      },
      {
        "text": "Then he called for Solomon his son, and charged him to build an house for the Lord God of Israel.",
        "footNotes": [
          {
            "start": 64,
            "end": 69,
            "text": "TG Temple."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
            "raw": "TG Temple.",
            "prettyString": "TG Temple",
            "references": [
              {
