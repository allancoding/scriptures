        "verse": 2
      },
      {
        "text": "And David prepared iron in abundance for the nails for the doors of the gates, and for the joinings; and brass in abundance without weight;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 22:3",
        "book": "1 Chronicles",
        "chapter": 22,
        "verse": 3
      },
      {
