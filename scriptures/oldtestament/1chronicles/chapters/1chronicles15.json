              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Chronicles 15:24",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 24
      },
      {
        "text": "So David, and the elders of Israel, and the captains over thousands, went to bring up the ark of the covenant of the Lord out of the house of Obed-edom with joy.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:25",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 25
      },
      {
