        "footNotes": [
          {
            "start": 106,
            "end": 113,
            "text": "2 Sam. 6:13 (12–15)."
          },
          {
            "start": 114,
            "end": 119,
            "text": "Num. 23:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [
          {
            "raw": "Num. 23:1.",
            "prettyString": "Numbers 23:1",
            "references": [
              {
                "type": "scripture",
                "book": "numbers",
                "chapters": [
                  {
                    "start": 23,
                    "end": 23,
                    "verses": [
                      {
