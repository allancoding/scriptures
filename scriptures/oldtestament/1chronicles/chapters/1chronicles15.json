                        "end": 14
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Chronicles 15:15",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 15
      },
      {
        "text": "And David spake to the chief of the Levites to appoint their brethren to be the singers with instruments of musick, psalteries and harps and cymbals, sounding, by lifting up the voice with joy.",
        "footNotes": [
          {
            "start": 131,
            "end": 136,
            "text": "2 Sam. 6:5; Dan. 3:5 (5, 7, 10, 15)."
          }
        ],
        "italics": [
          {
            "start": 70,
            "end": 75
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:16",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 16
      },
      {
        "text": "So the Levites appointed Heman the son of Joel; and of his brethren, Asaph the son of Berechiah; and of the sons of Merari their brethren, Ethan the son of Kushaiah;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:17",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 17
      },
      {
        "text": "And with them their brethren of the second degree, Zechariah, Ben, and Jaaziel, and Shemiramoth, and Jehiel, and Unni, Eliab, and Benaiah, and Maaseiah, and Mattithiah, and Elipheleh, and Mikneiah, and Obed-edom, and Jeiel, the porters.",
        "footNotes": [],
        "italics": [
          {
            "start": 43,
            "end": 50
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:18",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 18
      },
      {
        "text": "So the singers, Heman, Asaph, and Ethan, were appointed to sound with cymbals of brass;",
        "footNotes": [],
        "italics": [
          {
            "start": 41,
            "end": 55
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:19",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 19
      },
      {
        "text": "And Zechariah, and Aziel, and Shemiramoth, and Jehiel, and Unni, and Eliab, and Maaseiah, and Benaiah, with psalteries on Alamoth;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:20",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 20
      },
      {
        "text": "And Mattithiah, and Elipheleh, and Mikneiah, and Obed-edom, and Jeiel, and Azaziah, with harps on the Sheminith to excel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:21",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 21
      },
      {
        "text": "And Chenaniah, chief of the Levites, was for song: he instructed about the song, because he was skilful.",
        "footNotes": [],
        "italics": [
          {
            "start": 37,
            "end": 40
          },
          {
            "start": 92,
            "end": 95
          }
        ],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:22",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 22
      },
      {
        "text": "And Berechiah and Elkanah were doorkeepers for the ark.",
        "footNotes": [],
        "italics": [
          {
            "start": 26,
            "end": 30
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:23",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 23
      },
      {
        "text": "And Shebaniah, and Jehoshaphat, and Nethaneel, and Amasai, and Zechariah, and Benaiah, and Eliezer, the priests, did blow with the trumpets before the ark of God: and Obed-edom and Jehiah were doorkeepers for the ark.",
        "footNotes": [
          {
            "start": 131,
            "end": 139,
            "text": "Num. 10:8."
          }
        ],
        "italics": [
          {
            "start": 188,
            "end": 192
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [
          {
            "raw": "Num. 10:8.",
            "prettyString": "Numbers 10:8",
            "references": [
              {
                "type": "scripture",
                "book": "numbers",
                "chapters": [
                  {
                    "start": 10,
                    "end": 10,
                    "verses": [
                      {
