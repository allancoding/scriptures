        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:3",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 3
      },
