        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Chronicles 15:8",
        "book": "1 Chronicles",
        "chapter": 15,
        "verse": 8
      },
      {
        "text": "Of the sons of Hebron; Eliel the chief, and his brethren fourscore:",
        "footNotes": [],
        "italics": [],
