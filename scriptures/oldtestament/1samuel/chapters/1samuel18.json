                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 18:6",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 6
      },
      {
        "text": "And the women answered one another as they played, and said, Saul hath slain his thousands, and David his ten thousands.",
        "footNotes": [
          {
            "start": 61,
            "end": 65,
            "text": "1 Sam. 29:5."
          }
        ],
        "italics": [
          {
            "start": 23,
            "end": 34
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "1 Sam. 29:5.",
            "prettyString": "1 Samuel 29:5",
            "references": [
              {
                "type": "scripture",
                "book": "1samuel",
                "chapters": [
                  {
