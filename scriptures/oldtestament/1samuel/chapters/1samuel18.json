  "chapter": {
    "bookTitle": "1 Samuel",
    "delineation": "Chapter",
    "number": 18,
    "summary": "Jonathan loves David—Saul sets David over his armies—David is honored by the people, and Saul becomes jealous—David marries Michal, a daughter of Saul.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass, when he had made an end of speaking unto Saul, that the soul of Jonathan was knit with the soul of David, and Jonathan loved him as his own soul.",
        "footNotes": [
          {
            "start": 98,
            "end": 102,
            "text": "Gen. 44:30; 1 Sam. 20:4 (4, 41); Mosiah 4:15; 18:21; D&C 88:123. TG Friendship."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:1",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 1
      },
      {
        "text": "And Saul took him that day, and would let him go no more home to his father’s house.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:2",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 2
      },
      {
        "text": "Then Jonathan and David made a covenant, because he loved him as his own soul.",
        "footNotes": [
          {
            "start": 31,
            "end": 39,
            "text": "2 Sam. 9:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "2 Sam. 9:1.",
            "prettyString": "2 Samuel 9:1",
            "references": [
