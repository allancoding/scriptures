                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 18:7",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 7
      },
      {
        "text": "And Saul was very wroth, and the saying displeased him; and he said, They have ascribed unto David ten thousands, and to me they have ascribed but thousands: and what can he have more but the kingdom?",
        "footNotes": [],
        "italics": [
          {
            "start": 143,
            "end": 146
          },
          {
            "start": 162,
            "end": 166
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:8",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 8
      },
      {
        "text": "And Saul eyed David from that day and forward.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:9",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 9
      },
      {
        "text": "And it came to pass on the morrow, that the evil spirit from God came upon Saul, and he prophesied in the midst of the house: and David played with his hand, as at other times: and there was a javelin in Saul’s hand.",
        "footNotes": [
          {
            "start": 56,
            "end": 64,
            "text": "JST 1 Sam. 18:10 … which was not of God …"
          }
        ],
        "italics": [
          {
            "start": 181,
            "end": 190
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:10",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 10
      },
      {
        "text": "And Saul cast the javelin; for he said, I will smite David even to the wall with it. And David avoided out of his presence twice.",
        "footNotes": [],
        "italics": [
          {
            "start": 76,
            "end": 84
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:11",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 11
      },
      {
        "text": "And Saul was afraid of David, because the Lord was with him, and was departed from Saul.",
        "footNotes": [
          {
            "start": 69,
            "end": 77,
            "text": "D&C 121:37."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "D&C 121:37.",
            "prettyString": "D&C 121:37",
            "references": [
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 121,
                    "end": 121,
                    "verses": [
                      {
                        "start": 37,
                        "end": 37
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 18:12",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 12
      },
      {
        "text": "Therefore Saul removed him from him, and made him his captain over a thousand; and he went out and came in before the people.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:13",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 13
      },
      {
        "text": "And David behaved himself wisely in all his ways; and the Lord was with him.",
        "footNotes": [],
        "italics": [
          {
            "start": 63,
            "end": 66
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:14",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 14
      },
      {
        "text": "Wherefore when Saul saw that he behaved himself very wisely, he was afraid of him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 18:15",
        "book": "1 Samuel",
        "chapter": 18,
        "verse": 15
      },
      {
        "text": "But all Israel and Judah loved David, because he went out and came in before them.",
        "footNotes": [
          {
            "start": 19,
            "end": 24,
            "text": "2 Sam. 2:4."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "2 Sam. 2:4.",
            "prettyString": "2 Samuel 2:4",
            "references": [
              {
                "type": "scripture",
                "book": "2samuel",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
