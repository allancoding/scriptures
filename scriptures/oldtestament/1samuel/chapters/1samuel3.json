          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 3:17",
        "book": "1 Samuel",
        "chapter": 3,
        "verse": 17
      },
      {
        "text": "And Samuel told him every whit, and hid nothing from him. And he said, It is the Lord: let him do what seemeth him good.",
        "footNotes": [],
        "italics": [
          {
            "start": 74,
            "end": 76
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 3:18",
        "book": "1 Samuel",
        "chapter": 3,
        "verse": 18
      },
      {
