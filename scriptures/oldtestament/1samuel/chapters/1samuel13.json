              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 13:7",
        "book": "1 Samuel",
        "chapter": 13,
        "verse": 7
      },
      {
        "text": "And he tarried seven days, according to the set time that Samuel had appointed: but Samuel came not to Gilgal; and the people were scattered from him.",
        "footNotes": [],
        "italics": [
          {
            "start": 65,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 13:8",
        "book": "1 Samuel",
        "chapter": 13,
        "verse": 8
      },
