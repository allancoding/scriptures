                "entryId": "tg-god-power-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 14:6",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 6
      },
      {
        "text": "And his armourbearer said unto him, Do all that is in thine heart: turn thee; behold, I am with thee according to thy heart.",
        "footNotes": [
          {
            "start": 67,
            "end": 76,
            "text": "IE turn thee to it."
          }
        ],
        "italics": [
          {
            "start": 48,
            "end": 50
          },
          {
            "start": 88,
            "end": 90
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:7",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 7
      },
      {
        "text": "Then said Jonathan, Behold, we will pass over unto these men, and we will discover ourselves unto them.",
        "footNotes": [],
        "italics": [
          {
            "start": 51,
            "end": 56
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:8",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 8
      },
      {
        "text": "If they say thus unto us, Tarry until we come to you; then we will stand still in our place, and will not go up unto them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:9",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 9
      },
      {
        "text": "But if they say thus, Come up unto us; then we will go up: for the Lord hath delivered them into our hand: and this shall be a sign unto us.",
        "footNotes": [],
        "italics": [
          {
            "start": 116,
            "end": 124
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:10",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 10
      },
      {
        "text": "And both of them discovered themselves unto the garrison of the Philistines: and the Philistines said, Behold, the Hebrews come forth out of the holes where they had hid themselves.",
        "footNotes": [
          {
            "start": 17,
            "end": 27,
            "text": "OR showed, disclosed."
          },
          {
            "start": 145,
            "end": 150,
            "text": "1 Sam. 13:6."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "1 Sam. 13:6.",
            "prettyString": "1 Samuel 13:6",
            "references": [
              {
                "type": "scripture",
                "book": "1samuel",
                "chapters": [
                  {
                    "start": 13,
                    "end": 13,
                    "verses": [
                      {
