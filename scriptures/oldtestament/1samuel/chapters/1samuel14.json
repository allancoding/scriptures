          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [
          {
            "raw": "1 Sam. 13:7.",
            "prettyString": "1 Samuel 13:7",
            "references": [
              {
                "type": "scripture",
