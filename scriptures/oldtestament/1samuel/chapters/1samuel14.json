                        "end": 6
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 14:11",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 11
      },
      {
        "text": "And the men of the garrison answered Jonathan and his armourbearer, and said, Come up to us, and we will shew you a thing. And Jonathan said unto his armourbearer, Come up after me: for the Lord hath delivered them into the hand of Israel.",
        "footNotes": [
          {
            "start": 200,
            "end": 209,
            "text": "3 Ne. 3:21."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "3 Ne. 3:21.",
            "prettyString": "3 Nephi 3:21",
            "references": [
              {
                "type": "scripture",
                "book": "3nephi",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 21,
                        "end": 21
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 14:12",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 12
      },
      {
        "text": "And Jonathan climbed up upon his hands and upon his feet, and his armourbearer after him: and they fell before Jonathan; and his armourbearer slew after him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:13",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 13
      },
      {
        "text": "And that first slaughter, which Jonathan and his armourbearer made, was about twenty men, within as it were an half acre of land, which a yoke of oxen might plow.",
        "footNotes": [],
        "italics": [
          {
            "start": 130,
            "end": 135
          },
          {
            "start": 143,
            "end": 162
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:14",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 14
      },
      {
        "text": "And there was trembling in the host, in the field, and among all the people: the garrison, and the spoilers, they also trembled, and the earth quaked: so it was a very great trembling.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:15",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 15
      },
      {
        "text": "And the watchmen of Saul in Gibeah of Benjamin looked; and, behold, the multitude melted away, and they went on beating down one another.",
        "footNotes": [],
        "italics": [
          {
            "start": 125,
            "end": 137
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:16",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 16
      },
      {
        "text": "Then said Saul unto the people that were with him, Number now, and see who is gone from us. And when they had numbered, behold, Jonathan and his armourbearer were not there.",
        "footNotes": [],
        "italics": [
          {
            "start": 36,
            "end": 40
          },
          {
            "start": 158,
            "end": 162
          },
          {
            "start": 167,
            "end": 173
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:17",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 17
      },
      {
        "text": "And Saul said unto Ahiah, Bring hither the ark of God. For the ark of God was at that time with the children of Israel.",
        "footNotes": [
          {
            "start": 63,
            "end": 66,
            "text": "Ex. 25:10 (10–16)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:18",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 18
      },
      {
        "text": "And it came to pass, while Saul talked unto the priest, that the noise that was in the host of the Philistines went on and increased: and Saul said unto the priest, Withdraw thine hand.",
        "footNotes": [],
        "italics": [
          {
            "start": 76,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 14:19",
        "book": "1 Samuel",
        "chapter": 14,
        "verse": 19
      },
      {
        "text": "And Saul and all the people that were with him assembled themselves, and they came to the battle: and, behold, every man’s sword was against his fellow, and there was a very great discomfiture.",
        "footNotes": [
          {
            "start": 145,
            "end": 151,
            "text": "Judg. 7:22; 2 Chr. 20:23."
          },
          {
            "start": 180,
            "end": 192,
            "text": "OR panic, confusion."
          }
        ],
        "italics": [
          {
            "start": 33,
            "end": 37
          },
          {
            "start": 153,
            "end": 166
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [
          {
