            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 22:8",
        "book": "1 Samuel",
        "chapter": 22,
        "verse": 8
      },
      {
        "text": "Then answered Doeg the Edomite, which was set over the servants of Saul, and said, I saw the son of Jesse coming to Nob, to Ahimelech the son of Ahitub.",
        "footNotes": [
          {
            "start": 14,
            "end": 18,
            "text": "1 Sam. 21:7."
          },
          {
            "start": 116,
            "end": 119,
            "text": "1 Sam. 21:1."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
