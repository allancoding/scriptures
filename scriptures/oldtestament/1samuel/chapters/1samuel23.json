                        "start": 22,
                        "end": 22
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Samuel 23:29",
        "book": "1 Samuel",
        "chapter": 23,
        "verse": 29
      }
