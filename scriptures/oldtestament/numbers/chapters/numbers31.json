        "italics": [
          {
            "start": 14,
            "end": 18
          },
          {
            "start": 81,
            "end": 84
          }
        ],
        "associatedContent": [],
        "verseNumber": 39,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 31:39",
        "book": "Numbers",
        "chapter": 31,
        "verse": 39
      },
