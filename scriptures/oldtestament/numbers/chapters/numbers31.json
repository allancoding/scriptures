        "associatedContent": [],
        "verseNumber": 36,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 31:36",
        "book": "Numbers",
        "chapter": 31,
        "verse": 36
      },
      {
        "text": "And the Lord’s tribute of the sheep was six hundred and threescore and fifteen.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 37,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 31:37",
        "book": "Numbers",
        "chapter": 31,
        "verse": 37
      },
      {
