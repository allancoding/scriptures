        "footNotes": [],
        "italics": [
          {
            "start": 28,
            "end": 37
          }
        ],
        "associatedContent": [],
        "verseNumber": 41,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 31:41",
        "book": "Numbers",
        "chapter": 31,
        "verse": 41
      },
