        ],
        "jstReferences": [],
        "reference": "Numbers 20:11",
        "book": "Numbers",
        "chapter": 20,
        "verse": 11
      },
      {
        "text": "And the Lord spake unto Moses and Aaron, Because ye believed me not, to sanctify me in the eyes of the children of Israel, therefore ye shall not bring this congregation into the land which I have given them.",
        "footNotes": [
          {
            "start": 52,
            "end": 67,
            "text": "IE in not speaking to the rock, striking it instead. TG Unbelief."
          },
          {
            "start": 72,
            "end": 80,
            "text": "TG Sanctification."
          },
          {
            "start": 146,
            "end": 151,
            "text": "Deut. 31:2."
          },
          {
            "start": 179,
            "end": 183,
            "text": "Deut. 4:26 (24–28); 32:51."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
