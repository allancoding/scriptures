        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 26:5",
        "book": "Numbers",
        "chapter": 26,
        "verse": 5
      },
      {
