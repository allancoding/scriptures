        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 26:3",
        "book": "Numbers",
        "chapter": 26,
        "verse": 3
      },
      {
