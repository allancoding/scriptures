        "italics": [
          {
            "start": 0,
            "end": 27
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 26:4",
        "book": "Numbers",
        "chapter": 26,
        "verse": 4
      },
      {
        "text": "Reuben, the eldest son of Israel: the children of Reuben; Hanoch, of whom cometh the family of the Hanochites: of Pallu, the family of the Palluites:",
        "footNotes": [
          {
            "start": 0,
            "end": 6,
            "text": "Gen. 42:37; 46:9; Josh. 13:15 (15–23)."
