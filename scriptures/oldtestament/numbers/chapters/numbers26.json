        "verseNumber": 57,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 26:57",
        "book": "Numbers",
        "chapter": 26,
        "verse": 57
      },
      {
        "text": "These are the families of the Levites: the family of the Libnites, the family of the Hebronites, the family of the Mahlites, the family of the Mushites, the family of the Korathites. And Kohath begat Amram.",
        "footNotes": [],
