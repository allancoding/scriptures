        "crossReferences": [],
        "jstReferences": [],
        "reference": "Numbers 15:6",
        "book": "Numbers",
        "chapter": 15,
        "verse": 6
      },
      {
        "text": "And for a drink offering thou shalt offer the third part of an hin of wine, for a sweet savour unto the Lord.",
        "footNotes": [],
        "italics": [
          {
            "start": 52,
            "end": 56
          },
          {
            "start": 76,
            "end": 79
