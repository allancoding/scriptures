            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 21:22",
        "book": "Job",
        "chapter": 21,
        "verse": 22
      },
      {
        "text": "One dieth in his full strength, being wholly at ease and quiet.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 21:23",
        "book": "Job",
        "chapter": 21,
        "verse": 23
      },
      {
        "text": "His breasts are full of milk, and his bones are moistened with marrow.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 21:24",
        "book": "Job",
        "chapter": 21,
        "verse": 24
      },
      {
        "text": "And another dieth in the bitterness of his soul, and never eateth with pleasure.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 21:25",
        "book": "Job",
        "chapter": 21,
        "verse": 25
      },
      {
        "text": "They shall lie down alike in the dust, and the worms shall cover them.",
        "footNotes": [
          {
            "start": 33,
            "end": 37,
            "text": "TG Mortality."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [
          {
            "raw": "TG Mortality.",
            "prettyString": "TG Mortality",
            "references": [
