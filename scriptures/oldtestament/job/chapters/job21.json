                      {
                        "start": 18,
                        "end": 18
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 21:20",
        "book": "Job",
        "chapter": 21,
        "verse": 20
      },
      {
        "text": "For what pleasure hath he in his house after him, when the number of his months is cut off in the midst?",
        "footNotes": [],
        "italics": [
          {
            "start": 18,
            "end": 22
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 21:21",
        "book": "Job",
        "chapter": 21,
        "verse": 21
      },
      {
        "text": "Shall any teach God knowledge? seeing he judgeth those that are high.",
        "footNotes": [
          {
            "start": 10,
            "end": 15,
            "text": "Isa. 40:13 (13–15)."
          },
          {
            "start": 20,
            "end": 29,
            "text": "TG God, Omniscience of."
          }
        ],
        "italics": [
          {
            "start": 6,
            "end": 9
          }
        ],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [
          {
            "raw": "TG God, Omniscience of.",
            "prettyString": "TG God, Omniscience of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "God, Omniscience of",
                "entryId": "tg-god-omniscience-of",
                "book": "",
