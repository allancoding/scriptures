        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 22:25",
        "book": "Job",
        "chapter": 22,
        "verse": 25
      },
      {
