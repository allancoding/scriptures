        "footNotes": [
          {
            "start": 76,
            "end": 80,
            "text": "Job 11:15 (13–16, 18)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 22:26",
        "book": "Job",
        "chapter": 22,
        "verse": 26
      },
