                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 22:23",
        "book": "Job",
        "chapter": 22,
        "verse": 23
      },
      {
        "text": "Then shalt thou lay up gold as dust, and the gold of Ophir as the stones of the brooks.",
        "footNotes": [],
        "italics": [
          {
            "start": 45,
            "end": 49
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 22:24",
        "book": "Job",
        "chapter": 22,
        "verse": 24
      },
      {
