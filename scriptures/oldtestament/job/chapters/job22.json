        "book": "Job",
        "chapter": 22,
        "verse": 27
      },
      {
        "text": "Thou shalt also decree a thing, and it shall be established unto thee: and the light shall shine upon thy ways.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 28,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 22:28",
        "book": "Job",
        "chapter": 22,
        "verse": 28
      },
      {
