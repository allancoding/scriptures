    "delineation": "Chapter",
    "number": 8,
    "summary": "Bildad asks, Doth God pervert judgment?—Bildad says, Our days upon earth are a shadow, and God will not cast away a perfect man.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Then answered Bildad the Shuhite, and said,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:1",
        "book": "Job",
        "chapter": 8,
        "verse": 1
      },
      {
        "text": "How long wilt thou speak these things? and how long shall the words of thy mouth be like a strong wind?",
        "footNotes": [],
        "italics": [
          {
            "start": 31,
            "end": 38
          },
          {
            "start": 43,
            "end": 57
          },
          {
            "start": 81,
            "end": 88
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:2",
        "book": "Job",
        "chapter": 8,
        "verse": 2
      },
      {
        "text": "Doth God pervert judgment? or doth the Almighty pervert justice?",
        "footNotes": [
          {
            "start": 17,
            "end": 25,
            "text": "Alma 12:15."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "Alma 12:15.",
            "prettyString": "Alma 12:15",
            "references": [
              {
