        "footNotes": [
          {
            "start": 60,
            "end": 64,
            "text": "Job 7:6."
          }
        ],
        "italics": [
          {
            "start": 8,
            "end": 18
          },
          {
            "start": 76,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
