                        "end": 15
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 8:3",
        "book": "Job",
        "chapter": 8,
        "verse": 3
      },
      {
        "text": "If thy children have sinned against him, and he have cast them away for their transgression;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:4",
        "book": "Job",
        "chapter": 8,
        "verse": 4
      },
      {
        "text": "If thou wouldest seek unto God betimes, and make thy supplication to the Almighty;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:5",
        "book": "Job",
        "chapter": 8,
        "verse": 5
      },
      {
        "text": "If thou wert pure and upright; surely now he would awake for thee, and make the habitation of thy righteousness prosperous.",
        "footNotes": [],
        "italics": [
          {
            "start": 8,
            "end": 12
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:6",
        "book": "Job",
        "chapter": 8,
        "verse": 6
      },
      {
        "text": "Though thy beginning was small, yet thy latter end should greatly increase.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:7",
        "book": "Job",
        "chapter": 8,
        "verse": 7
      },
      {
        "text": "For inquire, I pray thee, of the former age, and prepare thyself to the search of their fathers:",
        "footNotes": [
          {
            "start": 40,
            "end": 43,
            "text": "HEB generations."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 8:8",
        "book": "Job",
        "chapter": 8,
        "verse": 8
      },
      {
