        "footNotes": [
          {
            "start": 63,
            "end": 67,
            "text": "TG Death; Man, Physical Creation of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "TG Death; Man, Physical Creation of.",
            "prettyString": "TG Death; TG Man, Physical Creation of",
            "references": [
              {
                "type": "studyHelp",
