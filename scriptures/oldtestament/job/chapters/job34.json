        "jstReferences": [],
        "reference": "Job 34:12",
        "book": "Job",
        "chapter": 34,
        "verse": 12
      },
      {
        "text": "Who hath given him a charge over the earth? or who hath disposed the whole world?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 34:13",
        "book": "Job",
        "chapter": 34,
        "verse": 13
      },
      {
        "text": "If he set his heart upon man, if he gather unto himself his spirit and his breath;",
        "footNotes": [],
        "italics": [
          {
            "start": 30,
            "end": 32
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 34:14",
        "book": "Job",
        "chapter": 34,
        "verse": 14
      },
      {
