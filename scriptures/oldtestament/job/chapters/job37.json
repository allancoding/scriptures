        ],
        "jstReferences": [],
        "reference": "Job 37:14",
        "book": "Job",
        "chapter": 37,
        "verse": 14
      },
      {
        "text": "Dost thou know when God disposed them, and caused the light of his cloud to shine?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 37:15",
        "book": "Job",
        "chapter": 37,
        "verse": 15
      },
      {
        "text": "Dost thou know the balancings of the clouds, the wondrous works of him which is perfect in knowledge?",
        "footNotes": [
          {
            "start": 91,
            "end": 100,
            "text": "TG Knowledge."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "TG Knowledge.",
            "prettyString": "TG Knowledge",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
