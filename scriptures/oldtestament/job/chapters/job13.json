        "jstReferences": [],
        "reference": "Job 13:4",
        "book": "Job",
        "chapter": 13,
        "verse": 4
      },
      {
        "text": "O that ye would altogether hold your peace! and it should be your wisdom.",
        "footNotes": [
          {
            "start": 27,
            "end": 31,
            "text": "Prov. 17:28."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
