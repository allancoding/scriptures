        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 13:10",
        "book": "Job",
        "chapter": 13,
        "verse": 10
      },
      {
        "text": "Shall not his excellency make you afraid? and his dread fall upon you?",
