        "italics": [
          {
            "start": 79,
            "end": 81
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 13:9",
        "book": "Job",
        "chapter": 13,
        "verse": 9
      },
      {
        "text": "He will surely reprove you, if ye do secretly accept persons.",
