        "footNotes": [],
        "italics": [
          {
            "start": 73,
            "end": 78
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 13:13",
        "book": "Job",
        "chapter": 13,
        "verse": 13
      },
      {
        "text": "Wherefore do I take my flesh in my teeth, and put my life in mine hand?",
