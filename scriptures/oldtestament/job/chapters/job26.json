        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 26:8",
        "book": "Job",
        "chapter": 26,
        "verse": 8
      },
      {
