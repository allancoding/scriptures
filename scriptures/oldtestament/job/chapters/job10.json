        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 10:16",
        "book": "Job",
        "chapter": 10,
        "verse": 16
