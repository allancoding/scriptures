        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 10:2",
        "book": "Job",
        "chapter": 10,
        "verse": 2
      },
      {
