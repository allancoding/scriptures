        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 7:10",
        "book": "Job",
        "chapter": 7,
        "verse": 10
