        "book": "Job",
        "chapter": 7,
        "verse": 6
      },
      {
        "text": "O remember that my life is wind: mine eye shall no more see good.",
        "footNotes": [],
        "italics": [
          {
            "start": 24,
            "end": 26
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 7:7",
        "book": "Job",
        "chapter": 7,
        "verse": 7
      },
      {
        "text": "The eye of him that hath seen me shall see me no more: thine eyes are upon me, and I am not.",
        "footNotes": [],
        "italics": [
          {
            "start": 49,
            "end": 54
          },
          {
            "start": 66,
            "end": 69
          },
