                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 3:20",
        "book": "Job",
        "chapter": 3,
        "verse": 20
      },
      {
        "text": "Which long for death, but it cometh not; and dig for it more than for hid treasures;",
        "footNotes": [
          {
            "start": 15,
            "end": 20,
            "text": "Rev. 9:6."
          }
        ],
        "italics": [
          {
            "start": 29,
            "end": 35
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [
          {
            "raw": "Rev. 9:6.",
            "prettyString": "Revelation 9:6",
            "references": [
              {
                "type": "scripture",
                "book": "revelation",
                "chapters": [
                  {
                    "start": 9,
                    "end": 9,
                    "verses": [
                      {
                        "start": 6,
