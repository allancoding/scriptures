  "chapter": {
    "bookTitle": "Job",
    "delineation": "Chapter",
    "number": 33,
    "summary": "Elihu says, God is greater than man, He speaks to man in dreams and visions, He ransoms those cast into the pit, and He delivers their souls and gives them life.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Wherefore, Job, I pray thee, hear my speeches, and hearken to all my words.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 33:1",
        "book": "Job",
        "chapter": 33,
        "verse": 1
      },
      {
        "text": "Behold, now I have opened my mouth, my tongue hath spoken in my mouth.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 33:2",
        "book": "Job",
        "chapter": 33,
        "verse": 2
      },
      {
        "text": "My words shall be of the uprightness of my heart: and my lips shall utter knowledge clearly.",
        "footNotes": [],
        "italics": [
          {
            "start": 9,
            "end": 20
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 33:3",
        "book": "Job",
        "chapter": 33,
        "verse": 3
      },
      {
        "text": "The Spirit of God hath made me, and the breath of the Almighty hath given me life.",
        "footNotes": [
          {
            "start": 4,
            "end": 10,
            "text": "TG God, Spirit of."
          },
          {
            "start": 40,
            "end": 46,
            "text": "TG Breath of Life; Man, a Spirit Child of Heavenly Father."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG God, Spirit of.",
            "prettyString": "TG God, Spirit of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "God, Spirit of",
                "entryId": "tg-god-spirit-of",
                "book": "",
