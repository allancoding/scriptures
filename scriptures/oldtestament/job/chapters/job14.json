        "jstReferences": [],
        "reference": "Job 14:1",
        "book": "Job",
        "chapter": 14,
        "verse": 1
      },
      {
        "text": "He cometh forth like a flower, and is cut down: he fleeth also as a shadow, and continueth not.",
        "footNotes": [
          {
            "start": 38,
            "end": 41,
            "text": "Isa. 38:12 (10–13)."
