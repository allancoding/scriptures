                "entryId": "tg-resurrection",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 14:14",
        "book": "Job",
        "chapter": 14,
        "verse": 14
      },
      {
        "text": "Thou shalt call, and I will answer thee: thou wilt have a desire to the work of thine hands.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:15",
        "book": "Job",
        "chapter": 14,
        "verse": 15
      },
      {
        "text": "For now thou numberest my steps: dost thou not watch over my sin?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:16",
        "book": "Job",
        "chapter": 14,
        "verse": 16
      },
      {
        "text": "My transgression is sealed up in a bag, and thou sewest up mine iniquity.",
        "footNotes": [],
        "italics": [
          {
            "start": 17,
            "end": 19
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:17",
        "book": "Job",
        "chapter": 14,
        "verse": 17
      },
      {
        "text": "And surely the mountain falling cometh to nought, and the rock is removed out of his place.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:18",
        "book": "Job",
        "chapter": 14,
        "verse": 18
      },
      {
        "text": "The waters wear the stones: thou washest away the things which grow out of the dust of the earth; and thou destroyest the hope of man.",
        "footNotes": [],
        "italics": [
          {
            "start": 68,
            "end": 71
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:19",
        "book": "Job",
        "chapter": 14,
        "verse": 19
      },
      {
        "text": "Thou prevailest for ever against him, and he passeth: thou changest his countenance, and sendest him away.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:20",
        "book": "Job",
        "chapter": 14,
        "verse": 20
      },
      {
        "text": "His sons come to honour, and he knoweth it not; and they are brought low, but he perceiveth it not of them.",
        "footNotes": [],
        "italics": [
          {
            "start": 40,
            "end": 42
          },
          {
            "start": 92,
            "end": 94
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:21",
        "book": "Job",
        "chapter": 14,
        "verse": 21
      },
      {
