        "reference": "Job 14:2",
        "book": "Job",
        "chapter": 14,
        "verse": 2
      },
      {
        "text": "And dost thou open thine eyes upon such an one, and bringest me into judgment with thee?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 14:3",
        "book": "Job",
        "chapter": 14,
        "verse": 3
      },
