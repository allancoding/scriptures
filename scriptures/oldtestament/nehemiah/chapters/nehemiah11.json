        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 11:8",
        "book": "Nehemiah",
        "chapter": 11,
        "verse": 8
      },
