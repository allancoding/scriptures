            "end": 50
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 11:6",
        "book": "Nehemiah",
        "chapter": 11,
        "verse": 6
      },
      {
