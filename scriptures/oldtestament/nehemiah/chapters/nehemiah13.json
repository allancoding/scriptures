        "book": "Nehemiah",
        "chapter": 13,
        "verse": 2
      },
      {
        "text": "Now it came to pass, when they had heard the law, that they separated from Israel all the mixed multitude.",
        "footNotes": [
          {
            "start": 90,
            "end": 95,
            "text": "Ex. 12:38."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
