                "entryId": "tg-scriptures-writing-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:4",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 4
      },
      {
        "text": "And Jeremiah commanded Baruch, saying, I am shut up; I cannot go into the house of the Lord:",
        "footNotes": [
          {
            "start": 44,
            "end": 51,
            "text": "HEB under arrest, or in confinement. D&C 122:6 (1–7)."
          }
        ],
        "italics": [
          {
            "start": 41,
            "end": 43
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:5",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 5
      },
      {
        "text": "Therefore go thou, and read in the roll, which thou hast written from my mouth, the words of the Lord in the ears of the people in the Lord’s house upon the fasting day: and also thou shalt read them in the ears of all Judah that come out of their cities.",
        "footNotes": [
          {
            "start": 157,
            "end": 164,
            "text": "Neh. 9:1 (1–3)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:6",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 6
      },
      {
        "text": "It may be they will present their supplication before the Lord, and will return every one from his evil way: for great is the anger and the fury that the Lord hath pronounced against this people.",
        "footNotes": [
          {
            "start": 73,
            "end": 79,
            "text": "2 Kgs. 23:3 (2–3)."
          }
        ],
        "italics": [
          {
            "start": 119,
            "end": 121
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:7",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 7
      },
      {
        "text": "And Baruch the son of Neriah did according to all that Jeremiah the prophet commanded him, reading in the book the words of the Lord in the Lord’s house.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:8",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 8
      },
      {
        "text": "And it came to pass in the fifth year of Jehoiakim the son of Josiah king of Judah, in the ninth month, that they proclaimed a fast before the Lord to all the people in Jerusalem, and to all the people that came from the cities of Judah unto Jerusalem.",
        "footNotes": [],
        "italics": [
          {
            "start": 104,
            "end": 108
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:9",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 9
      },
      {
        "text": "Then read Baruch in the book the words of Jeremiah in the house of the Lord, in the chamber of Gemariah the son of Shaphan the scribe, in the higher court, at the entry of the new gate of the Lord’s house, in the ears of all the people.",
        "footNotes": [
          {
            "start": 115,
            "end": 122,
            "text": "Jer. 26:24."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "Jer. 26:24.",
            "prettyString": "Jeremiah 26:24",
            "references": [
              {
                "type": "scripture",
                "book": "jeremiah",
                "chapters": [
                  {
                    "start": 26,
                    "end": 26,
                    "verses": [
                      {
                        "start": 24,
                        "end": 24
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:10",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 10
      },
      {
        "text": "When Michaiah the son of Gemariah, the son of Shaphan, had heard out of the book all the words of the Lord,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:11",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 11
      },
      {
        "text": "Then he went down into the king’s house, into the scribe’s chamber: and, lo, all the princes sat there, even Elishama the scribe, and Delaiah the son of Shemaiah, and Elnathan the son of Achbor, and Gemariah the son of Shaphan, and Zedekiah the son of Hananiah, and all the princes.",
        "footNotes": [
          {
            "start": 85,
            "end": 92,
            "text": "OR officers or officials."
          },
          {
            "start": 167,
            "end": 175,
            "text": "Jer. 26:22."
          }
        ],
        "italics": [
          {
            "start": 104,
            "end": 108
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "Jer. 26:22.",
            "prettyString": "Jeremiah 26:22",
            "references": [
              {
                "type": "scripture",
                "book": "jeremiah",
                "chapters": [
                  {
                    "start": 26,
                    "end": 26,
                    "verses": [
                      {
                        "start": 22,
                        "end": 22
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:12",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 12
      },
      {
        "text": "Then Michaiah declared unto them all the words that he had heard, when Baruch read the book in the ears of the people.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:13",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 13
      },
      {
        "text": "Therefore all the princes sent Jehudi the son of Nethaniah, the son of Shelemiah, the son of Cushi, unto Baruch, saying, Take in thine hand the roll wherein thou hast read in the ears of the people, and come. So Baruch the son of Neriah took the roll in his hand, and came unto them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:14",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 14
      },
      {
        "text": "And they said unto him, Sit down now, and read it in our ears. So Baruch read it in their ears.",
        "footNotes": [],
        "italics": [
          {
            "start": 78,
            "end": 80
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:15",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 15
      },
      {
        "text": "Now it came to pass, when they had heard all the words, they were afraid both one and other, and said unto Baruch, We will surely tell the king of all these words.",
        "footNotes": [
          {
            "start": 66,
            "end": 72,
            "text": "Mosiah 4:1 (1–2)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:16",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 16
      },
      {
        "text": "And they asked Baruch, saying, Tell us now, How didst thou write all these words at his mouth?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:17",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 17
      },
      {
        "text": "Then Baruch answered them, He pronounced all these words unto me with his mouth, and I wrote them with ink in the book.",
        "footNotes": [],
        "italics": [
          {
            "start": 93,
            "end": 97
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:18",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 18
      },
      {
        "text": "Then said the princes unto Baruch, Go, hide thee, thou and Jeremiah; and let no man know where ye be.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:19",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 19
      },
      {
        "text": "And they went in to the king into the court, but they laid up the roll in the chamber of Elishama the scribe, and told all the words in the ears of the king.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:20",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 20
      },
      {
        "text": "So the king sent Jehudi to fetch the roll: and he took it out of Elishama the scribe’s chamber. And Jehudi read it in the ears of the king, and in the ears of all the princes which stood beside the king.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:21",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 21
      },
      {
        "text": "Now the king sat in the winterhouse in the ninth month: and there was a fire on the hearth burning before him.",
        "footNotes": [
          {
            "start": 24,
            "end": 35,
            "text": "Amos 3:15."
          }
        ],
        "italics": [
          {
            "start": 60,
            "end": 76
          }
        ],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [
          {
            "raw": "Amos 3:15.",
            "prettyString": "Amos 3:15",
            "references": [
              {
                "type": "scripture",
                "book": "amos",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 15,
                        "end": 15
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:22",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 22
      },
      {
        "text": "And it came to pass, that when Jehudi had read three or four leaves, he cut it with the penknife, and cast it into the fire that was on the hearth, until all the roll was consumed in the fire that was on the hearth.",
        "footNotes": [],
        "italics": [
          {
            "start": 21,
            "end": 25
          },
          {
            "start": 107,
            "end": 109
          },
          {
            "start": 129,
            "end": 132
          },
          {
            "start": 197,
            "end": 200
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:23",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 23
      },
      {
        "text": "Yet they were not afraid, nor rent their garments, neither the king, nor any of his servants that heard all these words.",
        "footNotes": [],
        "italics": [
          {
            "start": 51,
            "end": 58
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:24",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 24
      },
      {
        "text": "Nevertheless Elnathan and Delaiah and Gemariah had made intercession to the king that he would not burn the roll: but he would not hear them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:25",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 25
      },
      {
        "text": "But the king commanded Jerahmeel the son of Hammelech, and Seraiah the son of Azriel, and Shelemiah the son of Abdeel, to take Baruch the scribe and Jeremiah the prophet: but the Lord hid them.",
        "footNotes": [
          {
            "start": 44,
            "end": 53,
            "text": "HEB the king."
          },
          {
            "start": 184,
            "end": 187,
            "text": "1 Ne. 3:27."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [
          {
            "raw": "1 Ne. 3:27.",
            "prettyString": "1 Nephi 3:27",
            "references": [
              {
                "type": "scripture",
                "book": "1nephi",
                "chapters": [
                  {
                    "start": 3,
                    "end": 3,
                    "verses": [
                      {
                        "start": 27,
                        "end": 27
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:26",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 26
      },
      {
        "text": "Then the word of the Lord came to Jeremiah, after that the king had burned the roll, and the words which Baruch wrote at the mouth of Jeremiah, saying,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 27,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:27",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 27
      },
      {
        "text": "Take thee again another roll, and write in it all the former words that were in the first roll, which Jehoiakim the king of Judah hath burned.",
        "footNotes": [
          {
            "start": 34,
            "end": 39,
            "text": "TG Scriptures, Preservation of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 28,
        "crossReferences": [
          {
            "raw": "TG Scriptures, Preservation of.",
            "prettyString": "TG Scriptures, Preservation of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Scriptures, Preservation of",
                "entryId": "tg-scriptures-preservation-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 36:28",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 28
      },
      {
        "text": "And thou shalt say to Jehoiakim king of Judah, Thus saith the Lord; Thou hast burned this roll, saying, Why hast thou written therein, saying, The king of Babylon shall certainly come and destroy this land, and shall cause to cease from thence man and beast?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 29,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:29",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 29
      },
      {
        "text": "Therefore thus saith the Lord of Jehoiakim king of Judah; He shall have none to sit upon the throne of David: and his dead body shall be cast out in the day to the heat, and in the night to the frost.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 30,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:30",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 30
      },
      {
        "text": "And I will punish him and his seed and his servants for their iniquity; and I will bring upon them, and upon the inhabitants of Jerusalem, and upon the men of Judah, all the evil that I have pronounced against them; but they hearkened not.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 31,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:31",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 31
      },
      {
        "text": "Then took Jeremiah another roll, and gave it to Baruch the scribe, the son of Neriah; who wrote therein from the mouth of Jeremiah all the words of the book which Jehoiakim king of Judah had burned in the fire: and there were added besides unto them many like words.",
        "footNotes": [
