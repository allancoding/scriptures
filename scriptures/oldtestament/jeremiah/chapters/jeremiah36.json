  "chapter": {
    "bookTitle": "Jeremiah",
    "delineation": "Chapter",
    "number": 36,
    "summary": "Baruch writes the prophecies of Jeremiah and reads them in the house of the Lord—Jehoiakim, the king, burns the book, and judgment comes upon him—Jeremiah dictates the prophecies again and adds many more.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And it came to pass in the fourth year of Jehoiakim the son of Josiah king of Judah, that this word came unto Jeremiah from the Lord, saying,",
        "footNotes": [],
        "italics": [
          {
            "start": 85,
            "end": 89
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 36:1",
        "book": "Jeremiah",
        "chapter": 36,
        "verse": 1
      },
      {
        "text": "Take thee a roll of a book, and write therein all the words that I have spoken unto thee against Israel, and against Judah, and against all the nations, from the day I spake unto thee, from the days of Josiah, even unto this day.",
        "footNotes": [
          {
            "start": 12,
            "end": 16,
            "text": "Ezra 6:2; Ezek. 2:9."
          },
          {
            "start": 225,
            "end": 228,
            "text": "Jer. 1:2; 25:3."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
