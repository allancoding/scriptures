                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "Gen. 15:17.",
            "prettyString": "Genesis 15:17",
            "references": [
              {
                "type": "scripture",
                "book": "genesis",
                "chapters": [
                  {
                    "start": 15,
                    "end": 15,
                    "verses": [
                      {
                        "start": 17,
