            "end": 108
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 50:6",
        "book": "Jeremiah",
        "chapter": 50,
        "verse": 6
      },
      {
        "text": "All that found them have devoured them: and their adversaries said, We offend not, because they have sinned against the Lord, the habitation of justice, even the Lord, the hope of their fathers.",
        "footNotes": [
          {
            "start": 71,
            "end": 81,
            "text": "HEB are not guilty."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 50:7",
        "book": "Jeremiah",
        "chapter": 50,
        "verse": 7
      },
      {
        "text": "Remove out of the midst of Babylon, and go forth out of the land of the Chaldeans, and be as the he goats before the flocks.",
        "footNotes": [
          {
            "start": 0,
            "end": 6,
            "text": "TG Separation."
