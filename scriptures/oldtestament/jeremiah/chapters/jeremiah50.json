        "jstReferences": [],
        "reference": "Jeremiah 50:19",
        "book": "Jeremiah",
        "chapter": 50,
        "verse": 19
      },
      {
        "text": "In those days, and in that time, saith the Lord, the iniquity of Israel shall be sought for, and there shall be none; and the sins of Judah, and they shall not be found: for I will pardon them whom I reserve.",
        "footNotes": [
          {
            "start": 181,
            "end": 187,
            "text": "TG Forgive."
          }
        ],
        "italics": [
          {
            "start": 97,
            "end": 111
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [
          {
            "raw": "TG Forgive.",
            "prettyString": "TG Forgive",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Forgive",
                "entryId": "tg-forgive",
                "book": "",
