          {
            "start": 51,
            "end": 54
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [
          {
            "raw": "Num. 24:8.",
            "prettyString": "Numbers 24:8",
            "references": [
