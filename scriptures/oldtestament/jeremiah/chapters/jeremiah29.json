        "jstReferences": [],
        "reference": "Jeremiah 29:3",
        "book": "Jeremiah",
        "chapter": 29,
        "verse": 3
      },
      {
        "text": "Thus saith the Lord of hosts, the God of Israel, unto all that are carried away captives, whom I have caused to be carried away from Jerusalem unto Babylon;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 29:4",
        "book": "Jeremiah",
        "chapter": 29,
        "verse": 4
      },
      {
