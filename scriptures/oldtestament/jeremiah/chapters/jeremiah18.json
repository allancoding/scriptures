  "chapter": {
    "bookTitle": "Jeremiah",
    "delineation": "Chapter",
    "number": 18,
    "summary": "Israel is as potter’s clay in the hands of the Lord—If nations repent, the Lord withholds the evil decreed against them—The people of Judah will be scattered.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "The word which came to Jeremiah from the Lord, saying,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 18:1",
        "book": "Jeremiah",
        "chapter": 18,
        "verse": 1
      },
      {
        "text": "Arise, and go down to the potter’s house, and there I will cause thee to hear my words.",
        "footNotes": [
          {
            "start": 26,
            "end": 34,
            "text": "Jer. 19:1 (1–2)."
