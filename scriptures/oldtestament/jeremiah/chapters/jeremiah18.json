        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 18:8",
        "book": "Jeremiah",
        "chapter": 18,
        "verse": 8
      },
      {
        "text": "And at what instant I shall speak concerning a nation, and concerning a kingdom, to build and to plant it;",
        "footNotes": [],
        "italics": [
          {
