          {
            "start": 48,
            "end": 54,
            "text": "Isa. 45:9; Rom. 9:21; 2 Ne. 27:27."
          }
        ],
        "italics": [
          {
            "start": 92,
            "end": 94
          },
          {
            "start": 120,
            "end": 123
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
