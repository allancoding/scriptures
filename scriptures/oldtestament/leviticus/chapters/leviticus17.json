        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 17:7",
        "book": "Leviticus",
        "chapter": 17,
        "verse": 7
      },
      {
