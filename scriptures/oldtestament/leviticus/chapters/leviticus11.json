        "italics": [
          {
            "start": 72,
            "end": 74
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 11:6",
        "book": "Leviticus",
        "chapter": 11,
        "verse": 6
      },
      {
