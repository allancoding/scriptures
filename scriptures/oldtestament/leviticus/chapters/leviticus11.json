        "crossReferences": [],
        "jstReferences": [],
        "reference": "Leviticus 11:8",
        "book": "Leviticus",
        "chapter": 11,
        "verse": 8
      },
      {
        "text": "These shall ye eat of all that are in the waters: whatsoever hath fins and scales in the waters, in the seas, and in the rivers, them shall ye eat.",
