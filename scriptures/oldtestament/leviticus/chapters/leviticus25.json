                "title": "Sabbatical Year",
                "entryId": "tg-sabbatical-year",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Leviticus 25:2",
        "book": "Leviticus",
        "chapter": 25,
        "verse": 2
      },
      {
        "text": "Six years thou shalt sow thy field, and six years thou shalt prune thy vineyard, and gather in the fruit thereof;",
