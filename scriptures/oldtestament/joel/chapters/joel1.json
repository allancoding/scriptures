    "delineation": "Chapter",
    "number": 1,
    "summary": "Call a solemn assembly and gather to the house of the Lord, for the day of the Lord is at hand.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "The word of the Lord that came to Joel the son of Pethuel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joel 1:1",
        "book": "Joel",
        "chapter": 1,
        "verse": 1
      },
      {
        "text": "Hear this, ye old men, and give ear, all ye inhabitants of the land. Hath this been in your days, or even in the days of your fathers?",
