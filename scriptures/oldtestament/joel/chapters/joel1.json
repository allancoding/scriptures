          {
            "start": 14,
            "end": 21,
            "text": "HEB elders."
          },
          {
            "start": 44,
            "end": 55,
            "text": "D&C 1:6."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "D&C 1:6.",
            "prettyString": "D&C 1:6",
            "references": [
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
