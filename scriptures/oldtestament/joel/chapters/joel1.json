            "text": "Rev. 9:16."
          },
          {
            "start": 72,
            "end": 77,
            "text": "Rev. 9:8."
          }
        ],
        "italics": [
          {
            "start": 78,
            "end": 81
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
