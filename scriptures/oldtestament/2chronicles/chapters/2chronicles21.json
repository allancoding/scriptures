                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Chronicles 21:20",
        "book": "2 Chronicles",
        "chapter": 21,
        "verse": 20
      }
    ]
  },
