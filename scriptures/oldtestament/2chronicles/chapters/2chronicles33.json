                "entryId": "tg-heathen",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Chronicles 33:9",
        "book": "2 Chronicles",
        "chapter": 33,
        "verse": 9
      },
      {
        "text": "And the Lord spake to Manasseh, and to his people: but they would not hearken.",
        "footNotes": [
          {
            "start": 70,
            "end": 77,
            "text": "Alma 5:37; 10:6 (5–6)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Chronicles 33:10",
        "book": "2 Chronicles",
        "chapter": 33,
        "verse": 10
      },
      {
        "text": "Wherefore the Lord brought upon them the captains of the host of the king of Assyria, which took Manasseh among the thorns, and bound him with fetters, and carried him to Babylon.",
        "footNotes": [
          {
            "start": 106,
            "end": 122,
            "text": "HEB with hooks."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Chronicles 33:11",
        "book": "2 Chronicles",
        "chapter": 33,
        "verse": 11
      },
      {
        "text": "And when he was in affliction, he besought the Lord his God, and humbled himself greatly before the God of his fathers,",
        "footNotes": [
          {
            "start": 19,
            "end": 29,
            "text": "TG Affliction."
          },
          {
            "start": 34,
            "end": 42,
            "text": "D&C 101:8 (7–9)."
          },
          {
            "start": 65,
            "end": 72,
            "text": "Alma 32:12 (6, 12–16)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "TG Affliction.",
            "prettyString": "TG Affliction",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Affliction",
                "entryId": "tg-affliction",
                "book": "",
                "chapters": []
