                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "TG Spirits, Evil or Unclean.",
            "prettyString": "TG Spirits, Evil or Unclean",
            "references": [
              {
                "type": "studyHelp",
