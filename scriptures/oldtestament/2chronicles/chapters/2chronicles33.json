        "jstReferences": [],
        "reference": "2 Chronicles 33:12",
        "book": "2 Chronicles",
        "chapter": 33,
        "verse": 12
      },
      {
        "text": "And prayed unto him: and he was entreated of him, and heard his supplication, and brought him again to Jerusalem into his kingdom. Then Manasseh knew that the Lord he was God.",
        "footNotes": [
          {
            "start": 32,
            "end": 41,
            "text": "Gen. 25:21."
          },
          {
            "start": 136,
            "end": 144,
            "text": "Hel. 12:3 (2–3)."
          }
        ],
        "italics": [
          {
            "start": 167,
            "end": 170
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "Gen. 25:21.",
            "prettyString": "Genesis 25:21",
            "references": [
              {
                "type": "scripture",
                "book": "genesis",
                "chapters": [
                  {
                    "start": 25,
                    "end": 25,
                    "verses": [
