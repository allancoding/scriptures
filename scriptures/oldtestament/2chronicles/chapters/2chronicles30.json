        "footNotes": [
          {
            "start": 13,
            "end": 19,
            "text": "IE some."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Chronicles 30:11",
        "book": "2 Chronicles",
        "chapter": 30,
        "verse": 11
      },
      {
