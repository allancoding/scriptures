        "footNotes": [
          {
            "start": 66,
            "end": 76,
            "text": "TG Bread, Unleavened; Passover."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
