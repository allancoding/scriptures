            "end": 85
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Amos 2:11",
        "book": "Amos",
        "chapter": 2,
        "verse": 11
      },
      {
        "text": "But ye gave the Nazarites wine to drink; and commanded the prophets, saying, Prophesy not.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Amos 2:12",
        "book": "Amos",
        "chapter": 2,
        "verse": 12
