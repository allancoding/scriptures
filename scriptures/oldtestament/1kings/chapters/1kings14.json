        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Kings 14:16",
        "book": "1 Kings",
        "chapter": 14,
        "verse": 16
      },
      {
        "text": "And Jeroboam’s wife arose, and departed, and came to Tirzah: and when she came to the threshold of the door, the child died;",
        "footNotes": [],
        "italics": [
          {
            "start": 61,
            "end": 64
