        "italics": [
          {
            "start": 126,
            "end": 130
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Kings 17:14",
        "book": "1 Kings",
        "chapter": 17,
        "verse": 14
      },
