          {
            "start": 33,
            "end": 35,
            "text": "OR from Tishbe in Gilead."
          },
          {
            "start": 161,
            "end": 165,
            "text": "TG Drought; Famine."
          },
          {
            "start": 199,
            "end": 203,
            "text": "Hel. 10:5 (3–7)."
