                        "end": 19
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 4:3",
        "book": "Judges",
        "chapter": 4,
        "verse": 3
      },
      {
        "text": "And Deborah, a prophetess, the wife of Lapidoth, she judged Israel at that time.",
        "footNotes": [
          {
            "start": 15,
            "end": 25,
            "text": "Ex. 15:20 (20–21); Acts 21:9 (8–9). TG Woman."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:4",
        "book": "Judges",
        "chapter": 4,
        "verse": 4
      },
      {
        "text": "And she dwelt under the palm tree of Deborah between Ramah and Beth-el in mount Ephraim: and the children of Israel came up to her for judgment.",
        "footNotes": [
          {
            "start": 8,
            "end": 13,
            "text": "HEB used to sit or remain."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:5",
        "book": "Judges",
        "chapter": 4,
        "verse": 5
      },
      {
        "text": "And she sent and called Barak the son of Abinoam out of Kedesh-naphtali, and said unto him, Hath not the Lord God of Israel commanded, saying, Go and draw toward mount Tabor, and take with thee ten thousand men of the children of Naphtali and of the children of Zebulun?",
        "footNotes": [
          {
            "start": 24,
            "end": 29,
            "text": "Heb. 11:32."
          }
        ],
        "italics": [
          {
            "start": 135,
            "end": 142
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
            "raw": "Heb. 11:32.",
            "prettyString": "Hebrews 11:32",
            "references": [
              {
                "type": "scripture",
                "book": "hebrews",
                "chapters": [
                  {
                    "start": 11,
                    "end": 11,
                    "verses": [
                      {
                        "start": 32,
                        "end": 32
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 4:6",
        "book": "Judges",
        "chapter": 4,
        "verse": 6
      },
      {
        "text": "And I will draw unto thee to the river Kishon Sisera, the captain of Jabin’s army, with his chariots and his multitude; and I will deliver him into thine hand.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:7",
        "book": "Judges",
        "chapter": 4,
        "verse": 7
      },
      {
        "text": "And Barak said unto her, If thou wilt go with me, then I will go: but if thou wilt not go with me, then I will not go.",
        "footNotes": [],
        "italics": [
          {
            "start": 99,
            "end": 103
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:8",
        "book": "Judges",
        "chapter": 4,
        "verse": 8
      },
      {
        "text": "And she said, I will surely go with thee: notwithstanding the journey that thou takest shall not be for thine honour; for the Lord shall sell Sisera into the hand of a woman. And Deborah arose, and went with Barak to Kedesh.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:9",
        "book": "Judges",
        "chapter": 4,
        "verse": 9
      },
      {
        "text": "And Barak called Zebulun and Naphtali to Kedesh; and he went up with ten thousand men at his feet: and Deborah went up with him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:10",
        "book": "Judges",
        "chapter": 4,
        "verse": 10
      },
      {
        "text": "Now Heber the Kenite, which was of the children of Hobab the father in law of Moses, had severed himself from the Kenites, and pitched his tent unto the plain of Zaanaim, which is by Kedesh.",
        "footNotes": [],
        "italics": [
          {
            "start": 22,
            "end": 31
          },
          {
            "start": 177,
            "end": 179
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:11",
        "book": "Judges",
        "chapter": 4,
        "verse": 11
      },
      {
        "text": "And they shewed Sisera that Barak the son of Abinoam was gone up to mount Tabor.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:12",
        "book": "Judges",
        "chapter": 4,
        "verse": 12
      },
      {
        "text": "And Sisera gathered together all his chariots, even nine hundred chariots of iron, and all the people that were with him, from Harosheth of the Gentiles unto the river of Kishon.",
        "footNotes": [],
        "italics": [
          {
            "start": 47,
            "end": 51
          },
          {
            "start": 107,
            "end": 111
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:13",
        "book": "Judges",
        "chapter": 4,
        "verse": 13
      },
      {
        "text": "And Deborah said unto Barak, Up; for this is the day in which the Lord hath delivered Sisera into thine hand: is not the Lord gone out before thee? So Barak went down from mount Tabor, and ten thousand men after him.",
        "footNotes": [
          {
            "start": 135,
            "end": 141,
            "text": "Deut. 9:3; Ether 1:42 (42–43); D&C 84:88 (87–88)."
          }
        ],
        "italics": [
          {
            "start": 42,
            "end": 44
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:14",
        "book": "Judges",
        "chapter": 4,
        "verse": 14
      },
      {
        "text": "And the Lord discomfited Sisera, and all his chariots, and all his host, with the edge of the sword before Barak; so that Sisera lighted down off his chariot, and fled away on his feet.",
        "footNotes": [
          {
            "start": 13,
            "end": 24,
            "text": "OR panicked, put to flight."
          },
          {
            "start": 25,
            "end": 31,
            "text": "Ps. 83:9."
          }
        ],
        "italics": [
          {
            "start": 41,
            "end": 44
          },
          {
            "start": 63,
            "end": 66
          },
          {
            "start": 146,
            "end": 149
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "Ps. 83:9.",
            "prettyString": "Psalms 83:9",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 83,
                    "end": 83,
                    "verses": [
                      {
                        "start": 9,
                        "end": 9
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 4:15",
        "book": "Judges",
        "chapter": 4,
        "verse": 15
      },
      {
        "text": "But Barak pursued after the chariots, and after the host, unto Harosheth of the Gentiles: and all the host of Sisera fell upon the edge of the sword; and there was not a man left.",
        "footNotes": [],
        "italics": [
          {
            "start": 150,
            "end": 153
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:16",
        "book": "Judges",
        "chapter": 4,
        "verse": 16
      },
      {
        "text": "Howbeit Sisera fled away on his feet to the tent of Jael the wife of Heber the Kenite: for there was peace between Jabin the king of Hazor and the house of Heber the Kenite.",
        "footNotes": [],
        "italics": [
          {
            "start": 91,
            "end": 100
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:17",
        "book": "Judges",
        "chapter": 4,
        "verse": 17
      },
      {
        "text": "And Jael went out to meet Sisera, and said unto him, Turn in, my lord, turn in to me; fear not. And when he had turned in unto her into the tent, she covered him with a mantle.",
        "footNotes": [
          {
            "start": 169,
            "end": 175,
            "text": "HEB rug, thick coverlet, or blanket."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:18",
        "book": "Judges",
        "chapter": 4,
        "verse": 18
      },
      {
        "text": "And he said unto her, Give me, I pray thee, a little water to drink; for I am thirsty. And she opened a bottle of milk, and gave him drink, and covered him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:19",
        "book": "Judges",
        "chapter": 4,
        "verse": 19
      },
      {
        "text": "Again he said unto her, Stand in the door of the tent, and it shall be, when any man doth come and inquire of thee, and say, Is there any man here? that thou shalt say, No.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:20",
        "book": "Judges",
        "chapter": 4,
        "verse": 20
      },
      {
        "text": "Then Jael Heber’s wife took a nail of the tent, and took an hammer in her hand, and went softly unto him, and smote the nail into his temples, and fastened it into the ground: for he was fast asleep and weary. So he died.",
        "footNotes": [
          {
            "start": 120,
            "end": 124,
            "text": "HEB tent peg or pin."
          },
          {
            "start": 134,
            "end": 141,
            "text": "Judg. 5:26 (25–27)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:21",
        "book": "Judges",
        "chapter": 4,
        "verse": 21
      },
      {
        "text": "And, behold, as Barak pursued Sisera, Jael came out to meet him, and said unto him, Come, and I will shew thee the man whom thou seekest. And when he came into her tent, behold, Sisera lay dead, and the nail was in his temples.",
        "footNotes": [],
        "italics": [
          {
            "start": 164,
            "end": 169
          },
          {
            "start": 208,
            "end": 211
          }
        ],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:22",
        "book": "Judges",
        "chapter": 4,
        "verse": 22
      },
      {
        "text": "So God subdued on that day Jabin the king of Canaan before the children of Israel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:23",
        "book": "Judges",
        "chapter": 4,
        "verse": 23
      },
      {
        "text": "And the hand of the children of Israel prospered, and prevailed against Jabin the king of Canaan, until they had destroyed Jabin king of Canaan.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:24",
        "book": "Judges",
        "chapter": 4,
        "verse": 24
      }
    ]
  },
