  "chapter": {
    "bookTitle": "Judges",
    "delineation": "Chapter",
    "number": 4,
    "summary": "Deborah, a prophetess, judges Israel—She and Barak deliver Israel from the Canaanites—Jael, a woman, slays Sisera, the Canaanite.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And the children of Israel again did evil in the sight of the Lord, when Ehud was dead.",
        "footNotes": [
          {
            "start": 37,
            "end": 41,
            "text": "Judg. 3:7 (5–7); 3 Ne. 30:2; Abr. 1:6 (5–7)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 4:1",
        "book": "Judges",
        "chapter": 4,
        "verse": 1
      },
      {
        "text": "And the Lord sold them into the hand of Jabin king of Canaan, that reigned in Hazor; the captain of whose host was Sisera, which dwelt in Harosheth of the Gentiles.",
        "footNotes": [
          {
            "start": 13,
            "end": 17,
            "text": "2 Ne. 7:1."
          }
        ],
        "italics": [
          {
            "start": 111,
            "end": 114
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
