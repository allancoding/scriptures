                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 4:2",
        "book": "Judges",
        "chapter": 4,
        "verse": 2
      },
      {
        "text": "And the children of Israel cried unto the Lord: for he had nine hundred chariots of iron; and twenty years he mightily oppressed the children of Israel.",
        "footNotes": [
          {
            "start": 72,
            "end": 80,
            "text": "Josh. 17:16; Judg. 1:19."
          },
          {
            "start": 110,
            "end": 118,
            "text": "HEB forcibly, violently."
          },
          {
            "start": 119,
            "end": 128,
            "text": "Ps. 106:42 (42–43)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "Josh. 17:16; Judg. 1:19.",
            "prettyString": "Joshua 17:16; Judges 1:19",
            "references": [
              {
                "type": "scripture",
                "book": "joshua",
                "chapters": [
                  {
                    "start": 17,
                    "end": 17,
                    "verses": [
                      {
                        "start": 16,
