        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 18:25",
        "book": "Judges",
        "chapter": 18,
        "verse": 25
      },
