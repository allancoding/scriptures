        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 18:14",
        "book": "Judges",
        "chapter": 18,
        "verse": 14
      },
      {
        "text": "And they turned thitherward, and came to the house of the young man the Levite, even unto the house of Micah, and saluted him.",
        "footNotes": [
          {
            "start": 114,
            "end": 125,
            "text": "HEB asked him concerning his welfare. 1 Sam. 10:4; 13:10."
