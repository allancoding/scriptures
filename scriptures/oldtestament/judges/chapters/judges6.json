        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 6:8",
        "book": "Judges",
        "chapter": 6,
        "verse": 8
      },
      {
