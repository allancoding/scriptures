  "chapter": {
    "bookTitle": "Judges",
    "delineation": "Chapter",
    "number": 6,
    "summary": "Israel is in bondage to the Midianites—An angel appears to Gideon and calls him to deliver Israel—He overthrows the altar of Baal, the Spirit of the Lord rests upon him, and the Lord gives him a sign to show he is called to deliver Israel.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And the children of Israel did evil in the sight of the Lord: and the Lord delivered them into the hand of Midian seven years.",
