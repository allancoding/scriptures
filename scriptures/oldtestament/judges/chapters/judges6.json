        "italics": [
          {
            "start": 49,
            "end": 52
          },
          {
            "start": 127,
            "end": 130
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 6:2",
        "book": "Judges",
        "chapter": 6,
        "verse": 2
      },
      {
