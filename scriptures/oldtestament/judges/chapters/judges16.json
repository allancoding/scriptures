          },
          {
            "start": 176,
            "end": 182
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "Judg. 14:16.",
            "prettyString": "Judges 14:16",
            "references": [
