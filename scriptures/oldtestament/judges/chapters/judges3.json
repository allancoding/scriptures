                        "end": 3
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 3:3",
        "book": "Judges",
        "chapter": 3,
        "verse": 3
      },
      {
        "text": "And they were to prove Israel by them, to know whether they would hearken unto the commandments of the Lord, which he commanded their fathers by the hand of Moses.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 3:4",
        "book": "Judges",
        "chapter": 3,
        "verse": 4
      },
      {
        "text": "And the children of Israel dwelt among the Canaanites, Hittites, and Amorites, and Perizzites, and Hivites, and Jebusites:",
        "footNotes": [
          {
            "start": 27,
            "end": 32,
            "text": "Ps. 106:35."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "Ps. 106:35.",
            "prettyString": "Psalms 106:35",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 106,
                    "end": 106,
                    "verses": [
                      {
                        "start": 35,
                        "end": 35
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 3:5",
        "book": "Judges",
        "chapter": 3,
        "verse": 5
      },
      {
        "text": "And they took their daughters to be their wives, and gave their daughters to their sons, and served their gods.",
        "footNotes": [
          {
            "start": 53,
            "end": 57,
            "text": "TG Marriage, Interfaith."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
            "raw": "TG Marriage, Interfaith.",
            "prettyString": "TG Marriage, Interfaith",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Marriage, Interfaith",
                "entryId": "tg-marriage-interfaith",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Judges 3:6",
        "book": "Judges",
        "chapter": 3,
        "verse": 6
      },
      {
        "text": "And the children of Israel did evil in the sight of the Lord, and forgat the Lord their God, and served Baalim and the groves.",
        "footNotes": [
          {
