            "end": 35,
            "text": "TG Apostasy of Israel."
          },
          {
            "start": 97,
            "end": 103,
            "text": "Judg. 4:1."
          },
          {
            "start": 104,
            "end": 110,
            "text": "Hosea 2:13."
          },
          {
            "start": 119,
            "end": 125,
            "text": "HEB asheroth; fertility cult goddesses. TG Idolatry."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "TG Apostasy of Israel.",
            "prettyString": "TG Apostasy of Israel",
            "references": [
              {
