        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 20:3",
        "book": "Judges",
        "chapter": 20,
        "verse": 3
      },
      {
        "text": "And the Levite, the husband of the woman that was slain, answered and said, I came into Gibeah that belongeth to Benjamin, I and my concubine, to lodge.",
        "footNotes": [
          {
            "start": 88,
            "end": 94,
            "text": "Hosea 10:9."
