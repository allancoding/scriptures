        "associatedContent": [],
        "verseNumber": 32,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 20:32",
        "book": "Judges",
        "chapter": 20,
        "verse": 32
      },
      {
        "text": "And all the men of Israel rose up out of their place, and put themselves in array at Baal-tamar: and the liers in wait of Israel came forth out of their places, even out of the meadows of Gibeah.",
        "footNotes": [],
        "italics": [
