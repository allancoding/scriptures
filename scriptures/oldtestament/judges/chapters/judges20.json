        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 20:22",
        "book": "Judges",
        "chapter": 20,
        "verse": 22
      },
      {
        "text": "(And the children of Israel went up and wept before the Lord until even, and asked counsel of the Lord, saying, Shall I go up again to battle against the children of Benjamin my brother? And the Lord said, Go up against him.)",
        "footNotes": [],
        "italics": [],
