        "jstReferences": [],
        "reference": "Judges 20:35",
        "book": "Judges",
        "chapter": 20,
        "verse": 35
      },
      {
        "text": "So the children of Benjamin saw that they were smitten: for the men of Israel gave place to the Benjamites, because they trusted unto the liers in wait which they had set beside Gibeah.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 36,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 20:36",
        "book": "Judges",
        "chapter": 20,
        "verse": 36
      },
