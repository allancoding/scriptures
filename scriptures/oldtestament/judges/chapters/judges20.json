        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 20:8",
        "book": "Judges",
        "chapter": 20,
        "verse": 8
      },
      {
        "text": "But now this shall be the thing which we will do to Gibeah; we will go up by lot against it;",
        "footNotes": [],
        "italics": [
          {
            "start": 13,
            "end": 21
