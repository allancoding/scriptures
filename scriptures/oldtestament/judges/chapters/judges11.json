        "italics": [
          {
            "start": 130,
            "end": 137
          }
        ],
        "associatedContent": [],
        "verseNumber": 34,
        "crossReferences": [
          {
            "raw": "1 Sam. 18:6.",
            "prettyString": "1 Samuel 18:6",
            "references": [
              {
                "type": "scripture",
                "book": "1samuel",
                "chapters": [
                  {
                    "start": 18,
