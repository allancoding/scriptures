  "chapter": {
    "bookTitle": "Judges",
    "delineation": "Chapter",
    "number": 11,
    "summary": "Jephthah is chosen as the captain of the armies of Israel—The Ammonites assail Israel in war—Jephthah is guided by the Spirit and defeats Ammon with a great slaughter—He makes a rash vow, which leads to the sacrifice of his only daughter.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Now Jephthah the Gileadite was a mighty man of valour, and he was the son of an harlot: and Gilead begat Jephthah.",
        "footNotes": [
          {
            "start": 4,
            "end": 12,
            "text": "1 Sam. 12:11."
          }
        ],
        "italics": [
          {
            "start": 62,
            "end": 65
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
            "raw": "1 Sam. 12:11.",
            "prettyString": "1 Samuel 12:11",
            "references": [
              {
                "type": "scripture",
                "book": "1samuel",
                "chapters": [
                  {
                    "start": 12,
                    "end": 12,
                    "verses": [
