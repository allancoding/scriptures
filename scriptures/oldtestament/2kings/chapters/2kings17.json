            "start": 11,
            "end": 25
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 17:2",
        "book": "2 Kings",
        "chapter": 17,
        "verse": 2
      },
      {
        "text": "Against him came up Shalmaneser king of Assyria; and Hoshea became his servant, and gave him presents.",
