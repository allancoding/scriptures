                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 11:10",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 10
      },
      {
        "text": "And the guard stood, every man with his weapons in his hand, round about the king, from the right corner of the temple to the left corner of the temple, along by the altar and the temple.",
        "footNotes": [],
        "italics": [
          {
            "start": 153,
            "end": 158
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 11:11",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 11
      },
      {
        "text": "And he brought forth the king’s son, and put the crown upon him, and gave him the testimony; and they made him king, and anointed him; and they clapped their hands, and said, God save the king.",
        "footNotes": [
          {
            "start": 82,
            "end": 91,
            "text": "Ex. 25:16."
          },
          {
            "start": 175,
            "end": 192,
            "text": "HEB May the king live!"
          }
        ],
        "italics": [
          {
            "start": 69,
            "end": 77
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
