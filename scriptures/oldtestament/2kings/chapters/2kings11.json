                        "end": 1
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 11:4",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 4
      },
      {
        "text": "And he commanded them, saying, This is the thing that ye shall do; A third part of you that enter in on the sabbath shall even be keepers of the watch of the king’s house;",
        "footNotes": [
          {
            "start": 108,
            "end": 115,
            "text": "1 Chr. 9:25."
          }
        ],
        "italics": [
          {
            "start": 36,
            "end": 38
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "1 Chr. 9:25.",
            "prettyString": "1 Chronicles 9:25",
            "references": [
              {
                "type": "scripture",
                "book": "1chronicles",
                "chapters": [
                  {
                    "start": 9,
                    "end": 9,
                    "verses": [
                      {
                        "start": 25,
                        "end": 25
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 11:5",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 5
      },
      {
        "text": "And a third part shall be at the gate of Sur; and a third part at the gate behind the guard: so shall ye keep the watch of the house, that it be not broken down.",
        "footNotes": [
          {
            "start": 33,
            "end": 37,
            "text": "2 Chr. 23:5."
          }
        ],
        "italics": [
          {
            "start": 17,
            "end": 25
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
