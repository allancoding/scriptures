                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 11:12",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 12
      },
      {
        "text": "And when Athaliah heard the noise of the guard and of the people, she came to the people into the temple of the Lord.",
        "footNotes": [],
        "italics": [
          {
            "start": 47,
            "end": 50
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 11:13",
        "book": "2 Kings",
        "chapter": 11,
        "verse": 13
      },
      {
        "text": "And when she looked, behold, the king stood by a pillar, as the manner was, and the princes and the trumpeters by the king, and all the people of the land rejoiced, and blew with trumpets: and Athaliah rent her clothes, and cried, Treason, Treason.",
        "footNotes": [
          {
            "start": 49,
            "end": 55,
            "text": "2 Kgs. 23:3."
          }
        ],
        "italics": [
          {
            "start": 71,
            "end": 75
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "2 Kgs. 23:3.",
            "prettyString": "2 Kings 23:3",
            "references": [
              {
                "type": "scripture",
