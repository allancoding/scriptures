                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 22:4",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 4
      },
      {
        "text": "And let them deliver it into the hand of the doers of the work, that have the oversight of the house of the Lord: and let them give it to the doers of the work which is in the house of the Lord, to repair the breaches of the house,",
        "footNotes": [
          {
            "start": 209,
            "end": 217,
            "text": "OR holes, broken areas."
          }
        ],
        "italics": [
          {
            "start": 166,
            "end": 168
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 22:5",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 5
      },
      {
        "text": "Unto carpenters, and builders, and masons, and to buy timber and hewn stone to repair the house.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 22:6",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 6
      },
      {
        "text": "Howbeit there was no reckoning made with them of the money that was delivered into their hand, because they dealt faithfully.",
        "footNotes": [
          {
            "start": 21,
            "end": 30,
            "text": "2 Kgs. 12:15."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "2 Kgs. 12:15.",
            "prettyString": "2 Kings 12:15",
            "references": [
              {
                "type": "scripture",
                "book": "2kings",
                "chapters": [
                  {
                    "start": 12,
                    "end": 12,
                    "verses": [
                      {
                        "start": 15,
                        "end": 15
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 22:7",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 7
      },
      {
        "text": "And Hilkiah the high priest said unto Shaphan the scribe, I have found the book of the law in the house of the Lord. And Hilkiah gave the book to Shaphan, and he read it.",
        "footNotes": [
          {
            "start": 75,
            "end": 79,
            "text": "TG Scriptures, Preservation of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [
          {
            "raw": "TG Scriptures, Preservation of.",
            "prettyString": "TG Scriptures, Preservation of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Scriptures, Preservation of",
                "entryId": "tg-scriptures-preservation-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 22:8",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 8
      },
      {
        "text": "And Shaphan the scribe came to the king, and brought the king word again, and said, Thy servants have gathered the money that was found in the house, and have delivered it into the hand of them that do the work, that have the oversight of the house of the Lord.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 22:9",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 9
      },
      {
        "text": "And Shaphan the scribe shewed the king, saying, Hilkiah the priest hath delivered me a book. And Shaphan read it before the king.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Kings 22:10",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 10
      },
      {
        "text": "And it came to pass, when the king had heard the words of the book of the law, that he rent his clothes.",
        "footNotes": [
          {
            "start": 49,
            "end": 54,
            "text": "Alma 31:5."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "Alma 31:5.",
            "prettyString": "Alma 31:5",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 31,
                    "end": 31,
                    "verses": [
                      {
                        "start": 5,
                        "end": 5
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 22:11",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 11
      },
      {
        "text": "And the king commanded Hilkiah the priest, and Ahikam the son of Shaphan, and Achbor the son of Michaiah, and Shaphan the scribe, and Asahiah a servant of the king’s, saying,",
        "footNotes": [
          {
            "start": 47,
            "end": 53,
            "text": "Jer. 26:24."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [
          {
            "raw": "Jer. 26:24.",
            "prettyString": "Jeremiah 26:24",
            "references": [
              {
                "type": "scripture",
                "book": "jeremiah",
                "chapters": [
                  {
                    "start": 26,
                    "end": 26,
                    "verses": [
                      {
                        "start": 24,
                        "end": 24
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Kings 22:12",
        "book": "2 Kings",
        "chapter": 22,
        "verse": 12
      },
      {
        "text": "Go ye, inquire of the Lord for me, and for the people, and for all Judah, concerning the words of this book that is found: for great is the wrath of the Lord that is kindled against us, because our fathers have not hearkened unto the words of this book, to do according unto all that which is written concerning us.",
        "footNotes": [
          {
            "start": 140,
            "end": 145,
            "text": "TG God, Indignation of."
          },
          {
            "start": 257,
            "end": 259,
            "text": "TG Obedience."
          }
        ],
        "italics": [
          {
            "start": 133,
            "end": 135
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "TG God, Indignation of.",
            "prettyString": "TG God, Indignation of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "God, Indignation of",
                "entryId": "tg-god-indignation-of",
                "book": "",
