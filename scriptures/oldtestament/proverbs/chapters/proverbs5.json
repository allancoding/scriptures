        "reference": "Proverbs 5:1",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 1
      },
      {
        "text": "That thou mayest regard discretion, and that thy lips may keep knowledge.",
        "footNotes": [],
        "italics": [
          {
            "start": 40,
            "end": 44
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
