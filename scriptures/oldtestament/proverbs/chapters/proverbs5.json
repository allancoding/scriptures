        "book": "Proverbs",
        "chapter": 5,
        "verse": 13
      },
      {
        "text": "I was almost in all evil in the midst of the congregation and assembly.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 5:14",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 14
      },
      {
        "text": "Drink waters out of thine own cistern, and running waters out of thine own well.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 5:15",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 15
      },
      {
        "text": "Let thy fountains be dispersed abroad, and rivers of waters in the streets.",
        "footNotes": [],
        "italics": [
          {
            "start": 39,
            "end": 42
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 5:16",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 16
      },
      {
