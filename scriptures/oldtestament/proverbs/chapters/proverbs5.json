        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 5:12",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 12
      },
      {
        "text": "And have not obeyed the voice of my teachers, nor inclined mine ear to them that instructed me!",
        "footNotes": [
          {
            "start": 13,
            "end": 19,
            "text": "TG Disobedience."
          },
          {
            "start": 36,
            "end": 44,
            "text": "TG Teacher."
