    "delineation": "Chapter",
    "number": 5,
    "summary": "Those who associate with immoral women will go down to hell—Rejoice with the wife of your youth.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "My son, attend unto my wisdom, and bow thine ear to my understanding:",
        "footNotes": [],
        "italics": [
          {
