        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 5:17",
        "book": "Proverbs",
        "chapter": 5,
        "verse": 17
