          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:5",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 5
      },
      {
        "text": "For at the window of my house I looked through my casement,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:6",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 6
      },
      {
        "text": "And beheld among the simple ones, I discerned among the youths, a young man void of understanding,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:7",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 7
      },
      {
        "text": "Passing through the street near her corner; and he went the way to her house,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:8",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 8
      },
      {
        "text": "In the twilight, in the evening, in the black and dark night:",
        "footNotes": [
          {
            "start": 7,
            "end": 15,
            "text": "Job 24:15."
          },
          {
            "start": 50,
            "end": 54,
            "text": "Alma 10:25; 14:6; Moses 6:27; 7:26."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
