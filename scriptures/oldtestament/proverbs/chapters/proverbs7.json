              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Proverbs 7:23",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 23
      },
      {
        "text": "Hearken unto me now therefore, O ye children, and attend to the words of my mouth.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:24",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 24
      },
      {
        "text": "Let not thine heart decline to her ways, go not astray in her paths.",
        "footNotes": [
          {
            "start": 14,
            "end": 19,
            "text": "Alma 5:41."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [
          {
            "raw": "Alma 5:41.",
            "prettyString": "Alma 5:41",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 5,
                    "end": 5,
                    "verses": [
                      {
                        "start": 41,
                        "end": 41
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Proverbs 7:25",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 25
      },
      {
        "text": "For she hath cast down many wounded: yea, many strong men have been slain by her.",
        "footNotes": [],
        "italics": [
          {
            "start": 54,
            "end": 57
          }
        ],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:26",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 26
      },
