        "book": "Proverbs",
        "chapter": 7,
        "verse": 10
      },
      {
        "text": "(She is loud and stubborn; her feet abide not in her house:",
        "footNotes": [
          {
            "start": 17,
            "end": 25,
            "text": "TG Stubbornness."
          }
        ],
        "italics": [
          {
            "start": 5,
            "end": 7
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "TG Stubbornness.",
            "prettyString": "TG Stubbornness",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
