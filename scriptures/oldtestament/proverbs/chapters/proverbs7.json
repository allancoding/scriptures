  "chapter": {
    "bookTitle": "Proverbs",
    "delineation": "Chapter",
    "number": 7,
    "summary": "An immoral woman leads a man to destruction as an ox to the slaughter—The house of an adulterous woman is the way to hell.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "My son, keep my words, and lay up my commandments with thee.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 7:1",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 1
      },
      {
        "text": "Keep my commandments, and live; and my law as the apple of thine eye.",
        "footNotes": [
          {
            "start": 8,
            "end": 20,
            "text": "1 Ne. 17:15 (3, 15); D&C 14:7."
          },
          {
            "start": 50,
            "end": 55,
            "text": "Deut. 32:10 (7–10)."
