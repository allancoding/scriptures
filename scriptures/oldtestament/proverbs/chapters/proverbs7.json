        ],
        "jstReferences": [],
        "reference": "Proverbs 7:22",
        "book": "Proverbs",
        "chapter": 7,
        "verse": 22
      },
      {
        "text": "Till a dart strike through his liver; as a bird hasteth to the snare, and knoweth not that it is for his life.",
        "footNotes": [
          {
            "start": 63,
            "end": 68,
            "text": "Eccl. 9:12."
          }
        ],
        "italics": [
          {
            "start": 94,
            "end": 96
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [
          {
            "raw": "Eccl. 9:12.",
            "prettyString": "Ecclesiastes 9:12",
            "references": [
              {
                "type": "scripture",
                "book": "ecclesiastes",
                "chapters": [
                  {
                    "start": 9,
                    "end": 9,
                    "verses": [
                      {
