        "italics": [
          {
            "start": 22,
            "end": 25
          },
          {
            "start": 60,
            "end": 63
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "Alma 37:35.",
