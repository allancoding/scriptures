        ],
        "italics": [
          {
            "start": 35,
            "end": 39
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "TG Lust; Sexual Immorality.",
            "prettyString": "TG Lust; TG Sexual Immorality",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
