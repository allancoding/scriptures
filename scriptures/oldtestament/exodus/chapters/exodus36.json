                "entryId": "tg-skill",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Exodus 36:8",
        "book": "Exodus",
        "chapter": 36,
        "verse": 8
      },
      {
        "text": "The length of one curtain was twenty and eight cubits, and the breadth of one curtain four cubits: the curtains were all of one size.",
        "footNotes": [
          {
            "start": 14,
            "end": 17,
            "text": "OR each."
          }
        ],
        "italics": [
          {
            "start": 26,
            "end": 29
          },
          {
            "start": 112,
            "end": 116
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:9",
        "book": "Exodus",
        "chapter": 36,
        "verse": 9
      },
      {
        "text": "And he coupled the five curtains one unto another: and the other five curtains he coupled one unto another.",
        "footNotes": [],
        "italics": [
          {
            "start": 55,
            "end": 64
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:10",
        "book": "Exodus",
        "chapter": 36,
        "verse": 10
      },
      {
        "text": "And he made loops of blue on the edge of one curtain from the selvedge in the coupling: likewise he made in the uttermost side of another curtain, in the coupling of the second.",
        "footNotes": [
          {
            "start": 53,
            "end": 57,
            "text": "HEB on the outside of the first set."
          }
        ],
        "italics": [
          {
            "start": 130,
            "end": 137
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:11",
        "book": "Exodus",
        "chapter": 36,
        "verse": 11
      },
      {
        "text": "Fifty loops made he in one curtain, and fifty loops made he in the edge of the curtain which was in the coupling of the second: the loops held one curtain to another.",
        "footNotes": [],
        "italics": [
          {
            "start": 93,
            "end": 96
          },
          {
            "start": 147,
            "end": 154
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:12",
        "book": "Exodus",
        "chapter": 36,
        "verse": 12
      },
      {
        "text": "And he made fifty taches of gold, and coupled the curtains one unto another with the taches: so it became one tabernacle.",
        "footNotes": [
          {
            "start": 18,
            "end": 24,
            "text": "OR clasps."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:13",
        "book": "Exodus",
        "chapter": 36,
        "verse": 13
      },
      {
        "text": "And he made curtains of goats’ hair for the tent over the tabernacle: eleven curtains he made them.",
        "footNotes": [],
        "italics": [
          {
            "start": 21,
            "end": 23
          },
          {
            "start": 31,
            "end": 35
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:14",
        "book": "Exodus",
        "chapter": 36,
        "verse": 14
      },
      {
        "text": "The length of one curtain was thirty cubits, and four cubits was the breadth of one curtain: the eleven curtains were of one size.",
        "footNotes": [],
        "italics": [
          {
            "start": 26,
            "end": 29
          },
          {
            "start": 61,
            "end": 64
          },
          {
            "start": 113,
            "end": 117
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:15",
        "book": "Exodus",
        "chapter": 36,
        "verse": 15
      },
      {
        "text": "And he coupled five curtains by themselves, and six curtains by themselves.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:16",
        "book": "Exodus",
        "chapter": 36,
        "verse": 16
      },
      {
        "text": "And he made fifty loops upon the uttermost edge of the curtain in the coupling, and fifty loops made he upon the edge of the curtain which coupleth the second.",
        "footNotes": [
          {
            "start": 51,
            "end": 54,
            "text": "OR the other connecting curtain."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:17",
        "book": "Exodus",
        "chapter": 36,
        "verse": 17
      },
      {
        "text": "And he made fifty taches of brass to couple the tent together, that it might be one.",
        "footNotes": [],
        "italics": [
          {
            "start": 25,
            "end": 27
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Exodus 36:18",
        "book": "Exodus",
        "chapter": 36,
        "verse": 18
      },
      {
        "text": "And he made a covering for the tent of rams’ skins dyed red, and a covering of badgers’ skins above that.",
        "footNotes": [],
        "italics": [
          {
            "start": 36,
            "end": 38
          },
          {
            "start": 76,
            "end": 78
          },
          {
            "start": 100,
            "end": 105
          }
