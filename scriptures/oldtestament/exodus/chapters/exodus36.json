  "chapter": {
    "bookTitle": "Exodus",
    "delineation": "Chapter",
    "number": 36,
    "summary": "Wise-hearted men are chosen to work on the tabernacle—Moses restrains the people from donating any more material.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Then wrought Bezaleel and Aholiab, and every wise hearted man, in whom the Lord put wisdom and understanding to know how to work all manner of work for the service of the sanctuary, according to all that the Lord had commanded.",
        "footNotes": [
          {
            "start": 13,
            "end": 21,
            "text": "Ex. 31:2 (1–6)."
          },
          {
            "start": 39,
            "end": 61,
            "text": "OR all the able men (see also v. 4)."
          },
          {
            "start": 84,
            "end": 90,
            "text": "Ex. 35:35; 1 Kgs. 7:14. TG Holy Ghost, Gifts of."
          },
          {
            "start": 148,
            "end": 166,
            "text": "IE in the construction of (see also vv. 2, 8)."
          }
        ],
        "italics": [],
        "associatedContent": [],
