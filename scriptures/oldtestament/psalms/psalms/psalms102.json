            "start": 44,
            "end": 49,
            "text": "TG Creation."
          }
        ],
        "italics": [
          {
            "start": 67,
            "end": 70
          }
        ],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [
