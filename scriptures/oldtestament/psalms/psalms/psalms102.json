        "text": "I said, O my God, take me not away in the midst of my days: thy years are throughout all generations.",
        "footNotes": [],
        "italics": [
          {
            "start": 70,
            "end": 73
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 102:24",
        "book": "Psalms",
        "chapter": 102,
        "verse": 24
      },
      {
