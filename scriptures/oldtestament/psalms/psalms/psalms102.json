        "jstReferences": [],
        "reference": "Psalms 102:13",
        "book": "Psalms",
        "chapter": 102,
        "verse": 13
      },
      {
        "text": "For thy servants take pleasure in her stones, and favour the dust thereof.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 102:14",
        "book": "Psalms",
        "chapter": 102,
        "verse": 14
      },
      {
        "text": "So the heathen shall fear the name of the Lord, and all the kings of the earth thy glory.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 102:15",
        "book": "Psalms",
        "chapter": 102,
        "verse": 15
      },
      {
