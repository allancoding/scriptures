          {
            "start": 23,
            "end": 34,
            "text": "TG Foolishness."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
            "raw": "TG Foolishness.",
            "prettyString": "TG Foolishness",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Foolishness",
                "entryId": "tg-foolishness",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 69:5",
        "book": "Psalms",
        "chapter": 69,
        "verse": 5
      },
      {
        "text": "Let not them that wait on thee, O Lord God of hosts, be ashamed for my sake: let not those that seek thee be confounded for my sake, O God of Israel.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:6",
        "book": "Psalms",
        "chapter": 69,
        "verse": 6
      },
      {
        "text": "Because for thy sake I have borne reproach; shame hath covered my face.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:7",
        "book": "Psalms",
        "chapter": 69,
        "verse": 7
      },
      {
        "text": "I am become a stranger unto my brethren, and an alien unto my mother’s children.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:8",
        "book": "Psalms",
        "chapter": 69,
        "verse": 8
      },
      {
