          }
        ],
        "jstReferences": [],
        "reference": "Psalms 69:16",
        "book": "Psalms",
        "chapter": 69,
        "verse": 16
      },
      {
        "text": "And hide not thy face from thy servant; for I am in trouble: hear me speedily.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:17",
        "book": "Psalms",
        "chapter": 69,
        "verse": 17
      },
      {
