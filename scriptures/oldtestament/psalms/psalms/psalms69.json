            "start": 88,
            "end": 91,
            "text": "Num. 16:33 (31–33)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:15",
        "book": "Psalms",
        "chapter": 69,
        "verse": 15
      },
      {
