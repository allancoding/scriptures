  "chapter": {
    "bookTitle": "Psalms",
    "delineation": "Psalm",
    "number": 69,
    "summary": "A messianic psalm of David—The zeal of the Lord’s house has eaten Him up—Reproach has broken His heart—He is given gall and vinegar to drink—He is persecuted—He will save Zion.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Save me, O God; for the waters are come in unto my soul.",
        "footNotes": [],
        "italics": [
          {
            "start": 48,
            "end": 50
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:1",
        "book": "Psalms",
        "chapter": 69,
        "verse": 1
      },
      {
        "text": "I sink in deep mire, where there is no standing: I am come into deep waters, where the floods overflow me.",
        "footNotes": [
          {
            "start": 64,
            "end": 68,
            "text": "Ps. 130:1; D&C 122:7 (7–8)."
          }
        ],
        "italics": [
          {
            "start": 27,
            "end": 35
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:2",
        "book": "Psalms",
        "chapter": 69,
        "verse": 2
      },
      {
        "text": "I am weary of my crying: my throat is dried: mine eyes fail while I wait for my God.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 69:3",
        "book": "Psalms",
        "chapter": 69,
        "verse": 3
      },
      {
        "text": "They that hate me without a cause are more than the hairs of mine head: they that would destroy me, being mine enemies wrongfully, are mighty: then I restored that which I took not away.",
        "footNotes": [
          {
            "start": 10,
            "end": 14,
            "text": "TG Hate."
          }
        ],
        "italics": [
          {
            "start": 100,
            "end": 105
          },
          {
            "start": 159,
            "end": 163
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "TG Hate.",
            "prettyString": "TG Hate",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Hate",
                "entryId": "tg-hate",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 69:4",
        "book": "Psalms",
        "chapter": 69,
        "verse": 4
      },
      {
        "text": "O God, thou knowest my foolishness; and my sins are not hid from thee.",
