        "jstReferences": [],
        "reference": "Psalms 90:13",
        "book": "Psalms",
        "chapter": 90,
        "verse": 13
      },
      {
        "text": "O satisfy us early with thy mercy; that we may rejoice and be glad all our days.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 90:14",
        "book": "Psalms",
        "chapter": 90,
        "verse": 14
      },
      {
        "text": "Make us glad according to the days wherein thou hast afflicted us, and the years wherein we have seen evil.",
        "footNotes": [],
        "italics": [
          {
            "start": 35,
            "end": 42
          },
          {
            "start": 67,
            "end": 70
          },
          {
            "start": 81,
            "end": 88
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
