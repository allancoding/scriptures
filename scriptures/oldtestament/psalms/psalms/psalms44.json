        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 44:18",
        "book": "Psalms",
        "chapter": 44,
        "verse": 18
      },
      {
