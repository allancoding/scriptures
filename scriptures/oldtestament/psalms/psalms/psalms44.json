          }
        ],
        "jstReferences": [],
        "reference": "Psalms 44:19",
        "book": "Psalms",
        "chapter": 44,
        "verse": 19
      },
      {
        "text": "If we have forgotten the name of our God, or stretched out our hands to a strange god;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 44:20",
        "book": "Psalms",
        "chapter": 44,
        "verse": 20
