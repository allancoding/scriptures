        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 31:10",
        "book": "Psalms",
        "chapter": 31,
        "verse": 10
      },
      {
        "text": "I was a reproach among all mine enemies, but especially among my neighbours, and a fear to mine acquaintance: they that did see me without fled from me.",
        "footNotes": [
          {
            "start": 139,
            "end": 143,
            "text": "Job 19:14 (14–15); Ps. 64:8."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 31:11",
        "book": "Psalms",
        "chapter": 31,
        "verse": 11
      },
      {
        "text": "I am forgotten as a dead man out of mind: I am like a broken vessel.",
        "footNotes": [
          {
            "start": 5,
            "end": 14,
            "text": "Ps. 88:5 (4–5)."
          },
          {
            "start": 61,
            "end": 67,
            "text": "Jer. 22:28; 48:38; Hosea 8:8; Rev. 2:27 (26–27); D&C 76:33 (31–33)."
