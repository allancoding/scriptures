        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 31:12",
        "book": "Psalms",
        "chapter": 31,
        "verse": 12
      },
      {
