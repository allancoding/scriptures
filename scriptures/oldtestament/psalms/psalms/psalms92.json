        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 92:2",
        "book": "Psalms",
        "chapter": 92,
        "verse": 2
      },
      {
        "text": "Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 92:3",
        "book": "Psalms",
        "chapter": 92,
        "verse": 3
      },
      {
        "text": "For thou, Lord, hast made me glad through thy work: I will triumph in the works of thy hands.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 92:4",
        "book": "Psalms",
        "chapter": 92,
        "verse": 4
      },
      {
