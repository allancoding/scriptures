        ],
        "jstReferences": [],
        "reference": "Psalms 92:12",
        "book": "Psalms",
        "chapter": 92,
        "verse": 12
      },
      {
        "text": "Those that be planted in the house of the Lord shall flourish in the courts of our God.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 92:13",
        "book": "Psalms",
        "chapter": 92,
        "verse": 13
      },
      {
