                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 94:6",
        "book": "Psalms",
        "chapter": 94,
        "verse": 6
      },
      {
        "text": "Yet they say, The Lord shall not see, neither shall the God of Jacob regard it.",
        "footNotes": [],
        "italics": [
          {
            "start": 76,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 94:7",
        "book": "Psalms",
        "chapter": 94,
        "verse": 7
      },
      {
        "text": "Understand, ye brutish among the people: and ye fools, when will ye be wise?",
        "footNotes": [],
        "italics": [
          {
            "start": 45,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 94:8",
        "book": "Psalms",
        "chapter": 94,
        "verse": 8
      },
      {
        "text": "He that planted the ear, shall he not hear? he that formed the eye, shall he not see?",
        "footNotes": [
          {
            "start": 38,
            "end": 42,
            "text": "Job 22:13 (13–14); D&C 88:41."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 94:9",
        "book": "Psalms",
        "chapter": 94,
        "verse": 9
      },
      {
        "text": "He that chastiseth the heathen, shall not he correct? he that teacheth man knowledge, shall not he know?",
        "footNotes": [],
        "italics": [
          {
            "start": 86,
            "end": 104
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 94:10",
        "book": "Psalms",
        "chapter": 94,
        "verse": 10
      },
