  "chapter": {
    "bookTitle": "Psalms",
    "delineation": "Psalm",
    "number": 94,
    "summary": "The Lord will judge the earth and all men—Blessed is he whom the Lord teaches and chastens—The Lord will not forsake His people, but He will cut off the wicked.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "O Lord God, to whom vengeance belongeth; O God, to whom vengeance belongeth, shew thyself.",
