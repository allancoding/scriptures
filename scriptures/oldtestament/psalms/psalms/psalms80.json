        "book": "Psalms",
        "chapter": 80,
        "verse": 3
      },
      {
        "text": "O Lord God of hosts, how long wilt thou be angry against the prayer of thy people?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 80:4",
        "book": "Psalms",
        "chapter": 80,
        "verse": 4
      },
      {
        "text": "Thou feedest them with the bread of tears; and givest them tears to drink in great measure.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 80:5",
        "book": "Psalms",
        "chapter": 80,
        "verse": 5
      },
      {
        "text": "Thou makest us a strife unto our neighbours: and our enemies laugh among themselves.",
        "footNotes": [
          {
            "start": 17,
            "end": 23,
            "text": "TG Strife."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
