  "chapter": {
    "bookTitle": "Psalms",
    "delineation": "Psalm",
    "number": 145,
    "summary": "David proclaims the greatness and majesty of God—The Lord is good to all—His kingdom is an everlasting kingdom—He is near to all who call upon Him, and He preserves those who love Him.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "I will extol thee, my God, O king; and I will bless thy name for ever and ever.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:1",
        "book": "Psalms",
        "chapter": 145,
        "verse": 1
      },
      {
        "text": "Every day will I bless thee; and I will praise thy name for ever and ever.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:2",
        "book": "Psalms",
        "chapter": 145,
        "verse": 2
      },
      {
        "text": "Great is the Lord, and greatly to be praised; and his greatness is unsearchable.",
        "footNotes": [],
        "italics": [
          {
            "start": 6,
            "end": 8
          },
          {
            "start": 64,
            "end": 66
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:3",
        "book": "Psalms",
        "chapter": 145,
        "verse": 3
      },
      {
        "text": "One generation shall praise thy works to another, and shall declare thy mighty acts.",
        "footNotes": [
          {
            "start": 4,
            "end": 14,
            "text": "Deut. 4:9; Ps. 78:3 (3–4); Isa. 38:19."
