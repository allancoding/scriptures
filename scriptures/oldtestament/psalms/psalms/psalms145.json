        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:4",
        "book": "Psalms",
        "chapter": 145,
        "verse": 4
      },
      {
        "text": "I will speak of the glorious honour of thy majesty, and of thy wondrous works.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:5",
        "book": "Psalms",
        "chapter": 145,
        "verse": 5
      },
      {
