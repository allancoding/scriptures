        "footNotes": [
          {
            "start": 40,
            "end": 48,
            "text": "Ex. 34:10."
          }
        ],
        "italics": [
          {
            "start": 4,
            "end": 7
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [
          {
