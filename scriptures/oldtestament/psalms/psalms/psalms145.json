        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:16",
        "book": "Psalms",
        "chapter": 145,
        "verse": 16
      },
