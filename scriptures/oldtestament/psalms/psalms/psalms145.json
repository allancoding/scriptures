        "footNotes": [],
        "italics": [
          {
            "start": 53,
            "end": 66
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:14",
        "book": "Psalms",
        "chapter": 145,
        "verse": 14
      },
      {
        "text": "The eyes of all wait upon thee; and thou givest them their meat in due season.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 145:15",
        "book": "Psalms",
        "chapter": 145,
        "verse": 15
      },
      {
