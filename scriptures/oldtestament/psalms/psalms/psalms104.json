            "prettyString": "TG Meditation",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Meditation",
                "entryId": "tg-meditation",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
