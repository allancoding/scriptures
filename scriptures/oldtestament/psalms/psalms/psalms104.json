                    "verses": [
                      {
                        "start": 25,
                        "end": 25
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 104:1",
        "book": "Psalms",
        "chapter": 104,
        "verse": 1
      },
      {
