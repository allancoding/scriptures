        "book": "2 Samuel",
        "chapter": 21,
        "verse": 20
      },
      {
        "text": "And when he defied Israel, Jonathan the son of Shimea the brother of David slew him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 21:21",
        "book": "2 Samuel",
