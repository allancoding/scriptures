                    "verses": [
                      {
                        "start": 31,
                        "end": 31
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 17:14",
        "book": "2 Samuel",
        "chapter": 17,
        "verse": 14
      },
      {
        "text": "Then said Hushai unto Zadok and to Abiathar the priests, Thus and thus did Ahithophel counsel Absalom and the elders of Israel; and thus and thus have I counselled.",
        "footNotes": [
          {
            "start": 110,
            "end": 116,
            "text": "1 Ne. 4:22."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "1 Ne. 4:22.",
            "prettyString": "1 Nephi 4:22",
            "references": [
              {
                "type": "scripture",
                "book": "1nephi",
                "chapters": [
                  {
                    "start": 4,
                    "end": 4,
                    "verses": [
                      {
                        "start": 22,
                        "end": 22
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 17:15",
        "book": "2 Samuel",
        "chapter": 17,
        "verse": 15
      },
      {
        "text": "Now therefore send quickly, and tell David, saying, Lodge not this night in the plains of the wilderness, but speedily pass over; lest the king be swallowed up, and all the people that are with him.",
        "footNotes": [],
        "italics": [
          {
            "start": 185,
            "end": 188
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 17:16",
        "book": "2 Samuel",
        "chapter": 17,
        "verse": 16
      },
      {
        "text": "Now Jonathan and Ahimaaz stayed by En-rogel; for they might not be seen to come into the city: and a wench went and told them; and they went and told king David.",
        "footNotes": [
          {
            "start": 4,
            "end": 12,
            "text": "1 Kgs. 1:42."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [
          {
            "raw": "1 Kgs. 1:42.",
            "prettyString": "1 Kings 1:42",
            "references": [
              {
                "type": "scripture",
                "book": "1kings",
                "chapters": [
                  {
                    "start": 1,
                    "end": 1,
