            "start": 53,
            "end": 60,
            "text": "Ps. 137:8."
          },
          {
            "start": 93,
            "end": 99,
            "text": "IE Babylon was to be overthrown; this prophecy was fulfilled by Cyrus, 539 B.C."
          },
          {
            "start": 103,
            "end": 128,
            "text": "HEB virgin daughter; i.e., the heretofore unconquered Babylonian empire."
          }
        ],
        "italics": [
          {
            "start": 81,
            "end": 89
          }
        ],
        "associatedContent": [],
