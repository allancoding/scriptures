  "chapter": {
    "bookTitle": "Esther",
    "delineation": "Chapter",
    "number": 8,
    "summary": "Mordecai is honored and placed over the house of Haman—Ahasuerus issues a decree to preserve the Jews.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "On that day did the king Ahasuerus give the house of Haman the Jews’ enemy unto Esther the queen. And Mordecai came before the king; for Esther had told what he was unto her.",
        "footNotes": [
          {
            "start": 153,
            "end": 157,
            "text": "Esth. 2:10 (7–20)."
          }
        ],
        "italics": [
          {
            "start": 161,
            "end": 164
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Esther 8:1",
        "book": "Esther",
        "chapter": 8,
        "verse": 1
      },
      {
        "text": "And the king took off his ring, which he had taken from Haman, and gave it unto Mordecai. And Esther set Mordecai over the house of Haman.",
        "footNotes": [
          {
            "start": 26,
            "end": 30,
            "text": "Gen. 41:42; Esth. 3:10."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "Gen. 41:42; Esth. 3:10.",
