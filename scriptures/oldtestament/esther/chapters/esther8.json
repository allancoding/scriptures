        "jstReferences": [],
        "reference": "Esther 8:15",
        "book": "Esther",
        "chapter": 8,
        "verse": 15
      },
      {
        "text": "The Jews had light, and gladness, and joy, and honour.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Esther 8:16",
        "book": "Esther",
        "chapter": 8,
        "verse": 16
      },
      {
