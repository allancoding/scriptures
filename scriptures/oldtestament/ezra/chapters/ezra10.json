                "entryId": "tg-guilt",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Ezra 10:19",
        "book": "Ezra",
        "chapter": 10,
        "verse": 19
      },
      {
