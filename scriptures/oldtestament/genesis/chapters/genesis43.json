        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 43:22",
        "book": "Genesis",
        "chapter": 43,
        "verse": 22
      },
