        "jstReferences": [],
        "reference": "Genesis 31:19",
        "book": "Genesis",
        "chapter": 31,
        "verse": 19
      },
      {
        "text": "And Jacob stole away unawares to Laban the Syrian, in that he told him not that he fled.",
        "footNotes": [
          {
            "start": 43,
            "end": 49,
            "text": "HEB Aramean (also v. 24)."
