          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 31:10",
        "book": "Genesis",
        "chapter": 31,
        "verse": 10
      },
      {
