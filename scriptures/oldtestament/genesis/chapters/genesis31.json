        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 31:21",
        "book": "Genesis",
        "chapter": 31,
        "verse": 21
      },
      {
        "text": "And it was told Laban on the third day that Jacob was fled.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 31:22",
        "book": "Genesis",
        "chapter": 31,
        "verse": 22
      },
      {
        "text": "And he took his brethren with him, and pursued after him seven days’ journey; and they overtook him in the mount Gilead.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 31:23",
        "book": "Genesis",
        "chapter": 31,
        "verse": 23
      },
      {
