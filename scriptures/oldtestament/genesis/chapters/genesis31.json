        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 31:20",
        "book": "Genesis",
        "chapter": 31,
        "verse": 20
      },
      {
        "text": "So he fled with all that he had; and he rose up, and passed over the river, and set his face toward the mount Gilead.",
        "footNotes": [],
        "italics": [
          {
            "start": 93,
            "end": 99
          }
