        "crossReferences": [],
        "jstReferences": [],
        "reference": "Deuteronomy 20:15",
        "book": "Deuteronomy",
        "chapter": 20,
        "verse": 15
      },
      {
        "text": "But of the cities of these people, which the Lord thy God doth give thee for an inheritance, thou shalt save alive nothing that breatheth:",
        "footNotes": [
          {
            "start": 11,
            "end": 17,
            "text": "Josh. 11:14."
          }
        ],
        "italics": [
          {
            "start": 73,
            "end": 76
