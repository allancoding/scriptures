                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Mark 12:15",
        "book": "Mark",
        "chapter": 12,
        "verse": 15
      },
      {
        "text": "And they brought it. And he saith unto them, Whose is this image and superscription? And they said unto him, Cæsar’s.",
        "footNotes": [],
        "italics": [
          {
            "start": 17,
            "end": 20
          },
          {
            "start": 51,
            "end": 53
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:16",
        "book": "Mark",
        "chapter": 12,
        "verse": 16
      },
      {
        "text": "And Jesus answering said unto them, Render to Cæsar the things that are Cæsar’s, and to God the things that are God’s. And they marvelled at him.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:17",
        "book": "Mark",
        "chapter": 12,
        "verse": 17
      },
      {
        "text": "Then come unto him the Sadducees, which say there is no resurrection; and they asked him, saying,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:18",
        "book": "Mark",
        "chapter": 12,
        "verse": 18
      },
