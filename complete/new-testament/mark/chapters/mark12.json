        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "TG Cornerstone.",
            "prettyString": "TG Cornerstone",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Cornerstone",
                "entryId": "tg-cornerstone",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Mark 12:10",
        "book": "Mark",
        "chapter": 12,
        "verse": 10
      },
      {
        "text": "This was the Lord’s doing, and it is marvellous in our eyes?",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:11",
        "book": "Mark",
        "chapter": 12,
        "verse": 11
      },
      {
        "text": "And they sought to lay hold on him, but feared the people: for they knew that he had spoken the parable against them: and they left him, and went their way.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:12",
        "book": "Mark",
        "chapter": 12,
        "verse": 12
      },
      {
        "text": "And they send unto him certain of the Pharisees and of the Herodians, to catch him in his words.",
        "footNotes": [
          {
            "start": 73,
            "end": 78,
            "text": "Matt. 22:15 (15–22); Luke 11:54 (53–54); 20:20 (19–26)."
