      {
        "text": "Now there were seven brethren: and the first took a wife, and dying left no seed.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mark 12:20",
        "book": "Mark",
        "chapter": 12,
        "verse": 20
      },
