        ],
        "jstReferences": [],
        "reference": "Mark 11:24",
        "book": "Mark",
        "chapter": 11,
        "verse": 24
      },
      {
        "text": "And when ye stand praying, forgive, if ye have ought against any: that your Father also which is in heaven may forgive you your trespasses.",
        "footNotes": [
          {
            "start": 18,
            "end": 25,
            "text": "TG Prayer."
          },
          {
            "start": 111,
            "end": 118,
            "text": "TG Forgive."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [
          {
