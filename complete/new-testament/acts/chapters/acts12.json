                "entryId": "tg-angels",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 12:23",
        "book": "Acts",
        "chapter": 12,
        "verse": 23
      },
      {
        "text": "But the word of God grew and multiplied.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 12:24",
        "book": "Acts",
        "chapter": 12,
        "verse": 24
      },
      {
        "text": "And Barnabas and Saul returned from Jerusalem, when they had fulfilled their ministry, and took with them John, whose surname was Mark.",
        "footNotes": [
