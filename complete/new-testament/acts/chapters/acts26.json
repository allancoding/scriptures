          {
            "raw": "TG Jesus Christ, Resurrection.",
            "prettyString": "TG Jesus Christ, Resurrection",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Jesus Christ, Resurrection",
