                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 26:16",
        "book": "Acts",
        "chapter": 26,
        "verse": 16
      },
      {
        "text": "Delivering thee from the people, and from the Gentiles, unto whom now I send thee,",
        "footNotes": [
          {
            "start": 72,
            "end": 76,
            "text": "Acts 22:21."
          }
        ],
        "italics": [
          {
            "start": 37,
            "end": 41
          }
