          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [
          {
            "raw": "TG Martyrdom.",
            "prettyString": "TG Martyrdom",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
