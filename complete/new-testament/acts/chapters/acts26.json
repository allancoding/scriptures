              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 26:14",
        "book": "Acts",
        "chapter": 26,
        "verse": 14
      },
      {
        "text": "And I said, Who art thou, Lord? And he said, I am Jesus whom thou persecutest.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 26:15",
        "book": "Acts",
        "chapter": 26,
        "verse": 15
      },
      {
        "text": "But rise, and stand upon thy feet: for I have appeared unto thee for this purpose, to make thee a minister and a witness both of these things which thou hast seen, and of those things in the which I will appear unto thee;",
        "footNotes": [
          {
            "start": 46,
            "end": 54,
            "text": "TG Jesus Christ, Appearances, Postmortal."
          },
          {
            "start": 113,
            "end": 120,
            "text": "Luke 1:2; John 1:14; Acts 5:32; 9:15; 22:15; D&C 14:8. TG Conversion."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [
          {
            "raw": "TG Jesus Christ, Appearances, Postmortal.",
            "prettyString": "TG Jesus Christ, Appearances, Postmortal",
            "references": [
              {
                "type": "studyHelp",
