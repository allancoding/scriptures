                "chapters": []
              },
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Holy Ghost, Gifts of",
                "entryId": "tg-holy-ghost-gifts-of",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 11:17",
        "book": "Acts",
        "chapter": 11,
        "verse": 17
      },
      {
        "text": "When they heard these things, they held their peace, and glorified God, saying, Then hath God also to the Gentiles granted repentance unto life.",
        "footNotes": [
          {
            "start": 106,
            "end": 114,
            "text": "Mark 16:15 (15–16); Acts 21:19; D&C 84:62 (62–64)."
          },
          {
            "start": 123,
            "end": 133,
            "text": "TG Repent."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [
          {
            "raw": "TG Repent.",
            "prettyString": "TG Repent",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Repent",
                "entryId": "tg-repent",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 11:18",
        "book": "Acts",
        "chapter": 11,
        "verse": 18
      },
      {
        "text": "Now they which were scattered abroad upon the persecution that arose about Stephen travelled as far as Phenice, and Cyprus, and Antioch, preaching the word to none but unto the Jews only.",
        "footNotes": [
          {
            "start": 46,
            "end": 57,
            "text": "TG Persecution."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
          {
            "raw": "TG Persecution.",
            "prettyString": "TG Persecution",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Persecution",
                "entryId": "tg-persecution",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Acts 11:19",
        "book": "Acts",
        "chapter": 11,
        "verse": 19
      },
      {
        "text": "And some of them were men of Cyprus and Cyrene, which, when they were come to Antioch, spake unto the Grecians, preaching the Lord Jesus.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 11:20",
        "book": "Acts",
        "chapter": 11,
        "verse": 20
      },
      {
        "text": "And the hand of the Lord was with them: and a great number believed, and turned unto the Lord.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Acts 11:21",
        "book": "Acts",
        "chapter": 11,
        "verse": 21
      },
      {
        "text": "Then tidings of these things came unto the ears of the church which was in Jerusalem: and they sent forth Barnabas, that he should go as far as Antioch.",
        "footNotes": [
          {
            "start": 106,
            "end": 114,
            "text": "Acts 4:36."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [
          {
            "raw": "Acts 4:36.",
            "prettyString": "Acts 4:36",
            "references": [
              {
                "type": "scripture",
