        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:9",
        "book": "Matthew",
        "chapter": 22,
        "verse": 9
      },
      {
