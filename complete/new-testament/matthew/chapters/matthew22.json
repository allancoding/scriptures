        "italics": [
          {
            "start": 24,
            "end": 32
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:7",
        "book": "Matthew",
        "chapter": 22,
        "verse": 7
      },
      {
        "text": "Then saith he to his servants, The wedding is ready, but they which were bidden were not worthy.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:8",
        "book": "Matthew",
        "chapter": 22,
        "verse": 8
      },
      {
