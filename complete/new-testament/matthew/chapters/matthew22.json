        "italics": [
          {
            "start": 49,
            "end": 53
          },
          {
            "start": 75,
            "end": 80
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:6",
        "book": "Matthew",
        "chapter": 22,
        "verse": 6
      },
      {
        "text": "But when the king heard thereof, he was wroth: and he sent forth his armies, and destroyed those murderers, and burned up their city.",
