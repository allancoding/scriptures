        "italics": [
          {
            "start": 23,
            "end": 26
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:5",
        "book": "Matthew",
        "chapter": 22,
        "verse": 5
      },
      {
