        "footNotes": [],
        "italics": [
          {
            "start": 120,
            "end": 122
          },
          {
            "start": 132,
            "end": 135
          },
          {
            "start": 159,
            "end": 162
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:4",
        "book": "Matthew",
        "chapter": 22,
        "verse": 4
      },
      {
        "text": "But they made light of it, and went their ways, one to his farm, another to his merchandise:",
