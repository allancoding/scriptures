        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Matthew 22:2",
        "book": "Matthew",
        "chapter": 22,
        "verse": 2
      },
      {
        "text": "And sent forth his servants to call them that were bidden to the wedding: and they would not come.",
