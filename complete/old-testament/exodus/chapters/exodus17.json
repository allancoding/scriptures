        "footNotes": [
          {
            "start": 52,
            "end": 65,
            "text": "IE The Lord is my banner. Judg. 6:24."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
