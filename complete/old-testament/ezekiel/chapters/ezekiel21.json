        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 21:8",
        "book": "Ezekiel",
        "chapter": 21,
        "verse": 8
      },
      {
        "text": "Son of man, prophesy, and say, Thus saith the Lord; Say, A sword, a sword is sharpened, and also furbished:",
        "footNotes": [
          {
            "start": 97,
            "end": 106,
            "text": "OR polished."
