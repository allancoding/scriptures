        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 21:12",
        "book": "Ezekiel",
        "chapter": 21,
        "verse": 12
      },
      {
        "text": "Because it is a trial, and what if the sword contemn even the rod? it shall be no more, saith the Lord God.",
        "footNotes": [
          {
            "start": 16,
            "end": 21,
            "text": "OR time of testing."
