        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 21:9",
        "book": "Ezekiel",
        "chapter": 21,
        "verse": 9
      },
      {
        "text": "It is sharpened to make a sore slaughter; it is furbished that it may glitter: should we then make mirth? it contemneth the rod of my son, as every tree.",
        "footNotes": [],
        "italics": [
          {
            "start": 139,
            "end": 141
