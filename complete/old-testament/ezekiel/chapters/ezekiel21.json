        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 21:11",
        "book": "Ezekiel",
        "chapter": 21,
        "verse": 11
      },
      {
        "text": "Cry and howl, son of man: for it shall be upon my people, it shall be upon all the princes of Israel: terrors by reason of the sword shall be upon my people: smite therefore upon thy thigh.",
        "footNotes": [],
        "italics": [
          {
            "start": 61,
            "end": 69
