        "chapter": 25,
        "verse": 9
      },
      {
        "text": "Unto the men of the east with the Ammonites, and will give them in possession, that the Ammonites may not be remembered among the nations.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 25:10",
        "book": "Ezekiel",
        "chapter": 25,
        "verse": 10
      },
      {
        "text": "And I will execute judgments upon Moab; and they shall know that I am the Lord.",
        "footNotes": [],
        "italics": [
          {
            "start": 67,
            "end": 69
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Ezekiel 25:11",
        "book": "Ezekiel",
        "chapter": 25,
        "verse": 11
      },
      {
