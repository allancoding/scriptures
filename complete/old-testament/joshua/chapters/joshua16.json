        "crossReferences": [],
        "jstReferences": [],
        "reference": "Joshua 16:4",
        "book": "Joshua",
        "chapter": 16,
        "verse": 4
      },
      {
        "text": "And the border of the children of Ephraim according to their families was thus: even the border of their inheritance on the east side was Ataroth-addar, unto Beth-horon the upper;",
        "footNotes": [],
        "italics": [
          {
            "start": 74,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
