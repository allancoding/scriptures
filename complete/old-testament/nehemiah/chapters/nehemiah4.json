                      }
                    ]
                  },
                  {
                    "start": 115,
                    "end": 115,
                    "verses": [
                      {
                        "start": 10,
                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Nehemiah 4:6",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 6
      },
      {
        "text": "But it came to pass, that when Sanballat, and Tobiah, and the Arabians, and the Ammonites, and the Ashdodites, heard that the walls of Jerusalem were made up, and that the breaches began to be stopped, then they were very wroth,",
        "footNotes": [
          {
            "start": 31,
            "end": 40,
            "text": "Neh. 6:16."
          }
        ],
        "italics": [
          {
            "start": 21,
            "end": 25
          },
          {
            "start": 159,
            "end": 162
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [
          {
            "raw": "Neh. 6:16.",
            "prettyString": "Nehemiah 6:16",
            "references": [
              {
                "type": "scripture",
                "book": "nehemiah",
                "chapters": [
                  {
                    "start": 6,
                    "end": 6,
                    "verses": [
                      {
                        "start": 16,
                        "end": 16
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Nehemiah 4:7",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 7
      },
      {
        "text": "And conspired all of them together to come and to fight against Jerusalem, and to hinder it.",
        "footNotes": [],
        "italics": [
          {
            "start": 43,
            "end": 46
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:8",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 8
      },
      {
        "text": "Nevertheless we made our prayer unto our God, and set a watch against them day and night, because of them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:9",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 9
      },
      {
        "text": "And Judah said, The strength of the bearers of burdens is decayed, and there is much rubbish; so that we are not able to build the wall.",
        "footNotes": [],
        "italics": [
          {
            "start": 71,
            "end": 79
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:10",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 10
      },
      {
        "text": "And our adversaries said, They shall not know, neither see, till we come in the midst among them, and slay them, and cause the work to cease.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:11",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 11
      },
      {
        "text": "And it came to pass, that when the Jews which dwelt by them came, they said unto us ten times, From all places whence ye shall return unto us they will be upon you.",
        "footNotes": [],
        "italics": [
          {
            "start": 142,
            "end": 164
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:12",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 12
      },
      {
        "text": "Therefore set I in the lower places behind the wall, and on the higher places, I even set the people after their families with their swords, their spears, and their bows.",
        "footNotes": [],
        "italics": [
          {
            "start": 53,
            "end": 56
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:13",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 13
      },
      {
        "text": "And I looked, and rose up, and said unto the nobles, and to the rulers, and to the rest of the people, Be not ye afraid of them: remember the Lord, which is great and terrible, and fight for your brethren, your sons, and your daughters, your wives, and your houses.",
        "footNotes": [
          {
            "start": 113,
            "end": 119,
            "text": "D&C 98:14; 122:9."
          },
          {
            "start": 167,
            "end": 175,
            "text": "OR feared, revered."
          },
          {
            "start": 181,
            "end": 186,
            "text": "TG War."
          },
          {
            "start": 242,
            "end": 247,
            "text": "Alma 46:12."
          }
        ],
        "italics": [
          {
            "start": 148,
            "end": 156
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
          {
            "raw": "D&C 98:14; 122:9.",
            "prettyString": "D&C 98:14; 122:9",
            "references": [
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 98,
                    "end": 98,
                    "verses": [
                      {
                        "start": 14,
                        "end": 14
                      }
                    ]
                  },
                  {
                    "start": 122,
                    "end": 122,
                    "verses": [
                      {
                        "start": 9,
                        "end": 9
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "TG War.",
            "prettyString": "TG War",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "War",
                "entryId": "tg-war",
                "book": "",
                "chapters": []
              }
            ]
          },
          {
            "raw": "Alma 46:12.",
            "prettyString": "Alma 46:12",
            "references": [
              {
                "type": "scripture",
                "book": "alma",
                "chapters": [
                  {
                    "start": 46,
                    "end": 46,
                    "verses": [
                      {
                        "start": 12,
                        "end": 12
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Nehemiah 4:14",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 14
      },
      {
        "text": "And it came to pass, when our enemies heard that it was known unto us, and God had brought their counsel to nought, that we returned all of us to the wall, every one unto his work.",
        "footNotes": [
          {
            "start": 97,
            "end": 104,
            "text": "Ps. 33:10."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [
          {
            "raw": "Ps. 33:10.",
            "prettyString": "Psalms 33:10",
            "references": [
              {
                "type": "scripture",
                "book": "psalms",
                "chapters": [
                  {
                    "start": 33,
                    "end": 33,
                    "verses": [
                      {
                        "start": 10,
                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Nehemiah 4:15",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 15
      },
      {
        "text": "And it came to pass from that time forth, that the half of my servants wrought in the work, and the other half of them held both the spears, the shields, and the bows, and the habergeons; and the rulers were behind all the house of Judah.",
        "footNotes": [
          {
            "start": 176,
            "end": 186,
            "text": "Probably armor of tough leather."
          }
        ],
        "italics": [
          {
            "start": 42,
            "end": 46
          },
          {
            "start": 203,
            "end": 207
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:16",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 16
      },
      {
        "text": "They which builded on the wall, and they that bare burdens, with those that laded, every one with one of his hands wrought in the work, and with the other hand held a weapon.",
        "footNotes": [],
        "italics": [
          {
            "start": 83,
            "end": 92
          },
          {
            "start": 155,
            "end": 159
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:17",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 17
      },
      {
        "text": "For the builders, every one had his sword girded by his side, and so builded. And he that sounded the trumpet was by me.",
        "footNotes": [],
        "italics": [
          {
            "start": 66,
            "end": 68
          },
          {
            "start": 110,
            "end": 113
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:18",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 18
      },
      {
        "text": "And I said unto the nobles, and to the rulers, and to the rest of the people, The work is great and large, and we are separated upon the wall, one far from another.",
        "footNotes": [],
        "italics": [
          {
            "start": 87,
            "end": 89
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:19",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 19
      },
      {
        "text": "In what place therefore ye hear the sound of the trumpet, resort ye thither unto us: our God shall fight for us.",
        "footNotes": [],
        "italics": [
          {
            "start": 14,
            "end": 23
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:20",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 20
      },
      {
        "text": "So we laboured in the work: and half of them held the spears from the rising of the morning till the stars appeared.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:21",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 21
      },
      {
        "text": "Likewise at the same time said I unto the people, Let every one with his servant lodge within Jerusalem, that in the night they may be a guard to us, and labour on the day.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:22",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 22
      },
      {
        "text": "So neither I, nor my brethren, nor my servants, nor the men of the guard which followed me, none of us put off our clothes, saving that every one put them off for washing.",
        "footNotes": [],
        "italics": [
          {
            "start": 124,
            "end": 135
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Nehemiah 4:23",
        "book": "Nehemiah",
        "chapter": 4,
        "verse": 23
      }
    ]
