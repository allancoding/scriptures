        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Deuteronomy 19:5",
        "book": "Deuteronomy",
        "chapter": 19,
        "verse": 5
      },
      {
