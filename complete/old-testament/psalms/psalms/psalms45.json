        "book": "Psalms",
        "chapter": 45,
        "verse": 13
      },
      {
        "text": "She shall be brought unto the king in raiment of needlework: the virgins her companions that follow her shall be brought unto thee.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 45:14",
        "book": "Psalms",
        "chapter": 45,
        "verse": 14
      },
      {
        "text": "With gladness and rejoicing shall they be brought: they shall enter into the king’s palace.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 45:15",
        "book": "Psalms",
        "chapter": 45,
        "verse": 15
      },
