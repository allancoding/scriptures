        "jstReferences": [],
        "reference": "Psalms 71:13",
        "book": "Psalms",
        "chapter": 71,
        "verse": 13
      },
      {
        "text": "But I will hope continually, and will yet praise thee more and more.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:14",
        "book": "Psalms",
        "chapter": 71,
        "verse": 14
      },
      {
        "text": "My mouth shall shew forth thy righteousness and thy salvation all the day; for I know not the numbers thereof.",
        "footNotes": [],
        "italics": [
          {
            "start": 44,
            "end": 47
          },
          {
            "start": 102,
            "end": 110
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:15",
        "book": "Psalms",
        "chapter": 71,
        "verse": 15
      },
      {
