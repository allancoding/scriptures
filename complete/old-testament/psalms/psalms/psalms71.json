        "book": "Psalms",
        "chapter": 71,
        "verse": 4
      },
      {
        "text": "For thou art my hope, O Lord God: thou art my trust from my youth.",
        "footNotes": [],
        "italics": [
          {
            "start": 9,
            "end": 12
          },
          {
            "start": 34,
            "end": 42
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:5",
        "book": "Psalms",
        "chapter": 71,
        "verse": 5
      },
      {
        "text": "By thee have I been holden up from the womb: thou art he that took me out of my mother’s bowels: my praise shall be continually of thee.",
        "footNotes": [],
        "italics": [
          {
            "start": 107,
            "end": 115
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:6",
        "book": "Psalms",
        "chapter": 71,
        "verse": 6
      },
      {
        "text": "I am as a wonder unto many; but thou art my strong refuge.",
        "footNotes": [],
        "italics": [
          {
            "start": 37,
            "end": 40
          }
        ],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:7",
        "book": "Psalms",
        "chapter": 71,
        "verse": 7
      },
      {
        "text": "Let my mouth be filled with thy praise and with thy honour all the day.",
        "footNotes": [],
        "italics": [
          {
            "start": 23,
            "end": 27
          },
          {
            "start": 39,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:8",
        "book": "Psalms",
        "chapter": 71,
        "verse": 8
      },
      {
        "text": "Cast me not off in the time of old age; forsake me not when my strength faileth.",
        "footNotes": [
          {
            "start": 31,
            "end": 34,
            "text": "TG Old Age."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "TG Old Age.",
            "prettyString": "TG Old Age",
            "references": [
