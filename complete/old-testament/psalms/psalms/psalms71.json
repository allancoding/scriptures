        "jstReferences": [],
        "reference": "Psalms 71:9",
        "book": "Psalms",
        "chapter": 71,
        "verse": 9
      },
      {
        "text": "For mine enemies speak against me; and they that lay wait for my soul take counsel together,",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:10",
        "book": "Psalms",
        "chapter": 71,
        "verse": 10
      },
      {
        "text": "Saying, God hath forsaken him: persecute and take him; for there is none to deliver him.",
        "footNotes": [],
        "italics": [
          {
            "start": 59,
            "end": 67
          },
          {
            "start": 84,
            "end": 88
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:11",
        "book": "Psalms",
        "chapter": 71,
        "verse": 11
      },
      {
        "text": "O God, be not far from me: O my God, make haste for my help.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:12",
        "book": "Psalms",
        "chapter": 71,
        "verse": 12
      },
      {
