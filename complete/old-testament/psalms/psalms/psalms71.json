    "number": 71,
    "summary": "David praises God with thanksgiving—Who is like unto the Lord!",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "In thee, O Lord, do I put my trust: let me never be put to confusion.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:1",
        "book": "Psalms",
        "chapter": 71,
        "verse": 1
      },
      {
        "text": "Deliver me in thy righteousness, and cause me to escape: incline thine ear unto me, and save me.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 71:2",
        "book": "Psalms",
        "chapter": 71,
        "verse": 2
      },
      {
