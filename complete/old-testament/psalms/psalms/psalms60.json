                        "end": 2
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Psalms 60:4",
        "book": "Psalms",
        "chapter": 60,
        "verse": 4
      },
      {
        "text": "That thy beloved may be delivered; save with thy right hand, and hear me.",
        "footNotes": [
          {
            "start": 9,
            "end": 16,
            "text": "IE beloved people."
          },
          {
            "start": 24,
            "end": 33,
            "text": "Ps. 108:6 (6–13)."
          }
        ],
        "italics": [
          {
            "start": 40,
            "end": 44
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Psalms 60:5",
        "book": "Psalms",
        "chapter": 60,
        "verse": 5
      },
      {
        "text": "God hath spoken in his holiness; I will rejoice, I will divide Shechem, and mete out the valley of Succoth.",
