        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 14:5",
        "book": "Jeremiah",
        "chapter": 14,
        "verse": 5
      },
      {
        "text": "And the wild asses did stand in the high places, they snuffed up the wind like dragons; their eyes did fail, because there was no grass.",
        "footNotes": [
          {
            "start": 79,
            "end": 86,
            "text": "HEB jackals."
          }
