                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 28:9",
        "book": "Jeremiah",
        "chapter": 28,
        "verse": 9
      },
      {
        "text": "Then Hananiah the prophet took the yoke from off the prophet Jeremiah’s neck, and brake it.",
        "footNotes": [
          {
            "start": 35,
            "end": 39,
            "text": "Jer. 27:2."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "Jer. 27:2.",
            "prettyString": "Jeremiah 27:2",
            "references": [
              {
                "type": "scripture",
                "book": "jeremiah",
                "chapters": [
                  {
                    "start": 27,
                    "end": 27,
                    "verses": [
                      {
                        "start": 2,
                        "end": 2
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 28:10",
        "book": "Jeremiah",
        "chapter": 28,
        "verse": 10
      },
      {
        "text": "And Hananiah spake in the presence of all the people, saying, Thus saith the Lord; Even so will I break the yoke of Nebuchadnezzar king of Babylon from the neck of all nations within the space of two full years. And the prophet Jeremiah went his way.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 28:11",
        "book": "Jeremiah",
        "chapter": 28,
        "verse": 11
      },
      {
        "text": "Then the word of the Lord came unto Jeremiah the prophet, after that Hananiah the prophet had broken the yoke from off the neck of the prophet Jeremiah, saying,",
        "footNotes": [],
        "italics": [
          {
            "start": 45,
            "end": 57
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 28:12",
        "book": "Jeremiah",
        "chapter": 28,
        "verse": 12
      },
      {
        "text": "Go and tell Hananiah, saying, Thus saith the Lord; Thou hast broken the yokes of wood; but thou shalt make for them yokes of iron.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 28:13",
        "book": "Jeremiah",
        "chapter": 28,
        "verse": 13
      },
      {
        "text": "For thus saith the Lord of hosts, the God of Israel; I have put a yoke of iron upon the neck of all these nations, that they may serve Nebuchadnezzar king of Babylon; and they shall serve him: and I have given him the beasts of the field also.",
        "footNotes": [
          {
            "start": 66,
            "end": 70,
            "text": "1 Ne. 13:5 (4–9)."
          },
          {
            "start": 135,
            "end": 149,
            "text": "Jer. 25:11."
          },
          {
            "start": 218,
            "end": 224,
            "text": "Jer. 27:6."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [
