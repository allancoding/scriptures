  "chapter": {
    "bookTitle": "Jeremiah",
    "delineation": "Chapter",
    "number": 15,
    "summary": "The people of Judah will suffer death, the sword, famine, and captivity—They will be scattered into all the kingdoms of the earth—Jerusalem will be destroyed.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "Then said the Lord unto me, Though Moses and Samuel stood before me, yet my mind could not be toward this people: cast them out of my sight, and let them go forth.",
