        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 33:16",
        "book": "Jeremiah",
        "chapter": 33,
        "verse": 16
      },
      {
        "text": "For thus saith the Lord; David shall never want a man to sit upon the throne of the house of Israel;",
        "footNotes": [
          {
            "start": 43,
            "end": 47,
            "text": "OR lack."
          }
