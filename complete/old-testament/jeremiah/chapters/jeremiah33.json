                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Jeremiah 33:3",
        "book": "Jeremiah",
        "chapter": 33,
        "verse": 3
      },
      {
        "text": "For thus saith the Lord, the God of Israel, concerning the houses of this city, and concerning the houses of the kings of Judah, which are thrown down by the mounts, and by the sword;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 33:4",
        "book": "Jeremiah",
        "chapter": 33,
        "verse": 4
      },
      {
        "text": "They come to fight with the Chaldeans, but it is to fill them with the dead bodies of men, whom I have slain in mine anger and in my fury, and for all whose wickedness I have hid my face from this city.",
        "footNotes": [],
        "italics": [
          {
            "start": 43,
            "end": 48
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 33:5",
        "book": "Jeremiah",
        "chapter": 33,
        "verse": 5
      },
      {
        "text": "Behold, I will bring it health and cure, and I will cure them, and will reveal unto them the abundance of peace and truth.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Jeremiah 33:6",
        "book": "Jeremiah",
        "chapter": 33,
        "verse": 6
      },
      {
