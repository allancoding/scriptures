          },
          {
            "start": 178,
            "end": 186
          }
        ],
        "associatedContent": [],
        "verseNumber": 27,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Chronicles 29:27",
        "book": "2 Chronicles",
        "chapter": 29,
        "verse": 27
      },
      {
