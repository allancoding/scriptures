              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Chronicles 24:20",
        "book": "2 Chronicles",
        "chapter": 24,
        "verse": 20
      },
      {
        "text": "And they conspired against him, and stoned him with stones at the commandment of the king in the court of the house of the Lord.",
        "footNotes": [
          {
            "start": 36,
            "end": 42,
            "text": "TG Martyrdom; Prophets, Rejection of."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [
          {
            "raw": "TG Martyrdom; Prophets, Rejection of.",
            "prettyString": "TG Martyrdom; TG Prophets, Rejection of",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
