        "reference": "2 Chronicles 19:3",
        "book": "2 Chronicles",
        "chapter": 19,
        "verse": 3
      },
      {
        "text": "And Jehoshaphat dwelt at Jerusalem: and he went out again through the people from Beer-sheba to mount Ephraim, and brought them back unto the Lord God of their fathers.",
        "footNotes": [
          {
            "start": 52,
            "end": 57,
            "text": "OR repeatedly."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Chronicles 19:4",
        "book": "2 Chronicles",
        "chapter": 19,
        "verse": 4
      },
      {
