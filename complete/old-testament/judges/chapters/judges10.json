        "book": "Judges",
        "chapter": 10,
        "verse": 14
      },
      {
        "text": "And the children of Israel said unto the Lord, We have sinned: do thou unto us whatsoever seemeth good unto thee; deliver us only, we pray thee, this day.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Judges 10:15",
        "book": "Judges",
        "chapter": 10,
        "verse": 15
      },
      {
