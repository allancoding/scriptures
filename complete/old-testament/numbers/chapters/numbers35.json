                "entryId": "tg-refuge",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Numbers 35:6",
        "book": "Numbers",
        "chapter": 35,
        "verse": 6
      },
      {
