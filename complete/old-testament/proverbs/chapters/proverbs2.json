    "delineation": "Chapter",
    "number": 2,
    "summary": "The Lord gives wisdom, knowledge, and understanding—Walk in the way of good men.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "My son, if thou wilt receive my words, and hide my commandments with thee;",
        "footNotes": [
          {
            "start": 43,
            "end": 47,
