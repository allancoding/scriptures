        "footNotes": [
          {
            "start": 25,
            "end": 38,
            "text": "OR alien woman; unchaste women were often so called. Prov. 5:3 (3, 20). TG Adulterer."
          }
        ],
        "italics": [
          {
            "start": 40,
            "end": 44
          },
          {
            "start": 63,
            "end": 68
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:16",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 16
      },
      {
        "text": "Which forsaketh the guide of her youth, and forgetteth the covenant of her God.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:17",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 17
      },
      {
        "text": "For her house inclineth unto death, and her paths unto the dead.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:18",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 18
      },
      {
        "text": "None that go unto her return again, neither take they hold of the paths of life.",
        "footNotes": [
          {
            "start": 22,
            "end": 28,
            "text": "Eccl. 7:26."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [
