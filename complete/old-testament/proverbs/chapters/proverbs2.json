            "end": 40
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:3",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 3
      },
      {
        "text": "If thou seekest her as silver, and searchest for her as for hid treasures;",
        "footNotes": [],
        "italics": [
          {
            "start": 56,
            "end": 59
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:4",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 4
      },
      {
