        "footNotes": [],
        "italics": [
          {
            "start": 41,
            "end": 45
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:20",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 20
