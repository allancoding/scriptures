        "footNotes": [
          {
            "start": 16,
            "end": 26,
            "text": "2 Ne. 28:30."
          }
        ],
        "italics": [
          {
            "start": 68,
            "end": 72
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "2 Ne. 28:30.",
