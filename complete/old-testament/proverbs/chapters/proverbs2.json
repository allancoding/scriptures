        "footNotes": [
          {
            "start": 31,
            "end": 35,
            "text": "Alma 36:7."
          },
          {
            "start": 62,
            "end": 71,
            "text": "TG Knowledge."
          }
        ],
        "italics": [],
        "associatedContent": [],
