                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Proverbs 2:9",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 9
      },
      {
        "text": "When wisdom entereth into thine heart, and knowledge is pleasant unto thy soul;",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:10",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 10
      },
      {
        "text": "Discretion shall preserve thee, understanding shall keep thee:",
        "footNotes": [
          {
            "start": 0,
            "end": 10,
            "text": "TG Rashness."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [
          {
            "raw": "TG Rashness.",
            "prettyString": "TG Rashness",
            "references": [
              {
                "type": "studyHelp",
