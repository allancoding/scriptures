      {
        "text": "He keepeth the paths of judgment, and preserveth the way of his saints.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:8",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 8
      },
      {
