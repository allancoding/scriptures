        "footNotes": [
          {
            "start": 39,
            "end": 43,
            "text": "TG Walking in Darkness."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [
          {
            "raw": "TG Walking in Darkness.",
            "prettyString": "TG Walking in Darkness",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Walking in Darkness",
                "entryId": "tg-walking-in-darkness",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Proverbs 2:13",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 13
      },
      {
        "text": "Who rejoice to do evil, and delight in the frowardness of the wicked;",
        "footNotes": [
          {
            "start": 43,
            "end": 54,
            "text": "OR perverseness."
          }
        ],
        "italics": [
          {
            "start": 24,
            "end": 27
          }
        ],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:14",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 14
      },
      {
        "text": "Whose ways are crooked, and they froward in their paths:",
        "footNotes": [],
        "italics": [
          {
            "start": 11,
            "end": 14
          },
          {
            "start": 28,
            "end": 32
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:15",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 15
      },
