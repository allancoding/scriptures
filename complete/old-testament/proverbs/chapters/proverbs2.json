        "jstReferences": [],
        "reference": "Proverbs 2:11",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 11
      },
      {
        "text": "To deliver thee from the way of the evil man, from the man that speaketh froward things;",
        "footNotes": [],
        "italics": [
          {
            "start": 41,
            "end": 45
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Proverbs 2:12",
        "book": "Proverbs",
        "chapter": 2,
        "verse": 12
      },
      {
