                        "end": 13
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:1",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 1
      },
      {
        "text": "So every man of Israel went up from after David, and followed Sheba the son of Bichri: but the men of Judah clave unto their king, from Jordan even to Jerusalem.",
        "footNotes": [],
        "italics": [
          {
            "start": 49,
            "end": 52
          }
        ],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:2",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 2
      },
      {
        "text": "And David came to his house at Jerusalem; and the king took the ten women his concubines, whom he had left to keep the house, and put them in ward, and fed them, but went not in unto them. So they were shut up unto the day of their death, living in widowhood.",
        "footNotes": [
          {
            "start": 78,
            "end": 88,
            "text": "Jacob 1:15."
          }
        ],
        "italics": [
          {
            "start": 74,
            "end": 77
          }
        ],
        "associatedContent": [],
        "verseNumber": 3,
        "crossReferences": [
          {
            "raw": "Jacob 1:15.",
            "prettyString": "Jacob 1:15",
            "references": [
              {
                "type": "scripture",
                "book": "jacob",
                "chapters": [
                  {
                    "start": 1,
                    "end": 1,
                    "verses": [
                      {
                        "start": 15,
                        "end": 15
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:3",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 3
      },
      {
        "text": "Then said the king to Amasa, Assemble me the men of Judah within three days, and be thou here present.",
        "footNotes": [
          {
            "start": 22,
            "end": 27,
            "text": "2 Sam. 19:13."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [
          {
            "raw": "2 Sam. 19:13.",
            "prettyString": "2 Samuel 19:13",
            "references": [
              {
                "type": "scripture",
                "book": "2samuel",
                "chapters": [
                  {
                    "start": 19,
                    "end": 19,
                    "verses": [
                      {
                        "start": 13,
                        "end": 13
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:4",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 4
      },
      {
        "text": "So Amasa went to assemble the men of Judah: but he tarried longer than the set time which he had appointed him.",
        "footNotes": [],
        "italics": [
          {
            "start": 26,
            "end": 36
          }
        ],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:5",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 5
      },
      {
        "text": "And David said to Abishai, Now shall Sheba the son of Bichri do us more harm than did Absalom: take thou thy lord’s servants, and pursue after him, lest he get him fenced cities, and escape us.",
        "footNotes": [
          {
            "start": 164,
            "end": 170,
            "text": "IE fortified."
          }
        ],
        "italics": [
          {
            "start": 82,
            "end": 85
          }
        ],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:6",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 6
      },
      {
        "text": "And there went out after him Joab’s men, and the Cherethites, and the Pelethites, and all the mighty men: and they went out of Jerusalem, to pursue after Sheba the son of Bichri.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:7",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 7
      },
      {
        "text": "When they were at the great stone which is in Gibeon, Amasa went before them. And Joab’s garment that he had put on was girded unto him, and upon it a girdle with a sword fastened upon his loins in the sheath thereof; and as he went forth it fell out.",
        "footNotes": [],
        "italics": [
          {
            "start": 10,
            "end": 14
          },
          {
            "start": 40,
            "end": 42
          },
          {
            "start": 158,
            "end": 162
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:8",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 8
      },
      {
        "text": "And Joab said to Amasa, Art thou in health, my brother? And Joab took Amasa by the beard with the right hand to kiss him.",
        "footNotes": [
          {
            "start": 112,
            "end": 116,
            "text": "Prov. 27:6."
          }
        ],
        "italics": [
          {
            "start": 24,
            "end": 27
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [
          {
            "raw": "Prov. 27:6.",
            "prettyString": "Proverbs 27:6",
            "references": [
              {
                "type": "scripture",
                "book": "proverbs",
                "chapters": [
                  {
                    "start": 27,
                    "end": 27,
                    "verses": [
                      {
                        "start": 6,
                        "end": 6
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:9",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 9
      },
      {
        "text": "But Amasa took no heed to the sword that was in Joab’s hand: so he smote him therewith in the fifth rib, and shed out his bowels to the ground, and struck him not again; and he died. So Joab and Abishai his brother pursued after Sheba the son of Bichri.",
        "footNotes": [
          {
            "start": 4,
            "end": 9,
            "text": "1 Kgs. 2:5 (5, 32)."
          },
          {
            "start": 94,
            "end": 99,
            "text": "2 Sam. 2:23."
          }
        ],
        "italics": [
          {
            "start": 41,
            "end": 44
          },
          {
            "start": 100,
            "end": 104
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "2 Sam. 2:23.",
            "prettyString": "2 Samuel 2:23",
            "references": [
              {
                "type": "scripture",
                "book": "2samuel",
                "chapters": [
                  {
                    "start": 2,
                    "end": 2,
                    "verses": [
                      {
                        "start": 23,
                        "end": 23
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:10",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 10
      },
      {
        "text": "And one of Joab’s men stood by him, and said, He that favoureth Joab, and he that is for David, let him go after Joab.",
        "footNotes": [],
        "italics": [
          {
            "start": 82,
            "end": 84
          },
          {
            "start": 96,
            "end": 106
          }
        ],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:11",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 11
      },
      {
        "text": "And Amasa wallowed in blood in the midst of the highway. And when the man saw that all the people stood still, he removed Amasa out of the highway into the field, and cast a cloth upon him, when he saw that every one that came by him stood still.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:12",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 12
      },
      {
        "text": "When he was removed out of the highway, all the people went on after Joab, to pursue after Sheba the son of Bichri.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:13",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 13
      },
      {
        "text": "And he went through all the tribes of Israel unto Abel, and to Beth-maachah, and all the Berites: and they were gathered together, and went also after him.",
        "footNotes": [
          {
            "start": 121,
            "end": 129,
            "text": "Alma 46:21 (19–21)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:14",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 14
      },
      {
        "text": "And they came and besieged him in Abel of Beth-maachah, and they cast up a bank against the city, and it stood in the trench: and all the people that were with Joab battered the wall, to throw it down.",
        "footNotes": [],
        "italics": [
          {
            "start": 150,
            "end": 154
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:15",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 15
      },
      {
        "text": "Then cried a wise woman out of the city, Hear, hear; say, I pray you, unto Joab, Come near hither, that I may speak with thee.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:16",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 16
      },
      {
        "text": "And when he was come near unto her, the woman said, Art thou Joab? And he answered, I am he. Then she said unto him, Hear the words of thine handmaid. And he answered, I do hear.",
        "footNotes": [],
        "italics": [
          {
            "start": 52,
            "end": 55
          },
          {
            "start": 86,
            "end": 92
          }
        ],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:17",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 17
      },
      {
        "text": "Then she spake, saying, They were wont to speak in old time, saying, They shall surely ask counsel at Abel: and so they ended the matter.",
        "footNotes": [],
        "italics": [
          {
            "start": 91,
            "end": 98
          },
          {
            "start": 126,
            "end": 137
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:18",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 18
      },
      {
        "text": "I am one of them that are peaceable and faithful in Israel: thou seekest to destroy a city and a mother in Israel: why wilt thou swallow up the inheritance of the Lord?",
        "footNotes": [],
        "italics": [
          {
            "start": 2,
            "end": 25
          },
          {
            "start": 36,
            "end": 39
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:19",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 19
      },
      {
        "text": "And Joab answered and said, Far be it, far be it from me, that I should swallow up or destroy.",
        "footNotes": [
          {
            "start": 86,
            "end": 93,
            "text": "D&C 109:43."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [
          {
            "raw": "D&C 109:43.",
            "prettyString": "D&C 109:43",
            "references": [
              {
                "type": "scripture",
                "book": "doctrineandcovenants",
                "chapters": [
                  {
                    "start": 109,
                    "end": 109,
                    "verses": [
                      {
                        "start": 43,
                        "end": 43
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "2 Samuel 20:20",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 20
      },
      {
        "text": "The matter is not so: but a man of mount Ephraim, Sheba the son of Bichri by name, hath lifted up his hand against the king, even against David: deliver him only, and I will depart from the city. And the woman said unto Joab, Behold, his head shall be thrown to thee over the wall.",
        "footNotes": [],
        "italics": [
          {
            "start": 11,
            "end": 13
          },
          {
            "start": 125,
            "end": 129
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:21",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 21
      },
      {
        "text": "Then the woman went unto all the people in her wisdom. And they cut off the head of Sheba the son of Bichri, and cast it out to Joab. And he blew a trumpet, and they retired from the city, every man to his tent. And Joab returned to Jerusalem unto the king.",
        "footNotes": [],
        "italics": [
          {
            "start": 118,
            "end": 120
          }
        ],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:22",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 22
      },
      {
        "text": "Now Joab was over all the host of Israel: and Benaiah the son of Jehoiada was over the Cherethites and over the Pelethites:",
        "footNotes": [
          {
            "start": 4,
            "end": 8,
            "text": "2 Sam. 8:16 (16–18)."
          }
        ],
        "italics": [
          {
            "start": 9,
            "end": 12
          },
          {
            "start": 74,
            "end": 77
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:23",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 23
      },
      {
        "text": "And Adoram was over the tribute: and Jehoshaphat the son of Ahilud was recorder:",
        "footNotes": [],
        "italics": [
          {
            "start": 11,
            "end": 14
          },
          {
            "start": 67,
            "end": 70
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 20:24",
        "book": "2 Samuel",
        "chapter": 20,
        "verse": 24
      },
      {
        "text": "And Sheva was scribe: and Zadok and Abiathar were the priests:",
        "footNotes": [],
        "italics": [
