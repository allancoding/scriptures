  "chapter": {
    "bookTitle": "2 Samuel",
    "delineation": "Chapter",
    "number": 20,
    "summary": "Sheba leads the tribes of Israel away from David—Joab slays Amasa and pursues Sheba—A wise woman intercedes—The death of Sheba ends the insurrection.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And there happened to be there a man of Belial, whose name was Sheba, the son of Bichri, a Benjamite: and he blew a trumpet, and said, We have no part in David, neither have we inheritance in the son of Jesse: every man to his tents, O Israel.",
        "footNotes": [
          {
            "start": 40,
            "end": 46,
            "text": "Deut. 13:13."
          }
        ],
        "italics": [
          {
            "start": 59,
            "end": 62
          }
        ],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
            "raw": "Deut. 13:13.",
            "prettyString": "Deuteronomy 13:13",
            "references": [
              {
                "type": "scripture",
                "book": "deuteronomy",
                "chapters": [
                  {
                    "start": 13,
                    "end": 13,
                    "verses": [
