        "reference": "2 Samuel 13:34",
        "book": "2 Samuel",
        "chapter": 13,
        "verse": 34
      },
      {
        "text": "And Jonadab said unto the king, Behold, the king’s sons come: as thy servant said, so it is.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 35,
        "crossReferences": [],
