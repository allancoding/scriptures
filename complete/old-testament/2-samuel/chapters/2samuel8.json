          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 8:12",
        "book": "2 Samuel",
        "chapter": 8,
        "verse": 12
      },
      {
