        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 12:11",
        "book": "2 Samuel",
        "chapter": 12,
        "verse": 11
      },
      {
