        "italics": [],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "2 Samuel 12:10",
        "book": "2 Samuel",
        "chapter": 12,
        "verse": 10
      },
      {
        "text": "Thus saith the Lord, Behold, I will raise up evil against thee out of thine own house, and I will take thy wives before thine eyes, and give them unto thy neighbour, and he shall lie with thy wives in the sight of this sun.",
        "footNotes": [
          {
            "start": 45,
            "end": 49,
            "text": "2 Sam. 11:27 (1–27); 15:2 (1–14); 1 Chr. 21:8 (1–8); Ps. 88:14 (6–8, 14–18)."
