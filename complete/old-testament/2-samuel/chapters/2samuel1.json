                        "end": 10
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "raw": "TG Anointing.",
            "prettyString": "TG Anointing",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Anointing",
                "entryId": "tg-anointing",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Samuel 1:14",
        "book": "Samuel",
        "chapter": 1,
        "verse": 14
      },
      {
        "text": "And David called one of the young men, and said, Go near, and fall upon him. And he smote him that he died.",
        "footNotes": [],
        "italics": [
          {
            "start": 58,
            "end": 61
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Samuel 1:15",
        "book": "Samuel",
        "chapter": 1,
        "verse": 15
      },
      {
        "text": "And David said unto him, Thy blood be upon thy head; for thy mouth hath testified against thee, saying, I have slain the Lord’s anointed.",
        "footNotes": [],
        "italics": [
          {
            "start": 35,
            "end": 37
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Samuel 1:16",
        "book": "Samuel",
        "chapter": 1,
        "verse": 16
      },
      {
        "text": "And David lamented with this lamentation over Saul and over Jonathan his son:",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Samuel 1:17",
        "book": "Samuel",
        "chapter": 1,
        "verse": 17
      },
      {
        "text": "(Also he bade them teach the children of Judah the use of the bow: behold, it is written in the book of Jasher.)",
        "footNotes": [
          {
            "start": 19,
            "end": 24,
            "text": "This verse appears to be a superscription like the one appearing at the beginning of Psalm 60."
          },
          {
            "start": 104,
