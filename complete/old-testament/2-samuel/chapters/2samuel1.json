        "jstReferences": [],
        "reference": "Samuel 1:24",
        "book": "Samuel",
        "chapter": 1,
        "verse": 24
      },
      {
        "text": "How are the mighty fallen in the midst of the battle! O Jonathan, thou wast slain in thine high places.",
        "footNotes": [],
        "italics": [
          {
            "start": 66,
            "end": 75
          }
        ],
        "associatedContent": [],
        "verseNumber": 25,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Samuel 1:25",
        "book": "Samuel",
        "chapter": 1,
        "verse": 25
      },
      {
        "text": "I am distressed for thee, my brother Jonathan: very pleasant hast thou been unto me: thy love to me was wonderful, passing the love of women.",
        "footNotes": [
          {
            "start": 89,
            "end": 93,
            "text": "Alma 20:26; D&C 88:133."
          }
        ],
