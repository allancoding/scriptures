            "end": 81
          }
        ],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "1 Samuel 4:8",
        "book": "1 Samuel",
        "chapter": 4,
        "verse": 8
      },
      {
