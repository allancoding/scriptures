        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 34,
        "crossReferences": [
          {
            "raw": "1 Sam. 10:1; 1 Kgs. 2:15; 1 Chr. 29:22.",
            "prettyString": "1 Samuel 10:1; 1 Kings 2:15; 1 Chronicles 29:22",
            "references": [
