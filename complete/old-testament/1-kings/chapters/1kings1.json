                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Kings 1:5",
        "book": "Kings",
        "chapter": 1,
        "verse": 5
      },
      {
        "text": "And his father had not displeased him at any time in saying, Why hast thou done so? and he also was a very goodly man; and his mother bare him after Absalom.",
        "footNotes": [
          {
            "start": 107,
            "end": 113,
            "text": "HEB handsome."
          },
          {
            "start": 149,
            "end": 156,
            "text": "1 Kgs. 2:22."
          }
        ],
        "italics": [
          {
            "start": 96,
            "end": 101
          },
          {
            "start": 114,
            "end": 118
          },
          {
            "start": 123,
