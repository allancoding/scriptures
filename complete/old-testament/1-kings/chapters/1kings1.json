                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Kings 1:3",
        "book": "Kings",
        "chapter": 1,
        "verse": 3
      },
      {
        "text": "And the damsel was very fair, and cherished the king, and ministered to him: but the king knew her not.",
        "footNotes": [],
        "italics": [
          {
            "start": 15,
            "end": 18
          }
        ],
        "associatedContent": [],
        "verseNumber": 4,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Kings 1:4",
        "book": "Kings",
        "chapter": 1,
        "verse": 4
      },
      {
        "text": "Then Adonijah the son of Haggith exalted himself, saying, I will be king: and he prepared him chariots and horsemen, and fifty men to run before him.",
        "footNotes": [
          {
            "start": 5,
            "end": 13,
            "text": "2 Sam. 3:4."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [
          {
