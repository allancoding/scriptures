        "footNotes": [
          {
            "start": 12,
            "end": 16,
            "text": "1 Kgs. 20:42."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 37,
        "crossReferences": [
          {
            "raw": "1 Kgs. 20:42.",
            "prettyString": "1 Kings 20:42",
            "references": [
