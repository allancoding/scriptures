                "entryId": "tg-fast-fasting",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "1 Kings 21:9",
        "book": "1 Kings",
        "chapter": 21,
        "verse": 9
      },
      {
        "text": "And set two men, sons of Belial, before him, to bear witness against him, saying, Thou didst blaspheme God and the king. And then carry him out, and stone him, that he may die.",
        "footNotes": [
          {
            "start": 61,
            "end": 68,
            "text": "TG Tyranny."
          },
          {
            "start": 93,
            "end": 102,
            "text": "TG Blaspheme."
          }
        ],
        "italics": [
          {
            "start": 125,
            "end": 129
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [
          {
            "raw": "TG Tyranny.",
            "prettyString": "TG Tyranny",
            "references": [
              {
                "type": "studyHelp",
