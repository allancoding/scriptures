        ],
        "jstReferences": [],
        "reference": "Genesis 44:26",
        "book": "Genesis",
        "chapter": 44,
        "verse": 26
      },
      {
        "text": "And thy servant my father said unto us, Ye know that my wife bare me two sons:",
        "footNotes": [],
        "italics": [
          {
            "start": 73,
            "end": 78
          }
        ],
        "associatedContent": [],
        "verseNumber": 27,
