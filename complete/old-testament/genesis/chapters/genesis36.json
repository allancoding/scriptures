        "jstReferences": [],
        "reference": "Genesis 36:3",
        "book": "Genesis",
        "chapter": 36,
        "verse": 3
      },
      {
        "text": "And Adah bare to Esau Eliphaz; and Bashemath bare Reuel;",
        "footNotes": [],
        "italics": [],
