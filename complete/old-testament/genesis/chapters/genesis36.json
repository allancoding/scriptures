        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 36:7",
        "book": "Genesis",
        "chapter": 36,
        "verse": 7
