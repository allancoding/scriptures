        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Genesis 36:11",
        "book": "Genesis",
        "chapter": 36,
        "verse": 11
