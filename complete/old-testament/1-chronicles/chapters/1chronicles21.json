  "chapter": {
    "bookTitle": "1 Chronicles",
    "delineation": "Chapter",
    "number": 21,
    "summary": "David sins by numbering Israel—The Lord sends pestilence upon the people—David offers sacrifices and the plague is stayed.",
    "chapterAugmentations": [],
    "verses": [
      {
        "text": "And Satan stood up against Israel, and provoked David to number Israel.",
        "footNotes": [
          {
            "start": 4,
            "end": 9,
            "text": "TG Devil."
          },
          {
            "start": 39,
            "end": 47,
            "text": "2 Sam. 24:1 (1–25)."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [
          {
            "raw": "TG Devil.",
            "prettyString": "TG Devil",
            "references": [
              {
                "type": "studyHelp",
                "studyHelpType": "tg",
                "title": "Devil",
                "entryId": "tg-devil",
                "book": "",
                "chapters": []
