                "entryId": "tg-righteousness",
                "book": "",
                "chapters": []
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 29:14",
        "book": "Job",
        "chapter": 29,
        "verse": 14
      },
      {
        "text": "I was eyes to the blind, and feet was I to the lame.",
        "footNotes": [],
        "italics": [
          {
            "start": 34,
            "end": 37
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:15",
        "book": "Job",
        "chapter": 29,
        "verse": 15
      },
      {
        "text": "I was a father to the poor: and the cause which I knew not I searched out.",
        "footNotes": [],
        "italics": [
          {
            "start": 2,
            "end": 5
          },
          {
            "start": 42,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:16",
        "book": "Job",
        "chapter": 29,
        "verse": 16
      },
      {
        "text": "And I brake the jaws of the wicked, and plucked the spoil out of his teeth.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:17",
        "book": "Job",
        "chapter": 29,
        "verse": 17
      },
      {
        "text": "Then I said, I shall die in my nest, and I shall multiply my days as the sand.",
        "footNotes": [],
        "italics": [
          {
            "start": 58,
            "end": 60
          }
        ],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:18",
        "book": "Job",
        "chapter": 29,
        "verse": 18
      },
      {
        "text": "My root was spread out by the waters, and the dew lay all night upon my branch.",
        "footNotes": [],
        "italics": [
          {
            "start": 8,
            "end": 11
          }
        ],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:19",
        "book": "Job",
        "chapter": 29,
        "verse": 19
      },
      {
        "text": "My glory was fresh in me, and my bow was renewed in my hand.",
        "footNotes": [],
        "italics": [
          {
            "start": 9,
            "end": 12
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:20",
        "book": "Job",
        "chapter": 29,
        "verse": 20
      },
      {
        "text": "Unto me men gave ear, and waited, and kept silence at my counsel.",
        "footNotes": [],
        "italics": [
          {
            "start": 8,
            "end": 11
          }
        ],
        "associatedContent": [],
        "verseNumber": 21,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:21",
        "book": "Job",
        "chapter": 29,
        "verse": 21
      },
      {
        "text": "After my words they spake not again; and my speech dropped upon them.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 22,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:22",
        "book": "Job",
        "chapter": 29,
        "verse": 22
      },
      {
        "text": "And they waited for me as for the rain; and they opened their mouth wide as for the latter rain.",
        "footNotes": [],
        "italics": [
          {
            "start": 73,
            "end": 75
          }
        ],
        "associatedContent": [],
        "verseNumber": 23,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:23",
        "book": "Job",
        "chapter": 29,
        "verse": 23
      },
      {
        "text": "If I laughed on them, they believed it not; and the light of my countenance they cast not down.",
        "footNotes": [],
        "italics": [
          {
            "start": 0,
            "end": 2
          },
          {
            "start": 36,
            "end": 38
          }
        ],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 29:24",
        "book": "Job",
        "chapter": 29,
        "verse": 24
      },
      {
        "text": "I chose out their way, and sat chief, and dwelt as a king in the army, as one that comforteth the mourners.",
