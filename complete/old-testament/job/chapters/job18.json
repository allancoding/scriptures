                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "jstReferences": [],
        "reference": "Job 18:5",
        "book": "Job",
        "chapter": 18,
        "verse": 5
      },
      {
        "text": "The light shall be dark in his tabernacle, and his candle shall be put out with him.",
        "footNotes": [
          {
            "start": 31,
            "end": 41,
            "text": "HEB tent."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 6,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:6",
        "book": "Job",
        "chapter": 18,
        "verse": 6
      },
      {
        "text": "The steps of his strength shall be straitened, and his own counsel shall cast him down.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 7,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:7",
        "book": "Job",
        "chapter": 18,
        "verse": 7
      },
      {
        "text": "For he is cast into a net by his own feet, and he walketh upon a snare.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 8,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:8",
        "book": "Job",
        "chapter": 18,
        "verse": 8
      },
      {
        "text": "The gin shall take him by the heel, and the robber shall prevail against him.",
        "footNotes": [
          {
            "start": 4,
            "end": 7,
            "text": "HEB trap."
          }
        ],
        "italics": [
          {
            "start": 19,
            "end": 22
          },
          {
            "start": 36,
            "end": 39
          }
        ],
        "associatedContent": [],
        "verseNumber": 9,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:9",
        "book": "Job",
        "chapter": 18,
        "verse": 9
      },
      {
        "text": "The snare is laid for him in the ground, and a trap for him in the way.",
        "footNotes": [],
        "italics": [
          {
            "start": 10,
            "end": 12
          }
        ],
        "associatedContent": [],
        "verseNumber": 10,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:10",
        "book": "Job",
        "chapter": 18,
        "verse": 10
      },
      {
        "text": "Terrors shall make him afraid on every side, and shall drive him to his feet.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:11",
        "book": "Job",
        "chapter": 18,
        "verse": 11
      },
      {
        "text": "His strength shall be hungerbitten, and destruction shall be ready at his side.",
        "footNotes": [],
        "italics": [
          {
            "start": 52,
            "end": 60
          }
        ],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:12",
        "book": "Job",
        "chapter": 18,
        "verse": 12
      },
      {
        "text": "It shall devour the strength of his skin: even the firstborn of death shall devour his strength.",
        "footNotes": [],
        "italics": [
          {
            "start": 42,
            "end": 46
          }
        ],
        "associatedContent": [],
        "verseNumber": 13,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:13",
        "book": "Job",
        "chapter": 18,
        "verse": 13
      },
      {
        "text": "His confidence shall be rooted out of his tabernacle, and it shall bring him to the king of terrors.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 14,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:14",
        "book": "Job",
        "chapter": 18,
        "verse": 14
      },
      {
        "text": "It shall dwell in his tabernacle, because it is none of his: brimstone shall be scattered upon his habitation.",
        "footNotes": [],
        "italics": [
          {
            "start": 42,
            "end": 47
          }
        ],
        "associatedContent": [],
        "verseNumber": 15,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:15",
        "book": "Job",
        "chapter": 18,
        "verse": 15
      },
      {
        "text": "His roots shall be dried up beneath, and above shall his branch be cut off.",
        "footNotes": [
          {
            "start": 4,
            "end": 9,
            "text": "Isa. 5:24 (24–25); 2 Ne. 15:24 (24–25); D&C 133:64."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 16,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:16",
        "book": "Job",
        "chapter": 18,
        "verse": 16
      },
      {
        "text": "His remembrance shall perish from the earth, and he shall have no name in the street.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 17,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:17",
        "book": "Job",
        "chapter": 18,
        "verse": 17
      },
      {
        "text": "He shall be driven from light into darkness, and chased out of the world.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 18,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:18",
        "book": "Job",
        "chapter": 18,
        "verse": 18
      },
      {
        "text": "He shall neither have son nor nephew among his people, nor any remaining in his dwellings.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 19,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:19",
        "book": "Job",
        "chapter": 18,
        "verse": 19
      },
      {
        "text": "They that come after him shall be astonied at his day, as they that went before were affrighted.",
        "footNotes": [],
        "italics": [
          {
            "start": 21,
            "end": 24
          }
        ],
        "associatedContent": [],
        "verseNumber": 20,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Job 18:20",
        "book": "Job",
        "chapter": 18,
        "verse": 20
      },
      {
        "text": "Surely such are the dwellings of the wicked, and this is the place of him that knoweth not God.",
        "footNotes": [],
        "italics": [
          {
            "start": 12,
            "end": 15
          },
