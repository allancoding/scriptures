  "chapter": {
    "bookTitle": "Doctrine and Covenants",
    "delineation": "Section",
    "number": 115,
    "summary": "1–4, The Lord names His church The Church of Jesus Christ of Latter-day Saints; 5–6, Zion and her stakes are places of defense and refuge for the Saints; 7–16, The Saints are commanded to build a house of the Lord at Far West; 17–19, Joseph Smith holds the keys of the kingdom of God on earth.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Revelation given through Joseph Smith the Prophet, at Far West, Missouri, April 26, 1838, identifying the name of the Church as The Church of Jesus Christ of Latter-day Saints. The revelation also approved of Far West as a new gathering place in the land of Zion."
      }
    ],
