      {
        "text": "For thou didst not give so much heed unto my words as did thy brother, among the people of the Zoramites. Now this is what I have against thee; thou didst go on unto boasting in thy strength and thy wisdom.",
        "footNotes": [
          {
            "start": 95,
            "end": 104,
            "text": "Alma 38:3."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [
          {
            "raw": "Alma 38:3.",
            "prettyString": "Alma 38:3",
            "references": [
              {
