  "chapter": {
    "bookTitle": "Alma",
    "delineation": "Chapter",
    "number": 39,
    "summary": "Sexual sin is an abomination—Corianton’s sins kept the Zoramites from receiving the word—Christ’s redemption is retroactive in saving the faithful who preceded it. About 74 B.C.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Comprising chapters 39 through 42."
      }
    ],
    "verses": [
      {
        "text": "And now, my son, I have somewhat more to say unto thee than what I said unto thy brother; for behold, have ye not observed the steadiness of thy brother, his faithfulness, and his diligence in keeping the commandments of God? Behold, has he not set a good example for thee?",
