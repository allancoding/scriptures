        "jstReferences": [],
        "reference": "Alma 39:7",
        "book": "Alma",
        "chapter": 39,
        "verse": 7
      },
      {
        "text": "But behold, ye cannot hide your crimes from God; and except ye repent they will stand as a testimony against you at the last day.",
        "footNotes": [
          {
            "start": 22,
            "end": 26,
            "text": "TG God, Omniscience of."
          }
        ],
        "italics": [],
        "associatedContent": [],
