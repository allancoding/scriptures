        "book": "Mosiah",
        "chapter": 21,
        "verse": 10
      },
      {
        "text": "And it came to pass that their continual cries did stir up the remainder of the people of Limhi to anger against the Lamanites; and they went again to battle, but they were driven back again, suffering much loss.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 11,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 21:11",
        "book": "Mosiah",
        "chapter": 21,
        "verse": 11
      },
      {
