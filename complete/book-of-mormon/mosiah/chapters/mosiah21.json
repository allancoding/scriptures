        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 12,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 21:12",
        "book": "Mosiah",
        "chapter": 21,
        "verse": 12
      },
