        "book": "Mosiah",
        "chapter": 21,
        "verse": 1
      },
      {
        "text": "And it came to pass that after many days the Lamanites began again to be stirred up in anger against the Nephites, and they began to come into the borders of the land round about.",
        "footNotes": [],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 2,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 21:2",
        "book": "Mosiah",
        "chapter": 21,
        "verse": 2
      },
      {
