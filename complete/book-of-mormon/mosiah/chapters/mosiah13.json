        "italics": [],
        "associatedContent": [],
        "verseNumber": 5,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 13:5",
        "book": "Mosiah",
        "chapter": 13,
        "verse": 5
      },
      {
