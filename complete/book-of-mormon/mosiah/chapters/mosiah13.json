        "italics": [],
        "associatedContent": [],
        "verseNumber": 1,
        "crossReferences": [],
        "jstReferences": [],
        "reference": "Mosiah 13:1",
        "book": "Mosiah",
        "chapter": 13,
        "verse": 1
      },
      {
        "text": "And they stood forth and attempted to lay their hands on him; but he withstood them, and said unto them:",
