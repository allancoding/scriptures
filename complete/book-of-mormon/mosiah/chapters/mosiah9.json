  "chapter": {
    "bookTitle": "Mosiah",
    "delineation": "Chapter",
    "number": 9,
    "summary": "Zeniff leads a group from Zarahemla to possess the land of Lehi-Nephi—The Lamanite king permits them to inherit the land—There is war between the Lamanites and Zeniff’s people. About 200–187 B.C.",
    "chapterAugmentations": [
      {
        "type": "introduction",
        "text": "Comprising chapters 9 through 22."
      }
    ],
    "verses": [
      {
        "text": "I, Zeniff, having been taught in all the language of the Nephites, and having had a knowledge of the land of Nephi, or of the land of our fathers’ first inheritance, and having been sent as a spy among the Lamanites that I might spy out their forces, that our army might come upon them and destroy them—but when I saw that which was good among them I was desirous that they should not be destroyed.",
        "footNotes": [
          {
            "start": 0,
            "end": 1,
            "text": "Mosiah 8:5; 22:14."
          },
          {
            "start": 3,
            "end": 9,
            "text": "Mosiah 7:13."
          },
          {
            "start": 109,
            "end": 114,
            "text": "2 Ne. 5:8; Omni 1:12 (12, 27); Mosiah 7:6 (6–7); 28:1 (1, 5)."
          }
        ],
        "italics": [],
        "associatedContent": [],
