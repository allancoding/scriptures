        "jstReferences": [],
        "reference": "Helaman 11:23",
        "book": "Helaman",
        "chapter": 11,
        "verse": 23
      },
      {
        "text": "And it came to pass that in the eightieth year of the reign of the judges over the people of Nephi, there were a certain number of the dissenters from the people of Nephi, who had some years before gone over unto the Lamanites, and taken upon themselves the name of Lamanites, and also a certain number who were real descendants of the Lamanites, being stirred up to anger by them, or by those dissenters, therefore they commenced a war with their brethren.",
        "footNotes": [
          {
            "start": 433,
            "end": 436,
            "text": "Hel. 4:3."
          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 24,
        "crossReferences": [
          {
            "raw": "Hel. 4:3.",
            "prettyString": "Helaman 4:3",
            "references": [
              {
                "type": "scripture",
