          }
        ],
        "italics": [],
        "associatedContent": [],
        "verseNumber": 26,
        "crossReferences": [
          {
            "raw": "Hel. 4:26; 6:32; 7:6.",
            "prettyString": "Helaman 4:26; 6:32; 7:6",
            "references": [
              {
                "type": "scripture",
