        "jstReferences": [],
        "reference": "Helaman 3:17",
        "book": "Helaman",
        "chapter": 3,
        "verse": 17
      },
      {
        "text": "The forty and sixth year of the reign of the judges ended;",
        "footNotes": [],
        "italics": [],
