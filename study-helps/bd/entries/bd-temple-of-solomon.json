    {
      "text": "The wealth gathered by David and lavished by Solomon on the temple was enormous. The skill necessary for the elaborate work in gold and brass was supplied from Tyre. Hiram, on his mother’s side of the tribe of Naphtali, was fetched by Solomon for the purpose (1 Kgs. 7:14).",
      "references": [
        {
          "text": "1 Kgs. 7:14",
          "start": 260,
          "end": 271,
          "parsed": {
            "volume": "ot",
            "bookKey": "1-kgs",
            "book": "1kings",
            "chapter": 7,
            "chapterId": "1kings7",
            "verses": [
